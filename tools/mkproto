#!/bin/bash

function usage {
    cat <<EOF
Usage: $0 -p|--prefix  TAG FILE
       $0 -c|--comment TAG FILE
Generate dummy C prototypes for all primitives in FILE matching TAG.
Example: $0 -p my_prim_ primitives.asm

Read the ACME assembly FILE and print  to standard output a list of dummy C
prototypes for all the primitives it contains. The output can be redirected
to a C file suitable for linking  the primitives with the object code files
generated by the BreadCaml compilers.

TAG  is a  user-defined sequence  of characters  that complies  with ACME's
lexical rules for  global symbols (it begins  with a letter or  ‘_’ and may
contain letters, digits, or ‘_’).

A global label at the beginning of a line in FILE is identified as the name
of a primitive, and its C prototype is generated, if:

- the ‘-p’ or ‘--prefix’ option is  specified, the label starts with ‘TAG’,
  and it is not followed by any characters other than spaces or tabs;
or
- the ‘-c’ or ‘--comment’ option is specified, the label is followed by the
  comment  ‘TAG’ introduced  by one  or more  ‘;’, and  there are  no other
  characters on the line except spaces and tabs as separators.

$0 is part of The BreadCaml Project.
EOF
}

LABEL1ST='[_A-Za-z]'
LABELNXT='[_A-Za-z0-9]*'
LABEL="$LABEL1ST$LABELNXT"
SEP='[ \t]*'
PROTO='void \1 () {}'

function check_tag { # $1: TAG
    [[ $1 =~ ^$LABEL$ ]] || {
	echo "$0: illegal tag ‘$1’." 1>&2
	exit 1
    }
}

function check_file { # $1: FILE
    [[ -r $1 ]] || {
	echo "$0: file ‘$1’ does not exist or is unreadable." 1>&2
	exit 1
    }
}

function syntax_error {
    echo -e "$0: syntax error.\nTry ‘$0 --help’ for more information." 1>&2
    exit 1
}

case "$#:$1" in
    1:--help)
	usage
	;;
    3:-p|3:--prefix)
	check_tag "$2"
	check_file "$3"
	sed -nE "s/^($2$LABELNXT)$SEP$/$PROTO/p" "$3"
	;;
    3:-c|3:--comment)
	check_tag "$2"
	check_file "$3"
	sed -nE "s/^($LABEL)$SEP;+$SEP$2$SEP$/$PROTO/p" "$3"
	;;
    *)
	syntax_error
esac
