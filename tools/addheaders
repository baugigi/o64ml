   $LINE *)
EOF
)"


#######


function help_message {
    cat <<EOF
$0 [ -p | -d | --help ]

When run without options, it adds headers to all files in the project.
The -p option displays the text of the available headers.
The -d option removes all headers from all files in the project.
It correctly handles files with #! on the first line.
EOF
}

function print_headers {
    for KEY in "${!HEADER[@]}"; do
	echo "<inizio: $KEY>"
	echo "${HEADER[$KEY]}"
	echo "<fine:   $KEY>"
	echo ""
    done | less
}

function add_header { # $1: FILE; $2: KEY
    # Skip the file if the first 3 lines already contain the signature
    # (3 to account for a possible #! on the first line)
    if head -n 3 "$1" | grep -q -F "$SIGNATURE"; then
        echo -e "[skipped]\t$1"
    else
        TEMP_FILE="$(mktemp)"
	LINE1="$(head -n 1 "$1")"
        if [[ $LINE1 =~ ^#\! ]]; then
            # If the file starts with #!, insert the header after the 1st line
	    echo "$LINE1"
            echo "${HEADER[$2]}"
            tail -n +2 "$1"
        else
            echo "${HEADER[$2]}"
            cat "$1"
        fi > "$TEMP_FILE"
        mv "$TEMP_FILE" "$1"
        echo -e "[ $2 ]\t$1"
    fi
}

function delete_header { # $1: FILE
    if [[ $(grep -c -F "$LINE" "$1") -eq 2 ]]; then
	sed -iE "/$LINE/,/$LINE/d" "$1"
	echo -e "[deleted]\t$1"
    else
	echo -e "[not present]\t$1"
    fi
}


#####


DIR="$(realpath --relative-to=. "$(dirname "$0")/..")"
PRUNE=( -path '*/.git' -prune -o )

case "$#:$1" in
    0:)
	# Build the expression for the ‘find’ command in the EXPR array
	# by concatenating all the TEST_$KEY arrays, each followed by the
	# -printf action and a final -o operator
	for KEY in "${!HEADER[@]}"; do
	    declare -n TEST="TEST_$KEY"
	    EXPR+=( '(' '(' "${TEST[@]}" ')' -printf "%p $KEY\n" ')' -o )
	done
	# Add a trailing -false operator to cope with the last -o
	find "$DIR" "${PRUNE[@]}" -type f '(' "${EXPR[@]}" -false ')' \
	    | while read -r FILE KEY; do
	    add_header "$FILE" "$KEY"
	done
	;;
    1:-d)
	find "$DIR" "${PRUNE[@]}" -type f -print | while read -r FILE; do
	    delete_header "$FILE"
	done
	;;
    1:--help)
	help_message
	;;
    1:-p)
	print_headers
	;;
    *)
	echo "$0: syntax error." 1>&2
	exit 1
esac
