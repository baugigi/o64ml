# For each header, you must define the following variables/arrays:
# - KEY: identification key;
# - TEST_$KEY: array containing the condition for the ‘find’ command.
# - HEADER[$KEY]: header text, which must include:
#   - line 1 containing $LINE;
#   - line 2 containing $SIGNATURE;
#   - the last line containing $LINE;
#   - no other lines containing $LINE.


# Data common to all headers

DATE="21-Apr-2026"
SIGNATURE="Progetto BreadCaml / The BreadCaml Project"
AUTHOR="Piero Furiesi"
LINE="$(printf '%.s—' {1..70})"  # 70 '—'s

declare -A HEADER


# Text common to all headers that refer to GPLv2

function print_GPLv2 {  # $1: line prefix
    echo "$GPLv2" | sed -E "s/^(.*)$/$1\1/"
}
GPLv2="$(cat <<EOF

Questo  programma  è software  libero;  può  essere ridistribuito  e/o
modificato nei termini della licenza GNU GPL ver. 2,  come specificato
nel file LICENZA-it nella cartella principale del progetto.

This program is  free software; you can redistribute  it and/or modify
it under the terms of the GNU  General Public License (GPL) ver. 2, as
specified in the LICENSE-en file in the project root folder.
EOF
)"


# GPLv2 header for OCaml source code - no third parties

KEY='OCAML'
TEST_OCAML=( ! -path '*/stdlib/*' ! -path '*/ocamlclean/*' -name '*.ml*' )
HEADER["$KEY"]="$(cat <<EOF
(* $LINE
   $SIGNATURE
   Copyright (C) $DATE $AUTHOR
$(print_GPLv2 '   ')
   $LINE *)
EOF
)"


# GPLv2 header for Assembly source code

KEY='ASSEMBLY'
TEST_ASSEMBLY=( -name '*.asm' )
HEADER["$KEY"]="$(cat <<EOF
;; $LINE
;; $SIGNATURE
;; Copyright (C) $DATE $AUTHOR
$(print_GPLv2 ';; ')
;; $LINE
EOF
)"


# GPLv2 header for Makefiles and Bash scripts

KEY='SCRIPT'
TEST_SCRIPT=( -name Makefile -o -name configure -o
	      -path '*/tools/*' -exec sed -nE '1{\:^#!/bin/bash:q0};q1' {} ';' )
HEADER["$KEY"]="$(cat <<EOF
#  $LINE
#  $SIGNATURE
#  Copyright (C) $DATE $AUTHOR
$(print_GPLv2 '#  ')
#  $LINE
EOF
)"


# LGLP Header + OCaml Linking Exception for the Stdlib

KEY='STDLIB'
TEST_STDLIB=( -path '*/stdlib/*' -name '*.ml*' )
HEADER["$KEY"]="$(cat <<EOF
(* $LINE
   $SIGNATURE
   Copyright (C) $DATE $AUTHOR

                                     SOFTWARE DI TERZI/3RD PARTY SOFTWARE
   OCaml Core System - Stdlib          (C) 1996 INRIA - https://ocaml.org

