    93                          !ifdef caml_PRIM__caml_string_get {
    94                          caml_string_get
    95                                  ;; ACCU=string, SP[0]=index
    96                                  ;; return string[index]
    97                          
    98                                  JSR caml_string_index_y
    99                                  LDA (ACCU),Y                            ;get char
   100                                  SEC
   101                                  ROL
   102                                  STA ACCU
   103                                  LDA # 0
   104                                  TAY                                     ;.Y := 0
   105                                  ROL
   106                                  STA ACCU + 1                            ;ACCU := Val_char(char)
   107                                  RTS
