   364                                  STA (BLK),Y
   365                                  DEY
   366                                  LDA # < caml_int64_custom
   367                                  STA (BLK),Y
   368                                  LDA BLK
   369                                  STA ACCU
   370                                  LDA BLK + 1
   371                                  STA ACCU + 1
   372                                  RTS
   373                          +       TAX
   374                          -       LDY # 9
   375                                  LDA (ACCU),Y
   376                                  LSR
   377                                  STA (BLK),Y
   378                            !for @i, 1, 7 {
   379                                  DEY
   380                                  LDA (ACCU),Y
   381                                  ROR
   382                                  STA (BLK),Y
   383                            }
   384                                  DEX
   385                                  BNE -
   386                                  LDY # 1
   387                                  BNE --                          ;jmp
   388                          }
   389                          
   390                          !ifdef  caml_PRIM__caml_int64_mul {
   391                          caml_int64_mul
   392                          @M      = TMP                                   ;8 bytes
   393                          @P      = TMP + 8                               ;8 bytes
   394                          @NPTR   = TMP + 16                              ;2 bytes
   395                                  +caml_int64_alloc
   396                                  SEC
   397                                  LDA (SP),Y
   398                                  SBC # $FF - 9                   :!warn "COS'E'? COMMENTARE!"
   399                                  STA @NPTR
   400                                  INY
   401                                  LDA (SP),Y
   402                                  SBC # 0
   403                                  STA @NPTR + 1
   404                                  LDX # 0
   405                                  LDY # 9
   406                                  LDA (ACCU),Y
   407                                  LSR
   408                                  STA @M + 7
   409                                  STX @P + 7
   410                            !for @i, 6, 0 {
   411                                  DEY
   412                                  LDA (ACCU),Y
   413                                  ROR
   414                                  STA @M + @i
   415                                  STX @P + @i
   416                            }
   417                                  LDX # 64
   418                          --      BCC +
   419                                  CLC
   420                                  LDY # $FF - 7
   421                          -       LDA (@NPTR),Y
   422                                  ADC @P - $FF + 7,Y
   423                                  STA @P - $FF + 7,Y
   424                                  INY
   425                                  BNE -
   426                          +       LSR @P + 7
   427                            !for @i, 6, 0 {
   428                                  ROR @P + @i
   429                            }
   430                            !for @i, 7, 0 {
   431                                  ROR @M + @i
   432                            }
   433                                  DEX
   434                                  BNE --
   435                                  LDY # 9
   436                          -       LDA @M - 2,Y
   437                                  STA (BLK),Y
   438                                  DEY
   439                                  CPY # 2
   440                                  BCS -
   441                                  LDA BLK
   442                                  STA ACCU
   443                                  LDA BLK + 1
   444                                  STA ACCU + 1
   445                                  LDY # 0
   446                                  RTS
   447                          }
   448                          
   449                          !ifdef  caml_PRIM__caml_int64_to_float {
   450                          caml_int64_to_float
   451                                  STY C64_FAC + 5                 ;clear FAC sign
   452                                  STY C64_FACRND                  ;clear FAC round byte
   453                                  LDA # 64 + $80
   454                                  STA C64_FAC                     ;set exponent (64)
   455                                  LDY # 6
   456                                  LDX # 3
   457                          -       LDA (ACCU),Y                    ;copy int64 hi bytes into FAC mantissa
   458                                  STA C64_FAC + 1,X
   459                                  INY
   460                                  DEX
   461                                  BPL -
   462                                  EOR # $80
   463                                  CMP # $80                       ;set carry if int64 is positive
   464                                  +caml_JSR_BASROM C64_FADFLT     ;normalize
   465                                  LDX # <TMP
   466                                  LDY # >TMP
   467                                  +caml_JSR_BASROM C64_MOVMF      ;copy FAC to TMP
   468                          ;       ldy #0                          ;Y = 0 by MOVMF
   469                                  STY C64_FAC + 5                 ;clear FAC sign
   470                                  STY C64_FACRND                  ;clear FAC round byte
   471                                  LDA # 32 + $80
   472                                  STA C64_FAC                     ;set exponent (32)
   473                                  LDY # 2
   474                                  LDX # 3
   475                          -       LDA (ACCU),Y                    ;copy int64 lo bytes into FAC mantissa
   476                                  STA C64_FAC + 1,X
   477                                  INY
   478                                  DEX
   479                                  BPL -
   480                                  SEC                             ;set carry (positive)
   481                                  +caml_JSR_BASROM C64_FADFLT     ;normalize
   482                                  LDA # <TMP
   483                                  LDY # >TMP
   484                                  +caml_JSR_BASROM C64_FADD       ;FAC := TMP + FAC
   485                                  JMP caml_float_alloc_result
   486                          }
   487                          
   488                          ;; Conversion from IEEE754 binary64 to C64FLP and vice-versa.
   489                          ;; See en.wikipedia.org/wiki/Double-precision_floating-point_format
   490                          ;; &   www.c64-wiki.com/wiki/Floating_point_arithmetic
   491                          ;;
   492                          ;; IEEE754:      |±¦e10_e04|e03_e00¦m51_m48|m47_m40|...|m07_m00|
   493                          ;; little-endian |m07_m00|...|m47_m40|e03_e00¦m51_m48|±¦e10_e04| Int64.t
   494                          ;; exponent representation: excess-1023
   495                          ;;      exp = $001...$7FE -> ± (2^(exp-1023) * 1.mantissa)
   496                          ;;      exp = $7FF -> special numbers: NaN, +infinity, -infinity
   497                          ;;      exp = $000, mantissa =  0 -> +0.0, -0.0
   498                          ;;      exp = $000, mantissa <> 0 ->  ± (2^(-1022) * 0.mantissa)
   499                          ;; range:   ±2.22507386E-308 ... ±1.79769313E+308 (normal)
   500                          ;;          ±4.94065646E-324 ... ±2.22507386E-308 (subnormal)
   501                          ;; example: 1.0= |0¦0111111|1111¦0000|00000000|...|00000000|
   502                          ;; little-endian |00000000|...|00000000|1111¦0000|0¦0111111| Int64.t
   503                          ;;
   504                          ;; C64 (in RAM): |E07_E00|±¦M30_M24|M23_M16|M15_M08|M07_M00|
   505                          ;; C64 (in FAC): |E07_E00|1¦M30_M24|M23_M16|M15_M08|M07_M00|±///////|
   506                          ;; exponent representation: excess-128
   507                          ;;      exp = $01...$FF -> ± (2^(exp-128) * 0.1mantissa)
   508                          ;;      exp = $00 -> 0.0
   509                          ;; range:   ±2.93873588E-39 ... ±1.70141183E+38
   510                          ;; example: 1.0= |10000001|0¦0000000|00000000|00000000|00000000|  (RAM)
   511                          ;;          1.0= |10000001|1¦0000000|00000000|00000000|00000000|0|(FAC)
   512                          
   513                          !ifdef  caml_PRIM__caml_int64_bits_of_float {
   514                          caml_int64_bits_of_float
   515                          @EXPHI  = TMP
   516                                  +caml_int64_alloc
   517                                  LDA ACCU
   518                                  STA caml_float_loadFAC_addr
   519                                  LDA ACCU + 1
   520                                  STA caml_float_loadFAC_addr + 1
   521                                  JSR caml_float_loadFAC
   522                                  LDA C64_FAC                     ;load exp
   523                                  CLC
   524                                  ADC # <(1023 - 128 - 1)         ;adjust bias, lo bits
   525                                  STA C64_FAC                     ;save
   526                                  LDA # 0
   527                                  ADC # >(1023 - 128 - 1)         ;idem, hi bits
   528                                  LDX # 3                         ;shift left exp 4 times
   529                          -       ASL C64_FAC
   530                                  ROL
   531                                  DEX
   532                                  BPL -
   533                                  STA @EXPHI
   534                                  LDA C64_FAC + 5                 ;load sign byte
   535                                  AND # %10000000                 ;get bit 7
   536                                  ORA @EXPHI                      ;merge with exp
   537                                  LDY # 9
   538                                  STA (BLK),Y                     ;save |±¦e10_e04|
   539                                  LDX # 4                         ;shift left mantissa 5 times
   540                          -       ASL C64_FAC + 4
   541                            !for @i, 3, 1 {
   542                                  ROL C64_FAC + @i
   543                            }
   544                                  ROL
   545                                  DEX
   546                                  BPL -
   547                                  AND # %00001111                 ;merge m51_m48
   548                                  ORA C64_FAC                     ;with e03_e00
   549                                  DEY
   550                            !for @i, 1, 4 {
   551                                  STA (BLK),Y
   552                                  LDA C64_FAC + @i
   553                                  DEY
   554                            }
   555                                  LDA # 0
   556                                  STA (BLK),Y                     ;put 0 in last 3 bytes
   557                                  DEY
   558                                  STA (BLK),Y
   559                                  DEY
   560                                  STA (BLK),Y
   561                                  TAY
   562                                  LDA BLK
   563                                  STA ACCU
   564                                  LDA BLK + 1
   565                                  STA ACCU + 1
   566                                  ;return result
   567                                  RTS
   568                          }
   569                          
   570                          !ifdef  caml_PRIM__caml_int64_float_of_bits {
   571                          caml_int64_float_of_bits
   572                                  LDY # 9
   573                                  LDA (ACCU),Y                    ;.A <- sign¦e10_e04
   574                                  STA C64_FAC + 5                 ;put sign into FAC sign byte
   575                                  AND # %01111111                 ;clear sign bit
   576                                  TAX
   577                                  DEY
   578                                  LDA (ACCU),Y                    ;.A <- e03_e00¦m51_m48
   579                                  STA C64_FAC + 1
   580                                  SEC
   581                                  SBC # <((1023-128-1) << 4)      ;adjust exp bias, lo bits
   582                                  STA C64_FAC
   583                                  TXA
   584                                  SBC # >((1023-128-1) << 4)      ;idem, hi bits
   585                                  BCS +
   586                                  LDA # 0                         ;treat floats under C64 repr.
   587                                  STA C64_FAC                     ;lower limit as zero:
   588                          @zero   STA C64_FAC + 5                 ;clear minus sign, if any;
   589                                  JMP caml_float_alloc_result     ;allocate float and return
   590                          @exn    +caml_raise Invalid_argument, "Int64.float_of_bits"
   591                          @mask  !byte %11110000
   592                          +       BIT @mask
   593                                  BNE @exn                        ;if NaN, ±inf or overflow, raise exn
   594                            !for @i, 1, 4 {
   595                                  LSR                             ;shift result into FAC exp byte
   596                                  ROR C64_FAC
   597                            }
   598                                  BEQ @zero                       ;if zero skip mantissa loading
   599                                  DEY
   600                                  LDA (ACCU),Y                    ;load significative part of mantissa
   601                                  STA C64_FAC + 2
   602                                  DEY
   603                                  LDA (ACCU),Y
   604                                  STA C64_FAC + 3
   605                                  DEY
   606                                  LDA (ACCU),Y
   607                                  STA C64_FAC + 4
   608                                  DEY
   609                                  LDA (ACCU),Y
   610                                  STA C64_FACRND
   611                                  LDX # 2                         ;shift left 3 times
   612                          -       ASL C64_FACRND
   613                            !for @i, 4, 1 {
   614                                  ROL C64_FAC + @i
   615                            }
   616                                  DEX
   617                                  BPL -
   618                                  LDA C64_FAC + 1
   619                                  ORA # $80                       ;set leftmost bit of mantissa
   620                                  STA C64_FAC + 1
   621                                  JMP caml_float_alloc_result     ;allocate float and return
   622                          }
   623                          
   624                          ; caml_int64_bits_of_float(value vd)
   625                          ; caml_int64_div(value v1, value v2)
   626                          ; caml_int64_mod(value v1, value v2)
   627                          ; caml_int64_bswap(value v)
   628                          ; caml_int64_of_int(value v)
   629                          ; caml_int64_to_int(value v)
   630                          ; caml_int64_of_float
   631                          ; caml_int64_of_int32(value v)
   632                          ; caml_int64_to_int32(value v)
   633                          
   634                          }       ;; zone caml_INT64
   635                          

