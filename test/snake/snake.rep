   304                          !ifdef caml_PRIM__caml_nonstd_string_of_int {
   305                          caml_nonstd_string_of_int
   306                                  ;; Stdlib.string_of_int
   307                                  ;; Convert an int to string, using the C64 format: first char for sign
   308                                  ;; (space if positive, minus if negative), followed by 5 digit max and
   309                                  ;; no non-significative zeroes.
   310                          @DGT    = TMP
   311                          @SKIPZ  = TMP + 1
   312  3468 a9fc                       LDA # String_tag                        ;Max len is 4 words:
   313  346a a204                       LDX # 4                                 ;|'-','1'|'6','3'|'8','3'|\0,\1|
   314  346c 200230                     JSR caml_alloc                          ;Allocate string, addr in BLK
   315  346f a920                       LDA # ' '                               ;Positive numbers start with ' '
   316  3471 242d                       BIT ACCU + 1
   317  3473 100e                       BPL +
   318  3475 38                         SEC                                     ;If value is negative,
   319  3476 a902                       LDA # 2                                 ; negate it
   320  3478 e52c                       SBC ACCU
   321  347a 852c                       STA ACCU
   322  347c 98                         TYA
   323  347d e52d                       SBC ACCU + 1
   324  347f 852d                       STA ACCU + 1
   325  3481 a92d                       LDA # '-'                               ; and put a '-' into the string
   326  3483 9157               +       STA (BLK),Y
   327  3485 c8                         INY
   328  3486 462d                       LSR ACCU + 1                            ;Get rid of trailing 1
   329  3488 662c                       ROR ACCU
   330  348a a930                       LDA # '0'                               ;Set SKIPZ flag to '0' (=ignore
   331  348c 8546                       STA @SKIPZ                              ; all initial zeroes)
   332  348e a203                       LDX # 3                                 ;For X := 3 downto 0
   333  3490 8545               --      STA @DGT                                ; Init DGT to '0'
   334  3492 a52c                       LDA ACCU                                ; Loop for calculating DGT:
   335  3494 38                         SEC
   336  3495 fddc34             -       SBC @lo10,X                             ;  Subtract 10^(X+1) from ACCU
   337  3498 48                         PHA
   338  3499 a52d                       LDA ACCU + 1
   339  349b fde034                     SBC @hi10,X
   340  349e 9009                       BCC +                                   ; Exit loop on negative result
   341  34a0 852d                       STA ACCU + 1                            ;  Store result in ACCU
   342  34a2 68                         PLA
   343  34a3 852c                       STA ACCU
   344  34a5 e645                       INC @DGT                                ;  Set DGT to next char digit
   345  34a7 b0ec                       BCS -                                   ; BCS=JMP, Continue loop
   346  34a9 68                 +       PLA
   347  34aa a545                       LDA @DGT
   348  34ac c546                       CMP @SKIPZ                              ; If DGT='0' & SKIPZ='0'
   349  34ae f007                       BEQ +                                   ; then ignore current digit
   350  34b0 c646                       DEC @SKIPZ                              ; else stop skipping zeroes,
   351  34b2 9157                       STA (BLK),Y                             ;  put DGT into the string,
   352  34b4 c8                         INY
   353  34b5 a930                       LDA # '0'                               ;  set A='0' for next iteration.
   354  34b7 ca                 +       DEX                                     ; Decrement counter
   355  34b8 10d6                       BPL --                                  ;End_For
   356  34ba 052c                       ORA ACCU                                ;A := '0'|ACCU  (last digit)
   357  34bc 9157                       STA (BLK),Y
   358  34be c8                         INY
   359  34bf a900                       LDA # 0                                 ;Pad string with \0
   360  34c1 9157                       STA (BLK),Y
   361  34c3 c8                         INY
   362  34c4 98                         TYA
   363  34c5 4a                         LSR                                     ;Compute block size (in wo.)
   364  34c6 aa                         TAX
   365  34c7 9005                       BCC +
   366  34c9 a901                       LDA # 1                                 ;Add \1 pad if necessary
   367  34cb 9157                       STA (BLK),Y
   368  34cd e8                         INX                                     ;size +1 for \0\1
   369  34ce a557               +       LDA BLK
   370  34d0 852c                       STA ACCU
   371  34d2 a558                       LDA BLK + 1
   372  34d4 852d                       STA ACCU + 1
   373  34d6 a000                       LDY # 0
   374  34d8 203632                     JSR caml_shrink_latest_alloc            ;Shrink block to computed size
   375  34db 60                         RTS
   376  34dc 0a64e810           @lo10   !byte <10, <100, <1000, <10000
   377  34e0 00000327           @hi10   !byte >10, >100, >1000, >10000
   378                          }
