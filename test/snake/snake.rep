   131                          
   132                                  Double_wosize   = 3
   133                          
   134                          !macro  caml_move_float .FROM, .TO {            ;Copy float block fields
   135                                  LDY # 2 * Double_wosize - 2             ;and set Y=0 at exit
   136                          -       LDA (.FROM),Y
