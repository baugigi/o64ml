   333                          !ifdef caml_PRIM__caml_ldexp_float {
   334                                  ;; compute ACCU * 2 ^ N, -255 < N < 255.
   335                                  ;; To be called with    SP[0] = Val_int(N) if N >= 0
   336                                  ;;                      SP[0] = Val_int(256-N) if N < 0
   337                          caml_ldexp_float
   338                                  LDA # Double_tag
   339                                  LDX # Double_wosize
   340                                  JSR caml_alloc
   341                                  INY
   342                                  LDA (SP),Y
   343                                  DEY
   344                                  LSR                             ;.A := Int_val(>SP[0])
   345                                  BEQ @add                        ;N >= 0 ?
   346                                  LDA (SP),Y                      ;no:
   347                                  ROR                             ;   .A := Int_val(SP[0])
   348                                  SEC
   349                                  EOR # $FF                       ;   subtract .A from exponent
   350                                  ADC (ACCU),Y                    ;   (eor/adc = inverse sbc)
   351                                  BCS @save                       ;   if underflow,
   352                                  LDA # 0                         ;   set exp = 0 (result = 0.0)
   353                          @save   STA (BLK),Y                     ;save exp byte
   354                                  BEQ +                           ;skip copy of mantissa if underflow
   355                                  LDY # 4
   356                          -       LDA (ACCU),Y                    ;copy mantissa
   357                                  STA (BLK),Y
   358                                  DEY
   359                                  BNE -
   360                          +       LDA BLK
   361                                  STA ACCU
   362                                  LDA BLK + 1
   363                                  STA ACCU + 1                    ;ACCU := BLK
   364                                  RTS
   365                          @add    LDA (SP),Y                      ;yes:
   366                                  ROR                             ;   .A := Int_val(SP[0])
   367                                  CLC
   368                                  ADC (ACCU),Y                    ;   add .A to exponent
   369                                  BCC @save                       ;   go to @save
   370                                  LDX # C64_ERR_OVERFLOW          ;   manage overflow (error)
   371                                  JMP (C64_IERROR)
   372                          }
   373                          
   374                          !ifdef caml_PRIM__caml_frexp_float {
   375                          caml_frexp_float
   376                                  @NEW = BLK                      ;used by caml_alloc
   377                                  @FLO = TMP
   378                                  ;; allocate a new float with same mantissa and exp=0
   379                                  LDA # Double_tag                ;tag of new float
   380                                  LDX # Double_wosize             ;size of new float
   381                                  JSR caml_alloc                  ;alloc new float
   382                                  LDA (ACCU),Y                    ;load (biased) exponent
   383                                  PHA                             ;save it for later
   384                                  BNE @nz                         ;float is 0.0?
   385                                  STA (@NEW),Y                    ;yes: set new float exp = 0
   386                                  BEQ @pair                       ;     and go further
   387                          @nz     LDA # $80                       ;no: set new float exp = $80
   388                                  STA (@NEW),Y
   389                                  LDY # 4                         ;    then copy the mantissa
   390                          -       LDA (ACCU),Y
   391                                  STA (@NEW),Y
   392                                  DEY
   393                                  BNE -
   394                                  ;; allocate a new pair (float * int)
   395                          @pair   LDA @NEW
   396                                  STA @FLO
   397                                  LDA @NEW + 1
   398                                  STA @FLO + 1                    ;save new float ptr in @FLO
   399                                  LDA # 0                         ;tag of new pair
   400                                  LDX # 2                         ;size of new pair
   401                                  JSR caml_alloc                  ;alloc new pair
   402                                  ;; set pair elements
   403                                  LDA @FLO
   404                                  STA (@NEW),Y
   405                                  INY
   406                                  LDA @FLO + 1
   407                                  STA (@NEW),Y                    ;field0 := new float
   408                                  INY
   409                                  LDX # 0
   410                                  PLA                             ;reload biased exponent
   411                                  BNE @debias                     ;exp = 0?
   412                                  LDA # <Val_zero                 ;yes: set field1,lo := <Val_int(0)
   413                                  STA (@NEW),Y
   414                                  LDA # >Val_zero
   415                                  BEQ @fld1h                      ;     beq=jmp to set field1,hi
   416                          @debias SEC                             ;no:  compute debiased exponent
   417                                  SBC # $80
   418                                  BCS @valint                     ;     if negative,
   419                                  DEX                             ;     set hi byte = $FF
   420                                  SEC
   421                          @valint ROL                             ;compute <Val_int(exponent)
   422                                  STA (@NEW),Y                    ;field1,lo := <Val_int(exponent)
   423                                  TXA
   424                                  ROL                             ;compute >Val_int(exponent)
   425                          @fld1h  INY
   426                                  STA (@NEW),Y                    ;field1,hi := >Val_int(exponent)
   427                                  LDA @NEW
   428                                  STA ACCU
   429                                  LDA @NEW + 1
   430                                  STA ACCU + 1                    ;ACCU := new pair
   431                                  LDY # 0
   432                                  RTS
   433                          }
