; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib_strings.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; Progetto BreadCaml / The BreadCaml Project
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
     6                          ;; modificato nei termini della licenza GNU GPL ver. 2,  come specificato
     7                          ;; nel file LICENZA-it nella cartella principale del progetto.
     8                          ;; 
     9                          ;; This program is  free software; you can redistribute  it and/or modify
    10                          ;; it under the terms of the GNU  General Public License (GPL) ver. 2, as
    11                          ;; specified in the LICENSE-en file in the project root folder.
    12                          ;; ——————————————————————————————————————————————————————————————————————
    13                          ;;; ---------------------------------------------------------------------------
    14                          ;;; STRINGS (ocaml-4.14.4/runtime/str.c)
    15                          ;;; ---------------------------------------------------------------------------
    16                          
    17                          !zone caml_STRINGS {
    18                          
    19                          !ifdef caml_PRIM__caml_string_of_bytes {
    20                          caml_string_of_bytes = caml_bytes_of_string
    21                          }
    22                          !ifdef caml_PRIM__caml_bytes_of_string {
    23                          caml_bytes_of_string
    24  33b8 60                         RTS
    25                          }
    26                          
    27                          !ifdef caml_PRIM__caml_create_bytes {
    28                          caml_create_bytes = caml_create_string
    29                          }
    30                          !ifdef caml_PRIM__caml_create_string {
    31                          caml_create_string
    32                                  ;; ACCU = length
    33                                  ;; alloc a new block for a string of given length (max 509)
    34                          
    35  33b9 a52d                       LDA ACCU + 1                            ;load >length
    36  33bb 4a                         LSR                                     ;
    37  33bc 662c                       ROR ACCU                                ;ACCUl,A := Int_val(lenght)
    38  33be 4a                         LSR
    39  33bf d02d                       BNE +++                                 ;A>0 => len > max, raise exn.
    40  33c1 662c                       ROR ACCU                                ;ACCUl :=  Int_val(lenght) / 2
    41  33c3 08                         PHP                                     ;save carry (remainder)
    42  33c4 a62c                       LDX ACCU                                ;X := block size, in words
    43  33c6 e8                         INX                                     ;take into account Ocaml padding
    44  33c7 f024                       BEQ ++                                  ;Exception if size > 255
    45  33c9 a9fc                       LDA # String_tag                        ;load tag
    46  33cb 200230                     JSR caml_alloc                          ;allocate block
    47  33ce a557                       LDA BLK
    48  33d0 852c                       STA ACCU
    49  33d2 a558                       LDA BLK + 1
    50  33d4 852d                       STA ACCU + 1                            ;ACCU := address of new block
    51  33d6 ca                         DEX                                     ;Compute the padding bytes:
    52  33d7 8a                         TXA                                     ;A := size - 1
