   538                          !ifdef caml_PRIM__caml_float_loadFAC {
   539                                  ;; how to use:
   540                                  ;; 1) set  caml_float_loadFAC__addr
   541                                  ;; 2) call caml_float_loadFAC
   542                          caml_float_loadFAC
   543                                  LDX # 4
   544                          caml_float_loadFAC__addr = * + 1
   545                          -       LDA .dummy,X            ;SMC: replaced with real address
   546                                  STA C64_FAC,X
   547                                  DEX
   548                                  BPL -
   549                                  LDA C64_FAC + 1         ;copy 1st byte of mantissa
   550                                  STA C64_FAC + 5         ;to FAC sign byte
   551                                  ORA # $80
   552                                  STA C64_FAC + 1         ;set 1st bit of mantissa = 1
   553                                  INX
   554                                  STX C64_FACRND          ;FAC round byte := 0
   555                                  RTS
   556                          }
