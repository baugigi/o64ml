   341                          !ifdef caml_PRIM__caml_array_unsafe_get {
   342                          caml_array_unsafe_get
   343                                  ;; return an array element (unsafe version)
   344                                  ;; ACCU = array
   345                                  ;; SP[0] = index
   346                                  LDY # -2
   347                                  DEC ACCU + 1
   348                                  LDA (ACCU),Y                            ; load tag
   349                                  INC ACCU + 1                            ; restore ptr
   350                                  LDY # 0
   351                                  CMP # Double_array_tag                  ; check if float
   352                                  BEQ caml_floatarray_unsafe_get         ; yes: special case
   353                                  LDA (SP),Y                              ; Val_int(index), lo
   354                                  STA TMP
   355                                  INY
   356                                  LDA (SP),Y                              ; Val_int(index), hi
   357                                  BEQ +
   358                                  INC ACCU + 1
   359                          +       LDY TMP
   360                                  ;; get array element
   361                                  LDA (ACCU),Y                            ; array[index], hi
   362                                  TAX
   363                                  DEY
   364                                  LDA (ACCU),Y                            ; array[index], lo
   365                                  STA ACCU
   366                                  STX ACCU + 1
   367                                  LDY # 0
   368                                  RTS
   369                          }
   370                          
   371                          !ifdef caml_PRIM__caml_floatarray_unsafe_get {
   372                                  ;; return an array element (unsafe, floatarray version)
   373                                  ;; ACCU = array
   374                                  ;; SP[0] = index
   375                          caml_floatarray_unsafe_get
   376                                  ;; load index, lo (ignore hi byte)
   377                                  LDA (SP),Y                      ; 2*i+1
   378                                  ;; calc 3 * i
   379                                  AND # $FE
   380                                  STA TMP
   381                                  LSR
   382                                  CLC
   383                                  ADC TMP
   384                                  ;; ACCU <- &array[index]
   385                                  ASL
   386                                  BCC +
   387                                  INC ACCU + 1
   388                                  CLC
   389                          +       ADC ACCU
   390                                  STA ACCU
   391                                  BCC +
   392                                  INC ACCU + 1
   393                                  ;; allocate float
   394                          +       LDA # Double_tag
   395                                  LDX # Double_wosize
   396                                  JSR caml_alloc
   397                                  ;; copy float
   398                                  +caml_move_float ACCU, BLK
   399                                  ;; return float
   400                                  LDA BLK
   401                                  STA ACCU
   402                                  LDA BLK + 1
   403                                  STA ACCU + 1
   404                                  RTS
   405                          }
