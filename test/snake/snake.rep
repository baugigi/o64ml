    10                          ;; it under the terms of the GNU  General Public License (GPL) ver. 2, as
    11                          ;; specified in the LICENSE-en file in the project root folder.
    12                          ;; ——————————————————————————————————————————————————————————————————————
    13                          ;; ----------------------------------------------------------------------
    14                          ;; ARRAYS (ocaml-4.14.4/runtime/array.c)
    15                          ;; ----------------------------------------------------------------------
    16                          !zone caml_ARRAYS {
    17                          
    18                          !ifndef caml_arrays_warn {
    19                          caml_arrays_warn
    20                            !warn "TODO: caml_array_fill"
    21                            !warn "TODO: caml_floatarray_blit"
    22                            !warn "TODO: check for GC-invalidated pointers"
    23                          }
    24                          	
    25                          !ifdef caml_PRIM__caml_make_vect {
    26                          caml_make_vect
    27                                  ;; allocate and initialize an array
    28                                  ;; ACCU = length
    29                                  ;; SP[0] = init
    30                          @NFLO2  = TMP
    31                          @INIT   = TMP + 2
    32                                  ;; load init
    33                                  INY
    34                                  LDA (SP),Y
    35                                  STA @INIT + 1
    36                                  DEY
    37                                  LDA (SP),Y
    38                                  STA @INIT
    39                                  ;; is init a block?
    40                                  BIT caml_is_block                       ; test @INIT
    41                                  BNE @no_float_array
    42                                  ;; tag(init) = Double_tag?
    43                                  LDY # -2
    44                                  DEC @INIT + 1
    45                                  LDA (@INIT),Y
    46                                  INC @INIT + 1
    47                                  LDY # 0
    48                                  CMP # Double_tag
    49                                  BNE @no_float_array
    50                          ;;      ;; is init in heap?
    51                          ;;      SEC
    52                          ;;      LDA @INIT
    53                          ;;      SBC # < caml_heap_start
    54                          ;;      STA TMP
    55                          ;;      LDA @INIT + 1
    56                          ;;      SBC # > caml_heap_start
    57                          ;;      STA TMP + 1
    58                          ;;      LDA TMP
    59                          ;;      CMP # < caml_heap_sz
    60                          ;;      LDA TMP + 1
    61                          ;;      SBC # > caml_heap_sz
    62                          ;;      BCS @no_float_array
    63                                  ;; allocate float array 
    64                                  JSR caml_floatarray_create
    65                                  ;; init floats
    66                                  LDA @NFLO2                      ; see caml_floatarray_create
    67                                  LSR
    68                                  TAX                             ; X = no. of floats
    69                          ;       CLC
    70                          -       +caml_move_float @INIT, BLK
    71                                  LDA # < (2 * Double_wosize)
    72                                  ADC BLK
    73                                  STA BLK
    74                                  LDA # > (2 * Double_wosize)
    75                                  ADC BLK + 1
    76                                  STA BLK + 1
    77                                  DEX
    78                                  BNE -
    79                                  RTS
    80                          @no_float_array
    81                                  ;; check length
    82                                  LSR ACCU + 1
    83                                  BNE @error
    84                                  LDA ACCU
    85                                  ROR
    86                                  BNE +
    87                                  ;; length = 0, empty array
    88                                  LDA # < caml_atom0
    89                                  STA ACCU
    90                                  LDA # > caml_atom0
    91                                  STA ACCU + 1
    92                                  RTS
    93                                  ;; length > 0, allocate array
    94                          +       TAX                             ; size
    95                                  TYA                             ; tag = 0
    96                                  JSR caml_alloc
    97                                  LDA BLK
    98                                  STA ACCU
    99                                  LDA BLK + 1
   100                                  STA ACCU + 1
   101                                  ;; init fields
   102                          -       LDA @INIT
   103                                  STA (BLK),Y
   104                                  INY
   105                                  LDA @INIT + 1
   106                                  STA (BLK),Y
   107                                  INY
   108                                  BNE +
   109                                  INC BLK + 1
   110                          +       DEX
   111                                  BNE -
   112                                  LDY # 0
   113                                  RTS
   114                          @error  +caml_raise Invalid_argument, "Array.make"
   115                          }
   116                          
   117                          !ifdef caml_PRIM__caml_floatarray_create {
   118                                  ;; allocate an array of floats
   119                                  ;; ACCU = length
   120                          caml_floatarray_create
   121                          @NFLO2  = TMP                   ; see caml_make_vect
   122                                  LDA ACCU + 1
   123                                  BNE @error
   124                                  LDA ACCU
   125                                  ;; exn if 3 * index > 255
   126                                  AND # $FE
   127                                  BNE +
   128                                  ;; length = 0, empty array
   129                                  LDA # < caml_atom0
   130                                  STA ACCU
   131                                  LDA # > caml_atom0
   132                                  STA ACCU + 1
   133                                  RTS
   134                                  ;; length > 0, size is length * 3
   135                          +       STA @NFLO2
   136                                  LSR
   137                          ;       CLC                             ;implicit
   138                                  ADC @NFLO2
   139                                  BCS @error
   140                                  ;; allocate array of floats
   141                                  TAX                             ; size
   142                                  LDA # Double_array_tag          ; tag
   143                                  JSR caml_alloc
   144                                  LDA BLK
   145                                  STA ACCU
   146                                  LDA BLK + 1
   147                                  STA ACCU + 1
   148                                  RTS
   149                          @error  +caml_raise Invalid_argument, "Float.Array.create"
   150                          }
   151                          
   152                          !ifdef caml_PRIM__caml_make_array {
   153                                  ;; if init is a block of floats, unbox all elements
   154                                  ;; ACCU = init
   155                          caml_make_array
   156                          @FIELD0 = TMP
   157                          @NFLOATS= TMP + 2
   158                                  ;; exit if size(init) = 0
   159                                  LDA # >caml_atom0
   160                                  CMP ACCU + 1
   161                                  BNE +
   162                                  LDA # <caml_atom0
   163                                  CMP ACCU
   164                                  BEQ @exit
   165                                  ;; exit if Field(init,0) is not a block
   166                          +       INY
   167                                  LDA (ACCU),Y
   168                                  STA @FIELD0
   169                                  INY
   170                                  LDA (ACCU),Y
   171                                  STA @FIELD0 + 1
   172                                  BIT caml_is_block                       ; test @FIELD0
   173                                  BNE @exit
   174                          ;;      ;; exit if Field(init,0) is out of heap
   175                          ;;      SEC
   176                          ;;      LDA @FIELD0
   177                          ;;      SBC # < caml_heap_start
   178                          ;;      STA TMP
   179                          ;;      LDA @FIELD0 + 1
   180                          ;;      SBC # > caml_heap_start
   181                          ;;      STA TMP + 1
   182                          ;;      LDA TMP
   183                          ;;      CMP # < caml_heap_sz
   184                          ;;      LDA TMP + 1
   185                          ;;      SBC # > caml_heap_sz
   186                          ;;      BCS @exit
   187                                  ;; exit if tag(Field(init,0)) <> Double_tag
   188                                  LDY # -2
   189                                  DEC @FIELD0 + 1
   190                                  LDA (@FIELD0),Y
   191                                  CMP # Double_tag
   192                                  BEQ +
   193                                  LDY # 0
   194                          @exit   RTS
   195                                  ;; check length
   196                          +       INY
   197                                  DEC ACCU + 1
   198                                  LDA (ACCU),Y
   199                          ;       inc ACCU + 1
   200                                  INY
   201                                  CMP # 255 DIV Double_wosize + 1
   202                                  BCC +
   203                                  +caml_raise Out_of_memory
   204                                  ;; size is lenght * 3
   205                          +       STA @NFLOATS
   206                                  ASL
   207                          ;       clc
   208                                  ADC @NFLOATS
   209                                  ;; allocate array of floats
   210                                  TAX
   211                                  LDA # Double_array_tag
   212                                  JSR caml_alloc
   213                                  LDA BLK
   214                                  STA ACCU
   215                                  LDA BLK + 1
   216                                  STA ACCU + 1
   217                                  ;; init fields
   218                                  INC @FIELD0 + 1                 ; previously dec'ed
   219                          -       +caml_move_float @FIELD0, BLK
   220                                  DEX
   221                                  BEQ @exit
   222                                  INC @FIELD0
   223                                  INC @FIELD0
   224                                  BNE +
   225                                  INC @FIELD0 + 1
   226                          +       INC BLK
   227                                  INC BLK
   228                                  BNE -
   229                                  INC BLK + 1
   230                                  JMP -
   231                          }
