   113                          !ifdef caml_PRIM__caml_string_set {
   114                          caml_string_set
   115                                  ;; ACCU=string, SP[0]=index, SP[1]=newval
   116                                  ;; string.[index]<-newval; return: ()
   117                          ;       TMP                                     ; used by caml_string_index_y
   118                          ;       TMP + 1                                 ; used by caml_string_index_y
   119                          @CHAR   = TMP + 2
   120                                  LDY # 3
   121                                  LDA (SP),Y                              ; get newval, hi
   122                                  DEY
   123                                  LSR
   124                                  LDA (SP),Y                              ; get newval, lo
   125                                  ROR
   126                                  STA @CHAR                               ; save char_val(newval)
   127                                  JSR caml_string_index_y                 ; Y := index
   128                                  LDA @CHAR
   129                                  STA (ACCU),Y                            ; modify string in place
   130                                  LDY # <Val_unit
   131                                  STY ACCU
   132                                  DEY
   133                                  STY ACCU + 1                            ; return ()
   134                                  RTS
   135                          }
