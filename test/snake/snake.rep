    22                          }
    23                          
    24                          !ifdef caml_PRIM__caml_ensure_stack_capacity {
    25                          ;; TODO: raise  Stack_overflow if stack space is not enough."
    26                                  ;; ACCU = required space (ignored)
    27                          caml_ensure_stack_capacity
    28                                  ;; do nothing and return Val_unit
    29                                  LDA # < Val_unit
    30                                  STA ACCU
    31                                  ;LDY # 0
    32                                  STY ACCU + 1
    33                                  RTS
    34                          }
    35                          
    36                          }       ;; !zone caml_STACK
