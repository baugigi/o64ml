    14                          !zone caml_CODEGEN {
    15                          ;; ----------------------------------------------------------------------------
    16                          ;;      CODE GENERATION
    17                          ;; ----------------------------------------------------------------------------
    18                          
    19                                  ;;      caml_INTERP undefined:  generate native code
    20                                  ;;      caml_INTERP = 1:        generate bytecode for interpretation
    21                          
    22                          ;; Check for out-of-range argument
    23                          !macro caml_range .min, .arg, .max, .txt {
    24                            !if (.arg < .min) | (.arg > .max) {
    25                                  !error .txt + " = ", .arg, " out of range [", .min, ", ", .max, "]"
    26                            }
    27                          }
    28                          
    29                          ;; These shouldn't be necessary: ocamlc should have already given up
    30                          !macro  i82     {!serious "ERROR: Objects and classes not implemented"}
    31                          !macro  i8d .t  {!serious "ERROR: Objects and classes not implemented"}
    32                          !macro  i8e     {!serious "ERROR: Objects and classes not implemented"}
    33                          
    35                          !ifndef caml_INTERP {
    36                                  ;; --------------------------------------------------------------------
    37                                  ;;      NATIVE CODE GENERATION
    38                                  ;; --------------------------------------------------------------------
    39                          
    40                          ;; Macros in opcode order, but dependencies
    41                          
    42                          ;; i00-i12 depend on i08
    43                          !macro  i08 .n {                                ;ACCESS n
    44                                  +caml_range 0, .n, $7FFF, "ACC n: n" 
    45                                  .n2h = >(2 * .n)
    46                                  .n2l = <(2 * .n)
    47                            !if .n2l > 0 {
    48                                  LDY # .n2l
    49                            }
    50                            !if .n2h = 0 {
    51                                  !set    caml_gen_ACCL = 1
    52                                  JSR ACCL
    53                            } elif .n2h = 1 {
    54                                  !set    caml_gen_ACCL = 1
    55                                  INC SP + 1
    56                                  JSR ACCL
    57                                  DEC SP + 1
    58                            } else {
    59                                  !set    caml_gen_ACCH = 1
    60                                  LDA # .n2h
    61                                  JSR ACCH
    62                            }
    63                          }
    64                          !macro  i00     {+i08 0}                        ;ACCi -> ACC i
    65                          !macro  i01     {+i08 1}
    66                          !macro  i02     {+i08 2}
    67                          !macro  i03     {+i08 3}
    68                          !macro  i04     {+i08 4}
    69                          !macro  i05     {+i08 5}
    70                          !macro  i06     {+i08 6}
    71                          !macro  i07     {+i08 7}
    72                          
    73                          ;; i0a-i12, i1a-i1e, i31-i34, i36, i38, i3c-i3d, i68-i6c depend on i09
    74                          !macro  i09 {                                   ;PUSH
    75                                  !set    caml_gen_PUSH = 1
    76                                  JSR PUSH
    77                          }
    78                          !macro  i0a     {+i09}                          ;PUSHACC0 -> PUSH
    79                          !macro  i0b     {+i09 : +i08 1}                 ;PUSHACCi -> PUSH; ACC i
    80                          !macro  i0c     {+i09 : +i08 2}
    81                          !macro  i0d     {+i09 : +i08 3}
    82                          !macro  i0e     {+i09 : +i08 4}
    83                          !macro  i0f     {+i09 : +i08 5}
    84                          !macro  i10     {+i09 : +i08 6}
    85                          !macro  i11     {+i09 : +i08 7}
    86                          !macro  i12 .n  {+i09 : +i08 .n}                ;PUSHACC n -> PUSH; ACC n
    87                          !macro  i13 .n {                                ;POP n
    88                                  +caml_range 0, .n, $7FFF, "POP n: n"
    89                                  .n2h = >(2 * .n)
    90                                  .n2l = <(2 * .n)
    91                            !if .n = 0 {
    92                                  ;NOP
    93                            } elif .n = 1 {
    94                                  !set    caml_gen_POP1 = 1
    95                                  JSR POP1
    96                            } else {
    97                                  LDA # .n2l
    98                              !if .n2h > 0 {
    99                                  LDY # .n2h
   100                              }
   101                                  !set    caml_gen_POPN = 1
   102                                  JSR POPN
   103                            }
   104                          }
   105                          !macro  i14 .n {                                ;ASSIGN n
   106                                  +caml_range 0, .n, $7FFF, "ASSIGN n: n"
   107                                  .n2h = >(2 * .n)
   108                                  .n2l = <(2 * .n)
   109                                  !set    caml_gen_ASSIGNL = 1
   110                            !if .n2l > 0 {
   111                                  LDY # .n2l
   112                            }
   113                            !if .n2h = 0 {
   114                                  JSR ASSIGNL
   115                            } elif .n2h = 1 {
   116                                  INC SP + 1
   117                                  JSR ASSIGNL
   118                                  DEC SP + 1
   119                            } else {
   120                                  !set    caml_gen_ASSIGNH = 1
   121                                  LDA # .n2h
   122                                  JSR ASSIGNH
   123                                  STX SP + 1
   124                            }
   125                          }
   126                          
   127                          ;; i15-i1e depend on i19
   128                          !macro  i19 .n {                                ;ENVACC n
   129                                  +caml_range 0, .n, $FE, "ENVACC n: n"
   130                                  .n2h = >(2 * .n)
   131                                  .n2l = <(2 * .n)
   132                                  !set    caml_gen_ENVACC = 1
   133                            !if .n2l > 0 {
   134                                  LDY # .n2l
   135                            }
   136                            !if .n2h > 0 {
   137                                  INC ENV + 1
   138                                  JSR ENVACC
   139                                  DEC ENV + 1
   140                            } else {
   141                                  JSR ENVACC
   142                            }
   143                          }
   144                          !macro  i15     {+i19 1}                        ;ENVACCi -> ENVACC i
   145                          !macro  i16     {+i19 2}
   146                          !macro  i17     {+i19 3}
   147                          !macro  i18     {+i19 4}
   148                          !macro  i1a     {+i09 : +i19 1}                 ;PUSHENVACCi -> PUSH; ENVACC i
   149                          !macro  i1b     {+i09 : +i19 2}
   150                          !macro  i1c     {+i09 : +i19 3}
   151                          !macro  i1d     {+i09 : +i19 4}
   152                          !macro  i1e .n  {+i09 : +i19 .n}                ;PUSHENVACC n -> PUSH; ENVACC n
   153                          !macro  i1f .adr {                              ;PUSHRETADDR adr
   154                                  !set    caml_gen_PHRET = 1
   155                                  LDA # <.adr
   156                                  LDX # >.adr
   157                                  JSR PHRET
   158                          }
   159                          
   160                          ;; i21-i23 depend on i20
   161                          !macro  i20 .n {                                ;APPLY n
   162                                  +caml_range 1, .n, $7F, "APPLY n: n"
   163                                  !set    caml_gen_APPLY = 1
   164                                  LDY # 2 * .n - 1
   165                            !if .n <= 3 {
   166                                  !set    caml_gen_APPLY13 = 1
   167                                  JSR APPLY13                             ;JMP & push retadr-1 on hw stack
   168                            } else {
   169                                  JMP APPLY
   170                            }
   171                          }
   172                          !macro  i21     {+i20 1}                        ;APPLYi -> APPLY i
   173                          !macro  i22     {+i20 2}
   174                          !macro  i23     {+i20 3}
   175                          
   176                          ;; i25-i27 depend on i24
   177                          !macro  i24 .n, .s {                            ;APPTERM n s
   178                                  +caml_range 1, .n, $7F, "APPTERM n s: n"
   179                                  +caml_range .n, .s, $7F, "APPTERM n s: s"
   180                                  !set    caml_gen_APPTRM1 = 1
   181                                  LDX # 2 * (.s - .n)
   182                            !if .n = 1 {
   183                                  INY
   184                                  JMP APPTRM1
   185                            } else {
   186                                  !set    caml_gen_APPTRMN = 1
   187                                  LDA # 2 * (.n - 1)
   188                                  JMP APPTRMN
   189                            }
   190                          }
   191                          !macro  i25 .s  {+i24 1,.s}                     ;APPTERMi s -> APPTERM i s
   192                          !macro  i26 .s  {+i24 2,.s}
   193                          !macro  i27 .s  {+i24 3,.s}
   194                          !macro  i28 .n {                                ;RETURN n
   195                                  +caml_range 0, .n, $7F, "RETURN n: n"
   196                                  !set    caml_gen_RETURN = 1
   197                                  !set    caml_gen_GORETURN = 1
   198                            !if .n = 0 {
   199                                  TYA
   200                            } else {
   201                                  LDA # 2 * .n
   202                            }
   203                                  JMP RETURN
   204                          }
   205                          !macro  i29 {                                   ;RESTART
   206                                  !set    caml_gen_RESTART = 1
   207                                  !set    caml_restart_len = @end - *     ;needed by GRAB routine
   208                                  JSR RESTART
   209                          @end
   210                          }
   211                          !macro  i2a .n {                                ;GRAB n
   212                                  +caml_range 0, .n, $7C, "GRAB n: n"
   213                                  +Val_Int ~.v, .n
   214                                  !set    caml_gen_GRAB = 1
   215                                  !set    caml_gen_GORETURN = 1
   216                                  !set    caml_grab_len = @end - *        ;needed by GRAB routine
   217                                  LDA # .v
   218                                  JSR GRAB
   219                          @end
   220                          }
   221                          !macro  i2b .n, .ptr {                          ;CLOSURE n ptr
   222                                  +caml_range 0, .n, $7F, "CLOSURE n p: n"
   223                                  LDX # .n
   224                                  LDA # <.ptr
   225                                  LDY # >.ptr
   226                                  !set    caml_gen_CLOSURE = 1
   227                                  JSR CLOSURE
   228                          }
   229                          !macro  i2c .f, .v, .o, .t {                    ;CLOSUREREC f v o t
   230                                  +caml_range 1, .f, $80, "CLOSUREREC f v o t: f"
   231                                  +caml_range 0, .v, $FE, "CLOSUREREC f v o t: v"
   232                                  +caml_range 1, 2 * .f - 1 + .v, $FF, "CLOSUREREC f v o t: 2f-1+v"
   233                                  !set    caml_gen_CLOSREC = 1
   234                                  LDA # <.data
   235                                  LDY # >.data
   236                                  JSR CLOSREC
   237                                  JMP +
   238                                  !byte .v, .f
   239                          .data   !word .o, .t
   240                          +
   241                          }
   242                          
   243                          ;; i2d-i2f, i31-i34 depend on i30
   244                          !macro  i30 .n {                                ;OFFSETCLOSURE n
   245                                  +caml_range -$FE, .n, $FE, "OFFSETCLOSURE n: n"
   246                                  +caml_range 0, .n mod 2, 0, "OFFSETCLOSURE n: n mod 2"
   247                                  .n2h = >(2 * .n)
   248                                  .n2l = <(2 * .n)
   249                            !if .n2h > 0 {
   250                                  LDX # .n2h
   251                              }
   252                            !if .n = 0 {
   253                                  !set    caml_gen_OFSCL0 = 1
   254                                  JSR OFSCL0
   255                            } else {
   256                                  !set    caml_gen_OFSCLN = 1
   257                                  LDA # .n2l
   258                                  JSR OFSCLN
   259                            }
   260                          }
   261                          !macro  i2d     {+i30 -2}                       ;OFFSETCLOSUREi -> OFFS... i
   262                          !macro  i2e     {+i30 0}
   263                          !macro  i2f     {+i30 2}
   264                          !macro  i31     {+i09 : +i30 -2}                ;PUSHOFFSETCLOSUREi -> PUSH;...
   265                          !macro  i32     {+i09 : +i30 0}
   266                          !macro  i33     {+i09 : +i30 2}
   267                          !macro  i34 .n  {+i09 : +i30 .n}                ;PUSHOFFSETCLOSURE n-> PUSH;...
   268                          
   269                          ;; i36-i38 depend on i35
   270                          !macro  i35 .n {                                ;GETGLOBAL n
   271                                  +caml_range 0, .n, $7FFF, "GETGLOBAL n: n"
   272                            !if .n < caml_exn_no {
   273                                  LDA # < caml_std_exn[.n]
   274                                  STA ACCU
   275                                  LDA # > caml_std_exn[.n]
   276                                  STA ACCU + 1
   277                            } else {
   278                                  .ofs = 2 * (.n - caml_exn_no)
   279                                  LDA caml_glob_table + .ofs
   280                                  STA ACCU
   281                                  LDA caml_glob_table + .ofs + 1
   282                                  STA ACCU + 1
   283                            }
   284                          }
   285                          !macro  i36 .n  {+i09 : +i35 .n}                ;PUSHGETGOBAL n -> PUSH; ...
   286                          
   287                          ;; i37-138, i43-i46 depend on i47
   288                          !macro  i47 .n {                                ;GETFIELD n
   289                                  +caml_range 0, .n, $FE, "GETFIELD n: n"
   290                                  !set    caml_gen_GETFLD0 = 1
   291                            !if .n = 0 {
   292                                  JSR GETFLD0
   293                            } else {
   294                                  !set    caml_gen_GETFLDN = 1
   295                                  LDA # .n
   296                                  JSR GETFLDN
   297                            }
   298                          }
   299                          !macro  i37 .n,.m {+i35 .n : +i47 .m}           ;GETGLOBALFIELD n m -> GETGL...
   300                          !macro  i38 .n,.m {+i09 : +i35 .n : +i47 .m}    ;PUSHGETGLOBALFIELD n m->PUSH...
   301                          !macro  i39 .n {                                ;SETGLOBAL n
   302                                  +caml_range caml_exn_no, .n, $7FFF, "SETGLOBAL n: n"
   303                                  .ofs = 2 * (.n - caml_exn_no)
   304                                  !set    caml_gen_SETGLB = 1
   305                                  LDA # <(caml_glob_table + .ofs)
   306                                  LDX # >(caml_glob_table + .ofs)
   307                                  JSR SETGLB
   308                          }
   309                          
   310                          ;; i3a, i3c-i3d depend on i3b
   311                          !macro  i3b .n {                                ;ATOM n
   312                                  +caml_range 0, .n, 0, "ATOM n: n"       ;only ATOM(0) allowed
   313                                  LDA # <caml_atom0
   314                                  STA ACCU
   315                                  LDA # >caml_atom0
   316                                  STA ACCU + 1
   317                          }
   318                          !macro  i3a     {+i3b 0}                        ;ATOM0 -> ATOM 0
   319                          !macro  i3c     {+i09 : +i3b 0}                 ;PUSHATOM0 -> PUSH; ATOM 0
   320                          !macro  i3d .n  {+i09 : +i3b .n}                ;PUSHATOM n -> PUSH; ATOM n
   321                          
   322                          ;; i3f-i41 depend on i3e
   323                          !macro  i3e .size, .tag {                       ;MAKEBLOCK s t
   324                                  +caml_range 1, .size, $FF, "MKBLK s t: s"
   325                                  +caml_range 0, .tag, $FF, "MKBLK s t: t"
   326                                  !set    caml_gen_MKBLK = 1
   327                                  LDX # .size
   328                                  LDA # .tag
   329                                  JSR MKBLK
   330                          }
   331                          !macro  i3f .t  {+i3e 1,.t}                     ;MAKEBLOCK1 t -> MAKEBLOCK 1 t
   332                          !macro  i40 .t  {+i3e 2,.t}                     ;MAKEBLOCK2 t -> MAKEBLOCK 2 t
   333                          !macro  i41 .t  {+i3e 3,.t}                     ;MAKEBLOCK3 t -> MAKEBLOCK 3 t
   334                          !macro  i42 .s {                                ;MAKEFLOATBLOCK s
   335                                  +caml_range 1, .s, $FF div Double_wosize, "MAKEFLOATBLOCK s: s"
   336                                  !set    caml_gen_MKFBLK = 1
   337                                  LDX # .s * Double_wosize
