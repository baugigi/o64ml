   140                          !ifdef caml_PRIM__caml_fill_string {
   141                          caml_fill_string
   142                                  ;; ACCU = string, SP[0]=ofs, SP[1]=num, SP[2]=char
   143                                  ;; for num times, string.[i]<-char starting from i=ofs; return: ()
   144                                  ;; (unsafe, args are checked in Bytes module)
   145                          
   146                                  ;; TMP + 1 <- int_val(num)
   147                                  LDY # 3
   148                                  LDA (SP),Y
   149                                  LSR
   150                                  STA TMP + 1
   151                                  DEY
   152                                  LDA (SP),Y
   153                                  ROR
   154                                  BNE +
   155                                  CMP TMP + 1
   156                                  BEQ ++                          ;num = 0, nothing to do
   157                          +       STA TMP
   158                                  ;; ACCU <- ACCU + int_val(pos)
   159                                  DEY
   160                                  LDA (SP),Y
   161                                  LSR
   162                                  TAX
   163                                  DEY
   164                                  LDA (SP),Y
   165                                  ROR
   166                                  CLC
   167                                  ADC ACCU
   168                                  STA ACCU
   169                                  TXA
   170                                  ADC ACCU + 1
   171                                  STA ACCU + 1
   172                                  ;; A <- int_val(char)
   173                                  LDY # 5
   174                                  LDA (SP),Y
   175                                  LSR
   176                                  DEY
   177                                  LDA (SP),Y
   178                                  ROR
   179                                  ;; start substitution
   180                                  LDY # 0
   181                                  LDX TMP
   182                          --      STA (ACCU),Y                            ;modify string in place
   183                                  DEX
   184                                  BEQ +
   185                          -       INY
   186                                  BNE --
   187                                  INC ACCU + 1
   188                                  JMP --
   189                          +       CPX TMP + 1
   190                                  BEQ ++
   191                                  DEC TMP + 1
   192                                  JMP -
   193                          ++      LDY # <Val_unit
   194                                  STY ACCU
   195                                  DEY
   196                                  STY ACCU + 1                            ;return ()
   197                                  RTS
   198                          }
