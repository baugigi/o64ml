   384                          !ifdef caml_PRIM__caml_string_index_y {
   385                          caml_string_index_y
   386                                  ;; given a string in ACCU, read index from SP[0], then
   387                                  ;; set Y and ACCU+1 so that ACCU+Y = &string[index];
   388                                  ;; raise Invalid_argument if not 0<=index<length(string).
   389                                  LDY # 1
   390                                  LDA (SP),Y                              ;get ARGh
   391                                  LSR                                     ;Int_val(ARGh)
   392                                  STA TMP + 1                             ;save
   393                                  DEY
   394                                  LDA (SP),Y                              ;get ARGl
   395                                  ROR                                     ;Int_val(ARGl)
   396                                  STA TMP                                 ;save
   397                                  JSR caml_string_length_yx               ;get string length in .Y.X
   398                                  CPX TMP + 1                             ;compare hi bytes
   399                                  BCC ++                                  ;.X < ARGh: error
   400                                  BNE +                                   ;.X > ARGh: ok
   401                                  CPY TMP                                 ;.X = ARGh: compare lo byte
   402                                  BCC ++                                  ;.Y < ARGl: error
   403                                  BEQ ++                                  ;.Y = ARGl: error
   404                          +       LDY TMP                                 ;reload index, lo
   405                                  LDA TMP + 1
   406                                  BEQ +
   407                                  INC ACCU + 1                            ;inc ACCUh if needed
   408                          +       RTS
   409                          ++      +caml_raise Invalid_argument, "index out of bounds"
   410                          }
   411                          
   412                          !ifdef caml_PRIM__caml_string_length_yx {
   413                          caml_string_length_yx
   414                                  ;; ACCU = string
   415                                  ;; return the string length in .Y,.X (int16, lo-hi)
   416  34e4 a52d                       LDA ACCU + 1
   417  34e6 48                         PHA                                     ;save ACCU + 1
   418  34e7 88                         DEY                                     ;LDY # -1
   419  34e8 c62d                       DEC ACCU + 1
   420  34ea b12c                       LDA (ACCU),Y                            ;.A := size
   421  34ec e62d                       INC ACCU + 1
   422  34ee a200                       LDX # 0
   423  34f0 0a                         ASL
   424  34f1 a8                         TAY                                     ;.Y := <(2 * size)
   425  34f2 9008                       BCC @minus1
   426  34f4 d003                       BNE +
   427  34f6 88                         DEY                                     ;shortcut when .Y=256
   428  34f7 d00b                       BNE @pad                                ;bne=jmp
   429  34f9 e62d               +       INC ACCU + 1
   430  34fb e8                         INX                                     ;.X := >(2 * size)
   431  34fc 88                 @minus1 DEY                                     ;.Y := <(2 * size - 1)
   432  34fd c0ff                       CPY # $FF
   433  34ff d003                       BNE @pad
   434  3501 c62d                       DEC ACCU + 1
   435  3503 ca                         DEX                                     ;.X := >(2 * size - 1)
   436  3504 b12c               @pad    LDA (ACCU),Y                            ;.A := padding byte
   437  3506 f006                       BEQ +
   438  3508 88                         DEY                                     ;.Y := <(2 * size -1 -pad)
   439  3509 c0ff                       CPY # $FF
   440  350b d001                       BNE +
   441  350d ca                         DEX                                     ;.X := >(2 * size -1 -pad)
   442  350e 68                 +       PLA
   443  350f 852d                       STA ACCU + 1                            ;restore ACCU+1
   444  3511 60                         RTS
   445                          }
