   148                          
   149                          !macro  caml_string .str {                      ;Assemble the string .str
   150                                  !text .str, 0                           ;with proper trailing byte(s)
   151                                  !if len(.str) % 2 = 0 { !byte 1 }
   152                          }
   153                          
   154                          ;; EXCEPTIONS:
   155                          ;; .Tag_Sz_*____________._____.                 standard exceptions:
   156                          ;; |248¦_2_|_string_blk_|_oid_|                 oid = -1 ... -12  = -exn_no-1
   157                          ;;          /
   158                          ;; .Tag_Sz_*_.______···_______.
   159                          ;; |252¦Sz_|_"Exception_name"_|
   160                          
   161                                  Out_of_memory   =  0 :  End_of_file     =  4 :  Stack_overflow  =  8
   162                                  Sys_error       =  1 :  Division_by_zero=  5 :  Sys_blocked_io  =  9
   163                                  Failure         =  2 :  Not_found       =  6 :  Assert_failure  = 10
   164                                  Invalid_argument=  3 :  Match_failure   =  7 :  Undef_rec_module= 11
   165                                  caml_exn_no     = 12
   166                          
   167                          !macro  caml_raise .exn {                       ;Raise a standard exception
   168                                  LDA # <caml_std_exn[.exn]
   169                                  STA ACCU
   170                                  LDA # >caml_std_exn[.exn]
   171                                  STA ACCU + 1
   172                                  JMP RAISE
   173                          }
   174                          !macro  caml_raise .exn, .str {                 ;As above, with a string arg.
   175                                  LDA # <.blk
   176                                  STA ACCU
   177                                  LDA # >.blk
   178                                  STA ACCU + 1
   179                                  JMP RAISE
   180                                  !align $01, $00
   181                                  !byte String_tag, (.h - .s) div 2
   182                          .s      +caml_string .str
   183                          .h      !byte 0, 2
   184                          .blk    !word caml_std_exn[.exn], .s
   185                          }
   186                                  ;; Statically allocate std exns and init caml_std_exn[] ptr array
   187                          !macro  caml_alloc_exn .s, .i {
   188                                  +Val_Int ~.id, -.i - 1
   189                                  !byte String_tag, (.hdr - .str) div 2   ;string block's header
   190                          .str    +caml_string .s                         ;string block's fields
   191                          .hdr    !byte Object_tag, 2                     ;exception block's header
   192                          .fld    !word .str, .id                         ;exception block's fields
   193                                  !set caml_std_exn = caml_std_exn + [.fld]
   194                          }
   195                          !set .x=["Out\xa4of\xa4memory","Sys\xa4error","Failure","Invalid\xa4argument"]
   196                          !set .x=.x+["End\xa4of\xa4file","Division\xa4by\xa4zero","Not\xa4found"]
   197                          !set .x=.x+["Match\xa4failure","Stack\xa4overflow","Sys\xa4blocked\xa4io"]
   198                          !set .x=.x+["Assert\xa4failure","Undef\xa4rec\xa4module"]
   199                          !set    caml_std_exn    = []                    ;array of pointers
   200  087d ea                 !align  $01, $00
   201                          !for .i, 0, caml_exn_no - 1 { +caml_alloc_exn .x[.i], .i }

