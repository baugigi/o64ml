   249                          !ifdef caml_PRIM__caml_classify_float {
   250                          caml_classify_float
   251                                  +Val_Int ~@FP_normal, 0
   252                                  +Val_Int ~@FP_subnormal, 1
   253                                  +Val_Int ~@FP_zero, 2
   254                                  +Val_Int ~@FP_infinite, 3
   255                                  +Val_Int ~@FP_nan, 4
