  2403                            } else { !set ACC0_OFSREF = OFSREF }
  2404                          }
  2405                          
  2406                          !set ACC1_ISINT = *
  2407                          !ifdef caml_gen_ACC1_ISINT {
  2408                            !ifdef caml_gen_ACC07 {
  2409                              !ifdef caml_gen_ISINT {
  2410                                          BCC ACC07
  2411                                          JMP ISINT
  2412                              } else { !set ACC1_ISINT = ACC07 }
  2413                            } else { !set ACC1_ISINT = ISINT }
  2414                          }
  2415                          
  2416                          !set ACC3_BEQ = *
  2417                          !ifdef caml_gen_ACC3_BEQ {
  2418                            !ifdef caml_gen_ACC07 {
  2419                              !ifdef caml_gen_BEQ {
  2420                                          BCC ACC07
  2421                                          ;; fallthrough BEQ_
  2422                              } else { !set ACC3_BEQ = ACC07 }
  2423                            } else { !set ACC3_BEQ = BEQ_ }
  2424                          }
  2425                          BEQ_
  2426                          !ifdef caml_gen_BEQ {
  2427                                          JSR caml_interp_getarg
  2428                                          CMP ACCU
  2429                                          BEQ +
  2430                                          SEC:BCS caml_interp_skip2or3by
  2431                          +               JSR caml_interp_getarg
  2432                                          CMP ACCU + 1
  2433                                          BEQ BRANCH
  2434                                          CLC:BCC caml_interp_skip2or3by
  2435                          }
  2436                          
  2437                          !set ACC4_BNEQ = *
  2438                          !ifdef caml_gen_ACC4_BNEQ {
  2439                            !ifdef caml_gen_ACC07 {
  2440                              !ifdef caml_gen_BNEQ {
  2441                                          BCC ACC07
  2442                                          ;; fallthrough BNEQ
  2443                              } else { !set ACC4_BNEQ = ACC07 }
  2444                            } else { !set ACC4_BNEQ = BNEQ }
  2445                          }
  2446                          BNEQ
