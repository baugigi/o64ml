   357  0a40 38                         SEC                                     ; the OCaml int representation
   358  0a41 2e560a                     ROL @arg
   359  0a44 2e570a                     ROL @arg + 1
   360  0a47 a954                       LDA # <@blk
   361  0a49 852c                       STA ACCU
   362  0a4b a90a                       LDA # >@blk
   363  0a4d 852d                       STA ACCU + 1                            ; ACCU := exn address
   364  0a4f 4c0b2c                     JMP RAISE                               ; raise Sys_error(error no.)
   365                                  !align $01, $00                         ;Exception block:
   366  0a52 0002                       !byte 0, 2                              ; Tag, Size
   367  0a54 a208               @blk    !word caml_std_exn[Sys_error]           ; Field0 = Sys_error exn
   368  0a56 3412               @arg    !word .dummy                            ; Field1 = Val_Int(error no.)
   369                          
   370                          ;; -----------------------------------------------------------------------------
   371                          ;;      ZEROPAGE BUFFER - ZP values are saved here at initializazion and
   372                          ;;      restored at end. If caml_INTERP=1, the buffer also contains the
   373                          ;;      fetch-exec routine to be copied into ZP by caml_init.
   374                          ;; -----------------------------------------------------------------------------
   375                          
   376                          caml_zp_buf
   377  0a58 0000000000000000...        !fill 11                                ;11 by. for ZAM2 registers
   378                          !ifdef  caml_INTERP {
   379                            !pseudopc caml_interp_fetch {
   380                                          @PC  = @fetch + 1               ;Bytecode interpreter
   381                                          @idx = @exec + 1                ;fetch-exec routine:
   382                          @fetch          LDA .dummy                      ; 3 by. SMC: fetch next opc
   383                                          INC+1 @PC                       ; 2 by. incr. LDA operand (PCl)
   384                                          BNE +                           ; 2 by.
   385                                          INC+1 @PC + 1                   ; 2 by. incr. LDA operand (PCh)
   386                          +
   387                              !ifdef caml_DEBUG {
   388                                          JSR caml_debug
   389                              } else {
   390                                          ASL                             ; 1 by. C:A = 2 * opc
   391                                          STA+1 @idx                      ; 2 by. modify JMP() operand
   392                              }
   393                          @exec           JMP (caml_interp_jmptbl)        ; 3 by. SMC: JMP(>jmptbl + A)
   394                            }                                             ;--
   395  0a63 0000000000000000...} else {!fill 15}                               ;15 by. total
   396  0a72 0000000000000000...        !fill 28                                ;28 by. for BLK, GC, TMP
   397                          
   398                          ;; -----------------------------------------------------------------------------
   399                          ;;      INTERPRETER TRACING DEBUGGER
   400                          ;;      | PC | Opcode | ACCU | SP[0] ... SP[5] | ENV | XARGS |
   401                          ;; -----------------------------------------------------------------------------
   402                          
   403                          !ifdef  caml_INTERP {
   404                          !ifdef caml_DEBUG {
   405                          caml_debug
   406                                  @RevOn  = $12
   407                                  @RevOff = $92
   408                                  @Cyan   = $9F
   409                                  @LBlue  = $9A
   410                                  @CR     = $0D
   411                                  PHP                                     ;       [S
   412                                  PHA                                     ;       [opc; S
   413                                  ;; print a header every 22 lines
   414                                  DEC @count
   415                                  BPL +
   416                                  LDA # @CR
   417                                  JSR C64_CHROUT
   418                                  LDX # @hdr - @end                       ;negative number
   419                          -       LDA @end - $100,X
   420                                  JSR C64_CHROUT
   421                                  INX
   422                                  BNE -
   423                                  LDA #21
   424                                  STA @count
   425                          +       ;; print PC
   426                                  LDA PC
   427                                  SEC
   428                                  SBC # 1
   429                                  PHA                                     ;       [PC; opc; S
   430                                  LDA PC + 1
   431                                  SBC # 0
   432                                  JSR @pr_hex
   433                                  PLA                                     ;A=PC   [opc; S
   434                                  JSR @pr_hex
   435                                  ;; print opcode
   436                                  LDA # @RevOn
   437                                  JSR C64_CHROUT
   438                                  PLA                                     ;A=opc  [S
   439                                  PHA                                     ;       [opc; S
   440                                  JSR @pr_hex
   441                                  ;; print ACCU
   442                                  LDA # @Cyan
   443                                  JSR C64_CHROUT
   444                                  LDA ACCU + 1
   445                                  JSR @pr_hex
   446                                  LDA ACCU
   447                                  JSR @pr_hex
   448                                  LDA # @RevOff
   449                                  JSR C64_CHROUT
   450                                  ;; print top 6 stack elements
   451                                  LDY # 0
   452                          -       TYA
   453                                  PHA                                     ;       [Y/4; opc; S
   454                                  LSR
   455                                  LSR
   456                                  LDA # @LBlue
   457                                  BCS +                                   ;switch Cyan/LBlue
   458                                  LDA # @Cyan
   459                          +       JSR C64_CHROUT
   460                                  PLA                                     ;A=Y/4  [opc; S
   461                                  TAY
   462                                  LDA (SP),Y
   463                                  TAX
   464                                  INY
   465                                  LDA (SP),Y
   466                                  JSR @pr_hex                             ;print STACK[i]
   467                                  TXA
   468                                  JSR @pr_hex
   469                                  INY
   470                                  CPY # 12
   471                                  BNE -
   472                                  ;; print ENV
   473                                  LDA # @RevOn
   474                                  JSR C64_CHROUT
   475                                  LDA ENV + 1
   476                                  JSR @pr_hex
   477                                  LDA ENV
   478                                  JSR @pr_hex
   479                                  ;; print XARGS
   480                                  LDA # @RevOff
   481                                  JSR C64_CHROUT
   482                                  LDA XARGS
   483                                  LSR
   484                                  JSR @pr_hex
   485                                  ;; continue fetch-exec
   486                                  PLA                                     ;A=opc  [S
   487                                  PLP                                     ;S      [
   488                                  ASL
   489                                  LDY # 0
   490                                  RTS
   491                          @count  !byte 0
   492                          @pr_hex PHA                                     ;       [A
   493                                  LSR
   494                                  LSR
   495                                  LSR
   496                                  LSR
   497                                  LDX # 2
   498                                  BNE +
   499                          -       PLA                                     ;A      [
   500                                  AND # $0F
   501                          +       CLC
   502                                  ADC # '0'
   503                                  CMP # '9' + 1
   504                                  BCC +
   505                                  ADC # 7 -1                              ;-1 as C=1
   506                          +       JSR C64_CHROUT
   507                                  DEX
   508                                  BNE -
   509                                  RTS
   510                          @hdr    !text @RevOn, "addr", @RevOff, "oc",   @Cyan,  "accu", @RevOn, "stk0"
   511                                  !text @LBlue, "   1", @Cyan,   "   2", @LBlue, "   3", @Cyan,  "   4"
   512                                  !text @LBlue, "   5", @RevOff, " env", @RevOn, "xa",   @RevOff
   513                          @end
   514                          }} ;ifdef caml_INTERP & caml_DEBUG
   515                          
   516                          caml_loader_end
   517                          } ;zone caml_LOADER
   518                          

