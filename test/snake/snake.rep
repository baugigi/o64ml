  2489                                          JSR SGNCMP
  2490                                          BMI BRANCH
  2491                                          CLC:BCC caml_interp_skip2or3by
  2492                          }
  2493                                          ;; BRANCH, START, FETCH ARG, SKIP ARG.
  2494                          
  2495                          BRANCH                                          ;Branch to *PC
  2496                                          LDA (PC),Y
  2497                                          TAX
  2498                                          INC PC
  2499                                          BNE +
  2500                                          INC PC + 1
  2501                          +               LDA (PC),Y
  2502                                          ;; fallthrough caml_interp_start
  2503                          caml_interp_start                               ;ENTRYPOINT: start interpreter
  2504                                          STX PC
  2505                                          STA PC + 1
  2506                                          JMP caml_interp_fetch
  2507                          
  2508                          caml_interp_skip2or3by                          ;Skip next 2 + Carry bytes
  2509                                          LDA # 2
  2510                                          ADC PC
  2511                                          STA PC
  2512                                          BCC +
  2513                                          INC PC + 1
  2514                          +               JMP caml_interp_fetch
  2515                          
  2516                          caml_interp_getarg                              ;Fetch a 1-byte argument
  2517                                          LDA (PC),Y
  2518                                          INC PC
  2519                                          BNE +
  2520                                          INC PC + 1
  2521                          +               RTS
  2522                          
  2523                                          ;; OPCODES JUMPTABLE.
  2524                                          ;; The table is page-aligned. The fetch-exec routine sets C=bit7
  2525                                          ;; of fetched opcode, then accesses the table using 2*opcode as
  2526                                          ;; an index.  
  2527                          
  2528                                          !align  $FF, $00
  2529                          caml_interp_jmptbl
  2530                                          ;; $00...$0f/$80...$8f  (unused opcodes: $0a, $82, $8d, $8e)
  2531                                          !wo ACC0_OFSREF, ACC1_ISINT, ACC07, ACC3_BEQ, ACC4_BNEQ
  2532                                          !wo ACC5_BLTINT, ACC6_BLEINT, ACC7_BGTINT, ACC_BGEINT
  2533                                          !wo PUSH_ULTINT, UGEINT, PHACC1_BULTINT, PHACC2_BUGEINT 
  2534                                          !wo PHACC17, PHACC17, PHACC5_STOP
  2535                                          ;; $10...$1f/$90...$94  (unused opcodes: $90...$94)
  2536                                          !wo PHACC17, PHACC17, PHACC, POPN, ASSIGNH, ENVACC14, ENVACC14
  2537                                          !wo ENVACC14, ENVACC14, ENVACCN, PHENVACC14, PHENVACC14
  2538                                          !wo PHENVACC14, PHENVACC14, PHENVACC, PHRET
  2539                                          ;; $20...$2f
