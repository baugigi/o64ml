   234                          
   235                                  ;; BASIC Floating point routines
   236                          	;; BEWARE: MULTIPLY BUG! See https://www.c64-wiki.com/wiki/Multiply_bug
   237                          
   238                                  ;; Movement
   239                          C64_MOVFM       = $BBA2 ;Load FAC from MEM (A/Y). Returns Y=0,A=exp,fl=exp.
   240                          C64_CONUPK      = $BA8C ;Load ARG from MEM (A/Y), set ARISIGN and A:=FAC exp.
   241                          C64_MOVAF       = $BC0C ;Copy (rounded) FAC to ARG.
   242                          C64_MOVMF       = $BBD4 ;Copy (rounded) FAC to MEM (X/Y). Returns A=FAC exp.
   243                          C64_MOVEF       = $BC0F ;Copy FAC to ARG without rounding. 
   244                          C64_MOVFA       = $BBFC ;Copy ARG to FAC
   245                                  ;; Basic Arithmetic
   246                          C64_FADD        = $B867 ;FAC := MEM (A/Y) + FAC 
   247                          C64_FADDT       = $B86A ;FAC := ARG + FAC
   248                          C64_FSUB        = $B850 ;FAC := MEM (A/Y) - FAC 
   249                          C64_FSUBT       = $B853 ;FAC := ARG - FAC
   250                          C64_FMUL        = $BA28 ;FAC := MEM (A/Y) * FAC 
   251                          C64_FMULT       = $BA2B ;FAC := ARG * FAC
   252                          C64_MUL10       = $BAE2 ;Quickly multiply the float held in FAC by 10.
   253                          C64_FDIV        = $BB0F ;FAC := MEM (A/Y) / FAC, ARG := remainder.
   254                          C64_FDIVT       = $BB12 ;FAC := ARG / FAC, ARG := remainder
   255                          C64_DIV10       = $BAFE ;FAC := ABS(FAC / 10).
   256                          C64_NEGOP       = $BFB4 ;Switch sign on the float in FAC, if non-zero
   257                                  ;; Trigonometry
   258                          C64_SIN         = $E26B ;Perform the SIN function on the float in FAC
   259                          C64_COS         = $E264 ;Perform the COS function on the float in FAC
   260                          C64_TAN         = $E2B4 ;Perform the TAN function on the float in FAC
   261                          C64_ATN         = $E30E ;Perform the ATN function on the float in FAC
   262                                  ;; Logarithms
   263                          C64_LOG         = $B9EA ;FAC := ln FAC
   264                          C64_EXP         = $BFED ;FAC := e ^ FAC
   265                          C64_FPWR        = $BF78 ;FAC := MEM (A/Y) ^ FAC.
   266                          C64_FPWRT       = $BF7B ;FAC := ARG ^ FAC.
   267                          C64_SQR         = $BF71 ;FAC := FAC ^ 0.5
   268                          C64_SQRARG      = $BF74 ;FAC := ARG ^ 0.5
   269                                  ;; Other functions
   270                          C64_FADDH       = $B849 ;Add .5 to FAC
   271                          C64_SIGN        = $BC2B ;Sets flags N,Z depending on whether FAC is 0, + or -.
   272                          C64_ABS         = $BC58 ;Perform the ABS function on the float in FAC
   273                          C64_INT         = $BCCC ;Perform the INT function on the float in FAC
   274                          C64_FCOMP       = $BC5B ;Compare FAC and MEM (A/Y). A = 0 (=), 1 (>), -1 (<).
   275                                  ;; Type Conversion
   276                          C64_FOUT        = $BDDD ;Convert float in FAC to a string at $100 (also in A/Y)
   277                          C64_STRVAL      = $B7B5 ;Convert a string ($22/$23, A=length) to float in FAC.  
