   203                          !ifdef caml_PRIM__caml_blit_string {
   204                          caml_blit_string
   205                                  ;; ACCU=src, SP[0]=sofs SP[1]=dst, SP[2]=dofs, SP[3]=len
   206                                  ;; copies len consecutive bytes, starting from src.[sofs], to dst.[dofs]
   207                                  ;; source and destination intervals may overlap.
   208                                  ;; (unsafe, args are checked in Bytes module)
   209                          @FROM   = TMP
   210                          @TO     = TMP + 2
   211                          @SIZE   = TMP + 4
   212  341f a007                       LDY # 7
   213  3421 b12e                       LDA (SP),Y                              ; >len
   214  3423 4a                         LSR
   215  3424 854a                       STA @SIZE + 1                           ; SIZE + 1 := >int_val(len)
   216  3426 88                         DEY
   217  3427 b12e                       LDA (SP),Y                              ; <len
   218  3429 6a                         ROR
   219  342a 8549                       STA @SIZE                               ; SIZE := <int_val(len)
   220  342c 88                         DEY
   221  342d b12e                       LDA (SP),Y                              ; >dofs
   222  342f 4a                         LSR
   223  3430 8548                       STA @TO + 1                             ; TO := >int_val(dofs)
   224  3432 88                         DEY
   225  3433 b12e                       LDA (SP),Y                              ; <dofs
   226  3435 6a                         ROR
   227  3436 8547                       STA @TO                                 ; TO := <int_val(dofs)
   228  3438 88                         DEY
   229  3439 b12e                       LDA (SP),Y                              ; >dst
   230  343b aa                         TAX
   231  343c 88                         DEY
   232  343d b12e                       LDA (SP),Y                              ; <dst
   233  343f 18                         CLC
   234  3440 6547                       ADC @TO
   235  3442 8547                       STA @TO                                 ; TO := <(dst + int_val(dofs))
   236  3444 8a                         TXA
   237  3445 6548                       ADC @TO + 1
   238  3447 8548                       STA @TO + 1                             ; TO + 1:= >(dst+int_val(dofs))
   239  3449 88                         DEY
   240  344a b12e                       LDA (SP),Y                              ; >sofs
   241  344c 4a                         LSR
   242  344d aa                         TAX
   243  344e 88                         DEY
   244  344f b12e                       LDA (SP),Y                              ; <soft
   245  3451 6a                         ROR
   246  3452 18                         CLC
   247  3453 652c                       ADC ACCU
   248  3455 8545                       STA @FROM                               ; FROM := <(src + int_val(sofs))
   249  3457 a8                         TAY
   250  3458 8a                         TXA
   251  3459 652d                       ADC ACCU + 1
   252  345b 8546                       STA @FROM + 1                           ; FROM+1 := >(src+int_val(sofs))
   253  345d 205d32                     JSR caml_memcpy                         ; ok, even if src & dest overlap
   254  3460 a001                       LDY # <Val_unit
   255  3462 842c                       STY ACCU
   256  3464 88                         DEY
   257  3465 842d                       STY ACCU + 1
   258  3467 60                         RTS
   259                          }
