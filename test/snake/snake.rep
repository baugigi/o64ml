     7                          ;; nel file LICENZA-it nella cartella principale del progetto.
     8                          ;; 
     9                          ;; This program is  free software; you can redistribute  it and/or modify
    10                          ;; it under the terms of the GNU  General Public License (GPL) ver. 2, as
    11                          ;; specified in the LICENSE-en file in the project root folder.
    12                          ;; ——————————————————————————————————————————————————————————————————————
    13                          ;;; --------------------
    14                          ;;;        RANDOM
    15                          ;;; --------------------
    16                          
    17                          ;; X ABC Algorithm Pseudo-Random Number Generator for 8-Bit Devices.
    18                          ;; Quite fast, but not good for cryptographic/security purposes.
    19                          ;; From EternityForest (1), with modifications by Stix (2).
    20                          ;; (1) https://www.electro-tech-online.com/threads/ultra-fast-pseudorandom-
    21                          ;; 					      number-generator-for-8-bit.124249/
    22                          ;; (2) https://www.stix.id.au/wiki/Fast_8-bit_pseudorandom_number_generator
    23                          ;; Links are also on archive.org
    24                          
    25                          ;; NUMBER OF CYCLES AND THEIR LENGTHS:
    26                          ;;     Length   Count   Seeds (a,b,c,x)
    27                          ;; 2826386176    1      00,00,00,00
    28                          ;;  653676288    1      10,00,00,00
    29                          ;;  630179072    1      11,00,00,00
    30                          ;;  136099072    1      2A,00,00,00
    31                          ;;   19772672    2      7B,00,00,00  41,02,00,00
    32                          ;;    3474944    2      5E,02,00,00  BC,04,00,00
    33                          ;;     647936    1      E2,34,00,00
    34                          ;;     401152    1      52,27,00,00
    35                          ;;     224512    1      3E,19,00,00
    36                          ;;     196864    1      2B,38,00,00
    37                          ;;     156160    2      70,27,00,00  03,83,01,00
    38                          ;;      90112    2      FE,3A,00,00  D1,CE,00,00
    39                          ;;      66048    2      1A,0B,01,00  EA,8D,01,00
    40                          ;;       9472    2      65,1D,06,00  53,7E,15,00
    41                          ;;       5376    2      E8,19,01,00  5D,9D,0C,00
    42                          ;;       2048    2      F0,D3,0D,00  7A,F9,54,00
    43                          ;;        512    4      4C,95,3A,00  CF,EC,55,00  97,F6,70,00  E6,26,D3,00
    44                          ;;        256    2      00,02,01,00  7A,9D,21,00
    45                          ;; ----------   --
    46                          ;; 4294967296   30
    47                          
    48                          ;; DIEHARDER RESULT: (dieharder ver. 3.31.1 (C) 2003 Robert G. Brown)
    49                          ;;         test_name   |ntup| tsamples |psamples|  p-value |Assessment
    50                          ;; -- 8< --         108 lines of PASSED TESTS snipped         -- 8< --
    51                          ;;         diehard_opso|   0|   2097152|     100|0.00000000|  FAILED  
    52                          ;;         diehard_oqso|   0|   2097152|     100|0.00000008|  FAILED  
    53                          ;;           sts_serial|   4|    100000|     100|0.99564586|   WEAK   
    54                          ;;          rgb_bitdist|   4|    100000|     100|0.99890820|   WEAK   
    55                          ;; rgb_minimum_distance|   2|     10000|    1000|0.00429146|   WEAK   
    56                          ;;         dab_monobit2|  12|  65000000|       1|1.00000000|  FAILED
    57                          
    58                          ;; Note that  all above data refer  to the original 8-bit  PRNG algorithm, whose
    59                          ;; result  is  stored  in   `caml_nonstd_random_int__a`;  for  the  purposes  of
    60                          ;; BreadCaml, the  result is a 15-bit  OCaml integer, whose least  significant 8
    61                          ;; bits are taken from `caml_nonstd_random_int__a` and the remaining 7 bits from
    62                          ;; `caml_nonstd_random_int__b (discarding the most  significant bit): this could
    63                          ;; affect the strength of the algorithm as a whole.
    64                          
    67                          !zone caml_RANDOM {
    68                          
    69                          !ifdef caml_PRIM__caml_nonstd_random_int {
    70                          caml_nonstd_random_int
    71  3316 ee1a33                     INC caml_nonstd_random_int__x
    72                          caml_nonstd_random_int__x = * + 1
    73  3319 a900                       LDA # $00                               ;SMC: LDA x
    74  331b 4d3233                     EOR caml_nonstd_random_int__c
    75                          caml_nonstd_random_int__a = * + 1
    76  331e 4900                       EOR # $00                               ;SMC: EOR a
    77  3320 8d1f33                     STA caml_nonstd_random_int__a
    78  3323 18                         CLC
    79                          caml_nonstd_random_int__b = * + 1
    80  3324 6900                       ADC # $00                               ;SMC: ADC b
    81  3326 8d2533                     STA caml_nonstd_random_int__b
    82  3329 4a                         LSR
    83  332a 9002                       BCC +                                   ;Stix's mod: LSR changed with
    84  332c 0980                       ORA # $80                               ;8-bit right rotate
    85  332e 4d1f33             +       EOR caml_nonstd_random_int__a
    86                          caml_nonstd_random_int__c = * + 1
    87  3331 6900                       ADC # $00                               ;SMC: ADC c
    88  3333 8d3233                     STA caml_nonstd_random_int__c
    89  3336 ad1f33                     LDA caml_nonstd_random_int__a		;a is the 8-bit random number
    90                                  ;; Original PRNG algo ends here.
    91  3339 38                         SEC
    92  333a 2a                         ROL                                     ;Return a 15-bit OCaml integer
    93  333b 852c                       STA ACCU                                ;from a and b, discarding
    94  333d ad2533                     LDA caml_nonstd_random_int__b		;bit #7 of b.
    95  3340 2a                         ROL
    96  3341 852d                       STA ACCU + 1
    97  3343 60                         RTS
    98                          }
    99                          
   100                          !ifdef caml_PRIM__caml_nonstd_random_self_init {
   101                          caml_nonstd_random_self_init
   102                                  ;; ARG0 is (), returned as is
   103  3344 a5a2                       LDA C64_TIME + 2                        ;Use the jiffy clock and the
   104  3346 8d1a33                     STA caml_nonstd_random_int__x		;current raster line no. to
   105  3349 4d12d0                     EOR C64_VIC_RASTER                      ;generate a "random" seed
   106  334c 8d1f33                     STA caml_nonstd_random_int__a
   107  334f 0a                 -       ASL                                     ;"random" delay
   108  3350 d0fd                       BNE -
   109  3352 ad1a33                     LDA caml_nonstd_random_int__x
   110  3355 4d12d0                     EOR C64_VIC_RASTER
   111  3358 8d2533                     STA caml_nonstd_random_int__b
   112  335b 4a                 -       LSR                                     ;"random" delay
   113  335c d0fd                       BNE -
   114  335e ad12d0                     LDA C64_VIC_RASTER
   115  3361 8d3233                     STA caml_nonstd_random_int__c
   116  3364 60                         RTS
   117                          }
   118                          
   119                          !ifdef caml_PRIM__caml_nonstd_random_set_state {
   120                          caml_nonstd_random_set_state
   121                                  ;; ARG0 is a 4-char string "xabc"
   122  3365 a003                       LDY #3
   123  3367 b12c                       LDA (ACCU),Y
   124  3369 8d3233                     STA caml_nonstd_random_int__c
   125  336c 88                         DEY
   126  336d b12c                       LDA (ACCU),Y
   127  336f 8d2533                     STA caml_nonstd_random_int__b
   128  3372 88                         DEY
   129  3373 b12c                       LDA (ACCU),Y
   130  3375 8d1f33                     STA caml_nonstd_random_int__a
   131  3378 88                         DEY
   132  3379 b12c                       LDA (ACCU),Y
   133  337b 8d1a33                     STA caml_nonstd_random_int__x
   134  337e 842d                       STY ACCU + 1
   135  3380 a901                       LDA #<Val_unit
   136  3382 852c                       STA ACCU
   137  3384 60                         RTS
   138                          }
   139                          
   140                          !ifdef caml_PRIM__caml_nonstd_random_get_state {
   141                          caml_nonstd_random_get_state
   142                                  ;; return a 4-char string "xabc"
   143  3385 a203                       LDX # 3
   144  3387 a9fc                       LDA # String_tag
   145  3389 200230                     JSR caml_alloc
   146  338c a005                       LDY # 5
   147  338e a901                       LDA # 1                                 ;OCaml string padding \001
   148  3390 9157                       STA (BLK),Y
   149  3392 88                         DEY
   150  3393 a900                       LDA # 0                                 ;OCaml string padding \000
   151  3395 9157                       STA (BLK),Y
   152  3397 88                         DEY
   153  3398 ad3233                     LDA caml_nonstd_random_int__c
   154  339b 9157                       STA (BLK),Y
   155  339d 88                         DEY
   156  339e ad2533                     LDA caml_nonstd_random_int__b
   157  33a1 9157                       STA (BLK),Y
   158  33a3 88                         DEY
   159  33a4 ad1f33                     LDA caml_nonstd_random_int__a
   160  33a7 9157                       STA (BLK),Y
   161  33a9 88                         DEY
   162  33aa ad1a33                     LDA caml_nonstd_random_int__x
   163  33ad 9157                       STA (BLK),Y
   164  33af a557                       LDA BLK
   165  33b1 852c                       STA ACCU
   166  33b3 a558                       LDA BLK + 1
   167  33b5 852d                       STA ACCU + 1
   168  33b7 60                         RTS
   169                          }
   170                          }       ;; !zone caml_RANDOM
   171                          

