    13                          ;;; ==========================================================================
    14                          ;;; MEMORY MANAGEMENT - HEAP ALLOCATION AND GARBAGE COLLECTION
    15                          ;;; ==========================================================================
    16                          
    17                          !zone caml_MEMORY {
    18                          caml_memory
    19                          
    20                          .dummy = $1234                          ;dummy operand for self-modifying
    21                                                                  ;code (SMC in comments)
    22                          
    23                                  ;; CONSTANTS
    24                          .heap_start     = caml_glob_data                ;start of heap
    25                          .heap_end       = caml_stack_start              ;end of heap + 1
    26                          .halfsz = ((.heap_end - .heap_start) div 4) * 2 ;heap half-size; ensure it's even
    27                          
    28                                  ;; VARIABLES
    29  2ff1 d435               .CUR_START      !word .heap_start               ;current half
    30  2ff3 ea68               .CUR_END        !word .heap_start + .halfsz     ;end of current half
    31  2ff5 ea68               .OTH_START      !word .heap_start + .halfsz     ;other half of the heap
    32  2ff7 009c               .OTH_END        !word .heap_start + .halfsz * 2 ;end of other half
    33                          
    35                          ;; globals - due strategie possibili:
    36                          ;; 1) considero i globals già allocati nello heap, con .heap_start =
    37                          ;;    caml_glob_data e inizializzando HEAP a caml_glob_end: in questo
    38                          ;;    modo, quando c'è una gc i globals vengono spostati da una metà
    39                          ;;    all'altra dello heap, ma la scansione dei puntatori nei blocchi
    40                          ;;    è semplice (sta già nell'algo di Cheney)
    41                          ;; 2) tengo i globals fuori dallo heap, con .heap_start = caml_glob_end:
    42                          ;;    così evito lo spostamento dei globals a ogni gc (che può essere
    43                          ;;    costosa ad es. se ci sono grandi array) ma devo considerare ogni
    44                          ;;    puntatore all'interno di ogni blocco dei globals una radice e
    45                          ;;    modificare l'algo di gc.
    46                          ;; PER ORA SI USA 1)
    47                          
    48                          caml_heap_init
    49                                  ;; Initialize the heap pointer. Called by caml_init.
    50  2ff9 a902                       LDA # <caml_glob_end                    ;globals are already allocated
    51  2ffb 8530                       STA HEAP                                ;so set HEAP after them
    52  2ffd a937                       LDA # >caml_glob_end
    53  2fff 8531                       STA HEAP + 1
    54  3001 60                         RTS
    55                          caml_alloc
    56                                  ;; Allocate a block; params: A=tag, X=size>0 (no atoms!)
    57                                  ;; Return BLK=block's address, A=X=size, Y=0; or raise Out_of_memory.
    58                          @SZ     = GC                                    ;1 by - block size
    59                          @TAG    = GC + 1                                ;1 by - block tag
    60                          @SCN    = GC + 2                                ;2 by scanned block
    61                          @PTR    = GC + 4                                ;2 by aux pointer
    62                          @CNT    = GC + 6                                ;2 by field counter
    63                                  ;; Save the parameters
    64  3002 8659                       STX @SZ
    65  3004 855a                       STA @TAG
    66                                  ;; C=0: gc not tried yet; C=1: alloc failed, GC done, retrying)
    67  3006 18                         CLC
    68  3007 08                 @retry  PHP                                     ;save GC-done flag on HW stack
    69  3008 a530                       LDA HEAP
    70  300a 8557                       STA BLK
    71  300c a531                       LDA HEAP + 1
    72  300e 8558                       STA BLK + 1
    73                                  ;; Increment HEAP by the # of bytes to be allocated
    74  3010 e8                         INX                                     ;perform HEAP:=HEAP+2*(size+1):
    75  3011 d006                       BNE +                                   ;  if size + 1 = 256
    76  3013 e631                       INC HEAP + 1                            ;  then incr. HEAPh
    77  3015 e631                       INC HEAP + 1                            ;    twice (512 bytes)
    78  3017 d00f                       BNE @limits                             ;    BNE=JMP
    79  3019 8a                 +       TXA                                     ;  else
    80  301a 0a                         ASL                                     ;    C:A := 2*(size+1),
    81  301b 9003                       BCC +                                   ;    if carry set then
    82  301d e631                       INC HEAP + 1                            ;      add it to HEAPh,
    83  301f 18                         CLC
    84  3020 6530               +       ADC HEAP                                ;    add 2*(size+1)
    85  3022 8530                       STA HEAP                                ;    to HEAPl
    86  3024 9002                       BCC @limits
    87  3026 e631                       INC HEAP + 1
    88                                  ;; If there's enough room, write tag and size into the header and exit
    89  3028 adf32f             @limits LDA .CUR_END
    90  302b c530                       CMP HEAP
    91  302d adf42f                     LDA .CUR_END + 1
    92  3030 e531                       SBC HEAP + 1                            ;.CUR_END < HEAP?
    93  3032 9015                       BCC @gctry                              ;yes: try a garbage collection
    94  3034 a55a                       LDA @TAG                                ;no: write tag and size  
    95  3036 a000                       LDY # 0
    96  3038 9157                       STA (BLK),Y                             ;  header's 1st by. := tag
    97  303a e657                       INC BLK                                 ;  (safe, BLK is even)
    98  303c a559                       LDA @SZ
    99  303e 9157                       STA (BLK),Y                             ;  header's 2nd by. := size
   100  3040 e657                       INC BLK
   101  3042 d002                       BNE +
   102  3044 e658                       INC BLK + 1                             ;  BLK=address of field(0)
   103  3046 28                 +       PLP                                     ;  pop GC-done flag
   104  3047 aa                         TAX                                     ;  RETURN A=X=size, BLK=addr,
   105  3048 60                         RTS                                     ;    C=GC-done flag.
   106                                  ;; else try a GC or, if already done, raise OOM
   107  3049 28                 @gctry  PLP                                     ;get GC-done flag from HW stack
   108  304a b008                       BCS @oom                                ;check if GC done yet:
   109  304c 205f30                     JSR .caml_garbage_collect               ;no: call the garbage collector
   110  304f a659                       LDX @SZ                                 ; X := size
   111  3051 38                         SEC                                     ; set GC-done flag
   112  3052 b0b3                       BCS @retry                              ; then try to allocate again.
   113                          @oom    +caml_raise Out_of_memory               ;

