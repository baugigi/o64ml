   279                                                  ;(CHRGOT needed before, or LDA# 1st chr and CLC.)
   280                          C64_FLOATS      = $BC44 ;Conv. 16bit signed int $62 BIG-ENDIAN to float in FAC.
   281                          C64_GIVAYF      = $B391 ;Convert 16bit signed int (Y=lo/A=hi) to float in FAC.
   282                          C64_FLOAT       = $BC3C ;Convert 8bit unsigned int in A to float in FAC.
   283                          C64_SNGFLT      = $B3A2 ;Convert 8bit unsigned int in Y to float in FAC.
   284                          C64_FACINX      = $B1AA ;Convert float in FAC to 16bit signed int (Y=lo/A=hi).
   285                          C64_QINT        = $BC9B ;Conv. float in FAC to 32bit signed int $62 BIG-ENDIAN.
   286                          C64_FADFLT      = $B8D2 ;Normalize value in FAC;(SEC(+)/CLC(-) needed before.)
