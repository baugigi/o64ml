   434                          !macro  i57 .n, .tab {                          ;SWITCH n tab
   435                                  +caml_range 0, .n, $FF, "SWITCH n t: n"
   436                            !if (0 < .n) & (.n < len(.tab)) {             ;both iptrs & pptrs present,
   437                                  LDA ACCU                                ;select the appropriate
   438                                  AND # 1                                 ;jumptable section
   439                                  BEQ .pptrs
   440                            }
   441                            !if 0 < .n {
   442                                  !set    caml_gen_SWITCHI = 1            ;iptrs: pointers are stored in
   443                                  LDA # <(.adr - 1)                       ;ACCU = offset + 1,
   444                                  LDX # >(.adr - 1)                       ;so base address = .adr - 1
   445                                  JMP SWITCHI                             ;tab[0]...tab[n-1],
   446                            }
   447                          .pptrs
   448                            !if .n < len(.tab) {
   449                                  !set    caml_gen_SWITCHP = 1            ;pptrs: pointers are stored in
   450                                  LDA # <(.adr + 2 * .n)                  ;Tag(ACCU) = offset,
   451                                  LDX # >(.adr + 2 * .n)                  ;so base address = .adr + 2 * .n
   452                                  JMP SWITCHP                             ;tab[n]...tab[len-1],
   453                            }
   454                                  !align $01, $00                         ;avoid JMP($xxFF) bug
   455                          .adr    !word .tab                              ;jumptable
   456                          }
