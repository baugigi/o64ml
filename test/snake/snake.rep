     8                          ;; 
     9                          ;; This program is  free software; you can redistribute  it and/or modify
    10                          ;; it under the terms of the GNU  General Public License (GPL) ver. 2, as
    11                          ;; specified in the LICENSE-en file in the project root folder.
    12                          ;; ——————————————————————————————————————————————————————————————————————
    13                          ;;; -----------------------------------------------------------
    14                          ;;;     AUXILIARY TOOLS
    15                          ;;; -----------------------------------------------------------
    16                          
    17                          !zone AUX_TOOLS {
    18                                  
    19                          !ifdef caml_PRIM__caml_memcpy {
    20                                  ;; copy memory
    21                                  ;; TMP, TMP + 1 =  source start address
    22                                  ;; TMP + 2, TMP + 3 = destination start address
    23                                  ;; TMP + 4, TMP + 5 = number of bytes to move
    24                                  ;; used registers: A, X, Y; return Y = 0.
    25                          caml_memcpy
    26                                  @FROM = TMP                     ;source address
    27                                  @TO = TMP + 2                   ;destination address
    28                                  @NUM = TMP + 4                  ;num bytes
    29  325d a546                       LDA @FROM + 1
    30  325f c548                       CMP @TO + 1
    31  3261 902e                       BCC @caml_memcpy_up
    32  3263 d009                       BNE @caml_memcpy_dn
    33  3265 a545                       LDA @FROM
    34  3267 c547                       CMP @TO
    35  3269 9026                       BCC @caml_memcpy_up
    36  326b d001                       BNE @caml_memcpy_dn
    37  326d 60                         RTS
    38                                  ;; copy memory from a higher address to a lower one
    39                          @caml_memcpy_dn
    40  326e a000                       LDY # 0
    41  3270 a64a                       LDX @NUM + 1
    42  3272 f00e                       BEQ +
    43  3274 b145               -       LDA (@FROM),Y                   ;move a page at a time
    44  3276 9147                       STA (@TO),Y
    45  3278 c8                         INY
    46  3279 d0f9                       BNE -
    47  327b e646                       INC @FROM + 1
    48  327d e648                       INC @TO + 1
    49  327f ca                         DEX
    50  3280 d0f2                       BNE -
    51  3282 a649               +       LDX @NUM
    52  3284 f008                       BEQ +
    53  3286 b145               -       LDA (@FROM),Y                   ;move the remaining bytes
    54  3288 9147                       STA (@TO),Y
    55  328a c8                         INY
    56  328b ca                         DEX
    57  328c d0f8                       BNE -
    58  328e a000               +       LDY # 0
    59  3290 60                         RTS
    60                                  ;; copy memory from a lower address to a higher one
    61                          @caml_memcpy_up
    62  3291 a64a                       LDX @NUM + 1                    ;the last byte must be moved first
    63  3293 18                         CLC                             ;start at the final pages of from & to
    64  3294 8a                         TXA
    65  3295 6546                       ADC @FROM + 1
    66  3297 8546                       STA @FROM + 1
    67  3299 18                         CLC
    68  329a 8a                         TXA
    69  329b 6548                       ADC @TO + 1
    70  329d 8548                       STA @TO + 1
    71  329f e8                         INX                             ;allows use of bne after dex below
    72  32a0 a449                       LDY @NUM
    73  32a2 f00e                       BEQ ++
    74  32a4 88                         DEY                             ;move bytes on the last page first
    75  32a5 f007                       BEQ +
    76  32a7 b145               -       LDA (@FROM),Y
    77  32a9 9147                       STA (@TO),Y
    78  32ab 88                         DEY
    79  32ac d0f9                       BNE -
    80  32ae b145               +       LDA (@FROM),Y                   ;handle y = 0 separately
    81  32b0 9147                       STA (@TO),Y
    82  32b2 88                 ++      DEY
    83  32b3 c646                       DEC @FROM + 1                   ;move the next page (if any)
    84  32b5 c648                       DEC @TO + 1
    85  32b7 ca                         DEX
    86  32b8 d0ed                       BNE -
    87  32ba a000                       LDY # 0
    88  32bc 60                         RTS
    89                          }
    90                          
    91                          !ifdef  caml_PRIM__caml_blkcpy {
    92                                  ;; caml_blkcpy
    93                                  ;; Aux. routine to copy all fields from ACCU to BLK; C:Y = 2 * size.
    94                                  ;; The block's header is not copied!
    95                          caml_blkcpy
    96                                  BCC +                           ; less than 256 bytes (<128 fields)
    97                                  BEQ ++                          ; exactly 256 bytes   (=128 fields)
    98                                  INC ACCU + 1                    ; more than 256 bytes (>128 fields)
    99                                  INC BLK + 1
   100                          --
   101                          +       DEY
   102                          -       LDA (ACCU),Y
   103                                  STA (BLK),Y
   104                                  DEY
   105                                  BNE -
   106                                  LDA (ACCU),Y                    ; handle Y = 0 apart
   107                                  STA (BLK),Y
   108                                  BCC +
   109                                  DEC ACCU + 1
   110                                  DEC BLK + 1
   111                          ++      CLC
   112                                  BCC --
   113                          +       RTS
   114                          }
   115                          
   116                          }       ;; !zone AUX_TOOLS
   117                          

