  2541                                          !wo APPTRM13, APPTRM13, RETURN, RESTART, GRAB, CLOSURE, CLOSREC
  2542                                          !wo OFSCLM2, OFSCL0, OFSCL2
  2543                                          ;; $30...$3f            (unused opcodes: $3b, $3d)
  2544                                          !wo OFSCLN, PHOFSCLM2, PHOFSCL0, PHOFSCL2, PHOFSCLN, GETGLB
  2545                                          !wo PHGETGLB, GETGLBFLD, PHGETGLBFLD, SETGLB, ATOM0, $ffff
  2546                                          !wo PHATOM0, $ffff, MKBLKN, MKBLK13
  2547                                          ;; $40...$4f
  2548                                          !wo MKBLK13, MKBLK13, MKFBLK, GETFLD0, GETFLD13, GETFLD13
  2549                                          !wo GETFLD13, GETFLDN, GETFFLDN, SETFLD0, SETFLD13, SETFLD13
  2550                                          !wo SETFLD13, SETFLDN, SETFFLDN, VECLEN
  2551                                          ;; $50...$5f            (unused opcode: $5c)
  2552                                          !wo GETVEC, SETVEC, GETCHR, SETCHR, BRANCH, BIF, BIFNOT, SWITCH
  2553                                          !wo BOOLNOT, PHTRP, POPTRP, RAISE, $ffff, CCALL, CCALL, CCALL
  2554                                          ;; $60...$6f
  2555                                          !wo CCALL, CCALL, CCALL, CST03, CST03, CST03, CST03, CSTN
  2556                                          !wo PHCST03, PHCST03, PHCST03, PHCST03, PHCSTN, NEGINT, ADDINT
  2557                                          !wo SUBINT
  2558                                          ;; $70...$7f
  2559                                          !wo MULINT, DIVINT, MODINT, ANDINT, ORINT, XORINT, LSLINT
  2560                                          !wo LSRINT, ASRINT, EQ, NEQ, LTINT, LEINT, GTINT, GEINT, OFSINT
  2561                          
