   141                          }
   142                          
   143                          ;; STRING blocks: length = 2 * Sz - 1 - last byte;
   144                          ;; .Tag_Sz_*___________.___________.___________.
   145                          ;; |252¦_3_|_'O'_¦_'C'_|_'a'_¦_'m'_|_'l'_¦__0__| "OCaml" length=2*3-1-0=5
   146                          ;; .Tag_Sz_*___________.___________.___________.
