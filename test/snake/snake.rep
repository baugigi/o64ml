   594                          
   595                          ;; Conversion from IEEE754 binary32 to C64FLP and vice-versa.
   596                          ;; See en.wikipedia.org/wiki/Single-precision_floating-point_format
   597                          ;; &   www.c64-wiki.com/wiki/Floating_point_arithmetic
   598                          ;;
   599                          ;; IEEE754:      |±¦e07_e01|e00¦m22_m16|m15_m08|m07_m00|
   600                          ;; little-endian |m07_m00|m15_m08|e00¦m22_m16|±¦e07_e01| Int32.t
   601                          ;; exponent representation: excess-127
   602                          ;;      exp = $01...$FE -> ± (2^(exp-127) * 1.mantissa)
   603                          ;;      exp = $FF -> special numbers: NaN, +infinity, -infinity
   604                          ;;      exp = $00, mantissa =  0 -> +0.0, -0.0
   605                          ;;      exp = $00, mantissa <> 0 ->  ± (2^(-126) * 0.mantissa)
   606                          ;; range:   ±1.17549435E-38 ... ±3.40282346E+38 (normal)
   607                          ;;          ±1.40129846E-45 ... ±1.17549421E-38 (subnormal)
   608                          ;; example: 1.0= |0¦0111111|1¦0000000|00000000|00000000|
   609                          ;; little-endian |00000000|00000000|1¦0000000|0¦0111111| Int32.t
   610                          ;;
   611                          ;; C64 (in RAM): |E07_E00|±¦M30_M24|M23_M16|M15_M08|M07_M00|
   612                          ;; C64 (in FAC): |E07_E00|1¦M30_M24|M23_M16|M15_M08|M07_M00|±///////|
   613                          ;; exponent representation: excess-128
   614                          ;;      exp = $01...$FF -> ± (2^(exp-128) * 0.1mantissa)
   615                          ;;      exp = $00 -> 0.0
   616                          ;; range:   ±2.93873588E-39 ... ±1.70141183E+38
   617                          ;; example: 1.0= |10000001|0¦0000000|00000000|00000000|00000000|  (RAM)
   618                          ;;          1.0= |10000001|1¦0000000|00000000|00000000|00000000|0|(FAC)
   619                          
   620                          !ifdef  caml_PRIM__caml_int32_bits_of_float {
   621                          caml_int32_bits_of_float
   622                                  +caml_int32_alloc
   623                                  LDA ACCU
   624                                  STA caml_float_loadFAC__addr
   625                                  LDA ACCU + 1
   626                                  STA caml_float_loadFAC__addr + 1
   627                                  JSR caml_float_loadFAC
   628                                  LDY # 5                         ; (BLK),Y points to int32 last byte
   629                                  LDX C64_FAC                     ; load c64 exponent
   630                                  BEQ @exp0                       ; switch
   631                                  DEX
   632                                  BEQ @exp1
   633                                  DEX
   634                                  BEQ @exp2
   635                                  ;; c64 exponent > 2:
   636                                  ;; ieee_exp = c64_exp - 2, ieee_mant = asl c64_mant (drop leftmost 1)
   637                                  ;; normal representation - rounding may increment exponent by one
   638                                  CLC                             ;flag: .C=1 if called from @exp2
   639                          @round  BIT C64_FAC + 4                 ;round mantissa
   640                                  BPL +
   641                                  INC C64_FAC + 3
   642                                  BNE +
   643                                  INC C64_FAC + 2
   644                                  BNE +
   645                                  INC C64_FAC + 1
   646                                  BNE +
   647                                  INX                             ;increment exponent if needed
   648                          +       BCS @exp2r                      ;return if called from @exp2
   649                                  ASL C64_FAC + 1                 ;remove leftmost 1 from mantissa
   650                                  ASL C64_FAC + 5                 ;.C := sign bit
   651                                  TXA                             ;.A := exponent |e07_e00|
   652                                  ROR                             ;.A := |±¦e07_e01|, .C := e00
   653                                  STA (BLK),Y                     ;store |±¦e07_e01|
   654                                  LDA C64_FAC + 1                 ;.A := |m22_m16¦0|
   655                                  ROR                             ;.A := |e00¦m22_m16|
   656                                  DEY
   657                                  STA (BLK),Y                     ;store |e00¦m22_m16|
   658                                  LDA C64_FAC + 2                 ;.A := |m15_m08|
   659                                  DEY
   660                                  STA (BLK),Y                     ;store |m15_m08|
   661                                  LDA C64_FAC + 3                 ;.A := |m07_m00|
   662                          @end    DEY
   663                                  STA (BLK),Y                     ;store |m07_m00|
   664                                  LDY # 0
   665                                  LDA BLK
   666                                  STA ACCU
   667                                  LDA BLK + 1
   668                                  STA ACCU + 1
   669                                  ;ACCU := int32
   670                                  RTS                             ;return
   671                                  ;; c64_exp = 0: ieee_exp = 0, ieee_mant = 0
   672                          @exp0   TXA                             ;.A := 0
   673                                  STA (BLK),Y                     ;store zero into all bytes
   674                                  DEY
   675                                  STA (BLK),Y
   676                                  DEY
   677                                  STA (BLK),Y
   678                                  JMP @end                        ;...continue
   679                                  ;; c64_exp = 1: ieee_exp = 0, ieee_mant = lsr c64_mant (subnormal)
   680                                  ;; rounding doesn't affect exponent, as mantissa is 0.0mmm...
   681                          @exp1   LSR C64_FAC + 1                 ;lsr mantissa
   682                                  ROR C64_FAC + 2
   683                                  ROR C64_FAC + 3
   684                                  ROR C64_FAC + 4                 ;fallthrough @exp2
   685                                  ;; c64_exp = 2: ieee_exp = 0, ieee_mant = c64_mant (subnormal)
   686                                  ;; rounding may incr. exponent and cause a switch from
   687                                  ;; subnormal repr. (2^(-126) * 0.mantissa, 0 implicit)
   688                                  ;; to normal one (2^(-126) * 1.rnd_mantissa, 1 implicit)
   689                          @exp2   SEC                             ;use .C as a return flag
   690                                  BCS @round                      ;round mantissa
   691                          @exp2r  TXA                             ;.A := exponent |e07_e00|
   692                                  ASL C64_FAC + 5                 ;.C := sign bit
   693                                  ROR                             ;.A := |±¦e07_e01|, .C := e00
   694                                  STA (BLK),Y                     ;store |±¦e07_e01|
   695                                  LDA C64_FAC + 1
   696                                  ROR
   697                                  DEY
   698                                  STA (BLK),Y                     ;store |e00¦m22_m16|
   699                                  LDA C64_FAC + 2
   700                                  ROR
   701                                  DEY
   702                                  STA (BLK),Y                     ;store |m15_m08|
   703                                  LDA C64_FAC + 3
   704                                  ROR
   705                                  JMP @end                        ;...continue
   706                          }
   707                          
   708                          !ifdef  caml_PRIM__caml_int32_float_of_bits {
   709                          caml_int32_float_of_bits
   710                                  LDY # 4
   711                                  LDA (ACCU),Y                    ;.A <- e00¦m22_m16
   712                                  CMP # $80                       ;.C <- e00
   713                                  ORA # $80                       ;.A <- 1¦m22_m16
   714                                  STA C64_FAC + 1                 ;store into FAC
   715                                  INY
   716                                  LDA (ACCU),Y                    ;.A <- sign¦e07_e01
   717                                  ROL                             ;.C <- sign, .A <- e07_e00
   718                                  ROR C64_FAC + 5                 ;put sign into FAC sign byte
   719                                  CMP # $FE                       ;raise exn if NaN, +-infinity, or
   720                                  BCS @exn                        ;if conversion would overflow
   721                                  TAX                             ;.X <- exp
   722                                  LDY # 3
   723                                  LDA (ACCU),Y                    ;.A <- m15_m08
   724                                  STA C64_FAC + 2                 ;store into FAC
   725                                  DEY
   726                                  LDA (ACCU),Y                    ;.A <- m07_m00
   727                                  STA C64_FAC + 3                 ;store into FAC
   728                                  LDY # 0
   729                                  STY C64_FAC + 4                 ;clear FAC unused mantissa bits
   730                                  STY C64_FACRND                  ;and FAC round byte
   731                                  CPX # 1
   732                                  BCC @zero                       ;jump if +0.0, -0.0 or subnormal
   733                                  INX
   734                                  INX                             ;adjust exp bias
   735                          -       STX C64_FAC                     ;set FAC exp
   736                                  JMP caml_float_alloc_result     ;allocate float and return
   737                          @zero   LDA C64_FAC + 3                 ;check if +0.0 or -0.0
   738                                  BNE @subnrm                     ;jump if subnormal
   739                                  LDA C64_FAC + 2
   740                                  BNE @subnrm                     ;jump if subnormal
   741                                  LDA C64_FAC + 1
   742                                  AND # $7F                       ;ignore leftmost bit of mantissa (1)
   743                                  BNE @subnrm                     ;jump if subnormal
   744                                  STA C64_FAC + 1
   745                                  STA C64_FAC + 5                 ;clear minus sign, if any
   746                                  BEQ -                           ;set FAC exp, allocate float and return
   747                          @subnrm LDX # 2                         ;subnormal: set biased exp = -126
   748                                  STX C64_FAC
   749                          -       ASL C64_FAC + 3                 ;try to normalize (FAC+4 ignored as null)
   750                                  ROL C64_FAC + 2
   751                                  ROL C64_FAC + 1
   752                                  BMI +                           ;ok, leftmost bit is 1
   753                                  DEC C64_FAC
   754                                  BNE -
   755                                  LDY # 0                         ;ko, result is zero
   756                                  STY C64_FAC + 5                 ;clear minus sign, if any
   757                          +       JMP caml_float_alloc_result     ;allocate float and return
   758                          @exn    +caml_raise Invalid_argument, "Int32.float_of_bits"
   759                          }
