   630                          !ifdef caml_PRIM__caml_array_blit {
   631                          caml_array_blit
   632                                  ;; copy a subarray to other one (source and dest may overlap)
   633                                  ;; ACCU = arr1
   634                                  ;; SP[0] = ofs1
   635                                  ;; SP[1] = arr2
   636                                  ;; SP[2] = ofs2
   637                                  ;; SP[3] = n
   638                          @NBY    = TMP + 2
   639                                  ;; load tag
   640                                  LDY # -2
   641                                  DEC ACCU + 1
   642                                  LDA (ACCU),Y
   643                                  INC ACCU + 1
   644                                  ;; check if float
   645                                  CMP # Double_array_tag
   646                                  BNE @no_float
   647                                  ;; array of floats, compute source start address
   648                                  LDY # 0
   649                                  STY @NBY + 1
   650                                  LDA (SP),Y                      ; ofs1, ignore hi byte
   651                                  AND # $FE
   652                                  STA TMP
   653                                  LSR
   654                                  CLC
   655                                  ADC TMP
   656                                  ;; ACCU <- &arr1[ofs1]
   657                                  ASL                             ; A = 6 * ofs1
   658                                  BCC +
   659                                  INC ACCU + 1
   660                                  CLC
   661                          +       ADC ACCU
   662                                  STA ACCU
   663                                  BCC +
   664                                  INC ACCU + 1
   665                                  ;; compute destination start address
   666                          +       LDY # 4
   667                                  LDA (SP),Y                      ; ofs2, ignore hi byte
   668                                  ;; calc 3 * index
   669                                  AND # $FE
   670                                  STA TMP
   671                                  LSR
   672                                  CLC
   673                                  ADC TMP
   674                                  ;; TMP <- &arr2[ofs2]
   675                                  TAX                             ; X = 3 * ofs2
   676                                  DEY
   677                                  LDA (SP),Y
   678                                  STA TMP + 1
   679                                  TXA
   680                                  ASL                             ; A = 6 * ofs2
   681                                  BCC +
   682                                  INC TMP + 1
   683                                  CLC
   684                          +       DEY
   685                                  ADC (SP),Y
   686                                  STA TMP
   687                                  BCC +
   688                                  INC TMP + 1
   689                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   690                          +       LDY # 6
   691                                  LDA (SP),Y                      ; ignore hi byte
   692                                  AND # $FE
   693                                  STA @NBY
   694                                  LSR
   695                                  CLC
   696                                  ADC @NBY
   697                                  STA @NBY
   698                                  BCC +
   699                                  INC @NBY + 1
   700                          +       JMP @copy
   701                          @no_float
   702                                  ;; ordinary array, compute source start address
   703                                  LDY # 0
   704                                  CLC
   705                                  LDA (SP),Y
   706                                  ADC ACCU
   707                                  STA ACCU
   708                                  INY
   709                                  LDA (SP),Y
   710                                  ADC ACCU + 1
   711                                  STA ACCU + 1
   712                                  LDA ACCU
   713                                  BNE +
   714                                  DEC ACCU + 1
   715                          +       DEC ACCU
   716                                  ;; compute destination start address
   717                                  INY
   718                                  LDA (SP),Y
   719                                  STA TMP
   720                                  INY
   721                                  LDA (SP),Y
   722                                  STA TMP + 1
   723                                  INY
   724                                  CLC
   725                                  LDA TMP
   726                                  ADC (SP),Y
   727                                  STA TMP
   728                                  INY
   729                                  LDA TMP + 1
   730                                  ADC (SP),Y
   731                                  STA TMP + 1
   732                                  LDA TMP
   733                                  BNE +
   734                                  DEC TMP + 1
   735                          +       DEC TMP
   736                                  ;; compute no. of bytes to be copied
   737                                  INY
   738                                  LDA @NBY
   739                                  ADC (SP),Y
   740                                  STA @NBY
   741                                  INY
   742                                  LDA @NBY + 1
   743                                  ADC (SP),Y
   744                                  STA @NBY + 1
   745                                  LDA @NBY
   746                                  BNE +
   747                                  DEC @NBY + 1
   748                          +       DEC @NBY
   749                                  ;; copy bytes from source to destination
   750                          @copy   LDA ACCU
   751                                  CMP TMP
   752                                  LDA ACCU + 1
   753                                  SBC TMP + 1
   754                                  BCS @cpydn
   755                                  ;; ACCU < TMP, copy memory up (arr1[0] last)
   756                                  LSR @NBY + 1
   757                                  LDY @NBY
   758                                  JSR caml_blkcpy
   759                                  ;; ACCU <- ()
   760                          @done   STY ACCU + 1                    ; Y = 0
   761                                  LDA # <Val_unit
   762                                  STA ACCU
   763                                  RTS
   764                                  ;; ACCU >= TMP, copy memory down (arr1[0] first)
   765                          @cpydn  LDX @NBY + 1                    ; 0 or 1
   766                                  BEQ +
   767                                  LDY # 0
   768                          -       LDA (ACCU),Y                    ; >255 bytes: copy a whole page
   769                                  STA (TMP),Y
   770                                  INY
   771                                  BNE -
   772                                  INC ACCU + 1
   773                                  INC TMP + 1
   774                          +       LDX @NBY
   775                                  BEQ +
   776                          -       LDA (ACCU),Y                    ; copy the remaining bytes
   777                                  STA (TMP),Y
   778                                  INY
   779                                  DEX
   780                                  BNE -
   781                          +       LDY # 0
   782                                  JMP @done
   783                          }
   784                          
   785                          !ifdef caml_PRIM__caml_array_sub {
   786                          caml_array_sub
   787                                  ;; allocate and return a subarray
   788                                  ;; ACCU = a
   789                                  ;; SP[0] = ofs
   790                                  ;; SP[1] = n
   791                          @NBY    = TMP
   792                                  ;; load tag
   793                                  LDY # -2
   794                                  DEC ACCU + 1
   795                                  LDA (ACCU),Y
   796                                  INC ACCU + 1
   797                                  ;; check if float
   798                                  CMP # Double_array_tag
   799                                  BNE @no_floats
   800                                  ;; array of floats, compute source start address
   801                                  LDY # 0                         ; ignore hi byte
   802                                  STY @NBY + 1
   803                                  LDA (SP),Y
   804                                  AND # $FE
   805                                  STA TMP
   806                                  LSR
   807                                  CLC
   808                                  ADC TMP
   809                                  ;; ACCU <- &arr1[ofs1]
   810                                  ASL                             ; A = 6 * ofs1
   811                                  BCC +
   812                                  INC ACCU + 1
   813                                  CLC
   814                          +       ADC ACCU
   815                                  STA ACCU
   816                                  BCC +
   817                                  INC ACCU + 1
   818                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   819                          +       LDY # 2
   820                                  LDA (SP),Y                      ; ignore hi byte
   821                                  AND # $FE
   822                                  STA @NBY
   823                                  LSR
   824                                  CLC
   825                                  ADC @NBY
   826                                  STA @NBY
   827                                  BCC +
   828                                  INC @NBY + 1
   829                                  ;; allocate subarray
   830                          +       LDA @NBY + 1
   831                                  LSR
   832                                  LDA @NBY
   833                                  ROR
   834                                  TAX
   835                                  LDA # Double_array_tag
   836                                  JSR caml_alloc
   837                                  JMP @copy
   838                          @no_floats
   839                                  ;; ordinary array, compute source start address
   840                                  LDY # 0
   841                                  CLC
   842                                  LDA ACCU
   843                                  ADC (SP),Y
   844                                  STA ACCU
   845                                  INY
   846                                  LDA ACCU + 1
   847                                  ADC (SP),Y
   848                                  STA ACCU + 1
   849                                  LDA ACCU
   850                                  BNE +
   851                                  DEC ACCU + 1
   852                          +       DEC ACCU
   853                                  ;; compute no. of bytes to be copied
   854                                  INY
   855                                  LDA (SP),Y
   856                                  STA @NBY
   857                                  INY
   858                                  LDA (SP),Y
   859                                  STA @NBY + 1
   860                                  LDA @NBY
   861                                  BNE +
   862                                  DEC @NBY + 1
   863                          +       DEC @NBY
   864                                  ;; allocate subarray
   865                                  LDA @NBY + 1
   866                                  LSR
   867                                  LDA @NBY
   868                                  ROR
   869                                  TAX
   870                                  LDA # 0
   871                                  JSR caml_alloc
   872                                  ;; copy bytes from source to destination
   873                          @copy   LSR @NBY + 1
   874                                  LDY @NBY
   875                                  JSR caml_blkcpy
   876                                  ;; ACCU <- subarray
   877                          @done   LDA BLK
   878                                  STA ACCU
   879                                  LDA BLK + 1
   880                                  STA ACCU + 1
   881                                  RTS
   882                          }
   883                          
   884                          !ifdef caml_PRIM__caml_array_append {
   885                          caml_array_append
   886                                  ;; append two arrays
   887                                  ;; ACCU = arr1
   888                                  ;; SP[0] = arr2
   889                          @AUX    = TMP
   890                          @SIZE1  = TMP + 2
   891                          @SIZE2  = TMP + 4
   892                                  ;; load sizes
   893                                  LDA (SP),Y
   894                                  STA @AUX
   895                                  INY
   896                                  LDA (SP),Y
   897                                  STA @AUX + 1
   898                                  LDY # -1
   899                                  DEC ACCU + 1
   900                                  DEC @AUX + 1
   901                                  LDA (ACCU),Y
   902                                  STA @SIZE1
   903                                  LDA (@AUX),Y
   904                                  STA @SIZE2
   905                                  CLC
   906                                  ADC @SIZE1
   907                                  BCC +
   908                                  ;; exception if total size > 255
   909                                  INY                             ; Y = 0
   910                                  JMP @error
   911                                  ;; load tag and allocate
   912                          +       DEY
   913                                  TAX                             ; size
   914                                  LDA (ACCU),Y                    ; tag
   915                                  JSR caml_alloc
   916                                  ;; copy arr1 to dest
   917                                  INC ACCU + 1
   918                                  LDA @SIZE1
   919                                  ASL
   920                                  TAY
   921                                  JSR caml_blkcpy
   922                                  ;; ACCU <- arr2
   923                                  LDA @AUX
   924                                  STA ACCU
   925                                  LDA @AUX + 1
   926                                  STA ACCU + 1
   927                                  ;; save ptr to result
   928                                  LDA BLK
   929                                  STA @AUX
   930                                  LDA BLK + 1
   931                                  STA @AUX + 1
   932                                  ;; TMP <- &TMP[SIZE1]
   933                          +       LDA @SIZE1
   934                                  ASL
   935                                  BCC +
   936                                  INC BLK + 1
   937                                  CLC
   938                          +       ADC BLK
   939                                  STA BLK
   940                                  BCC +
   941                                  INC BLK + 1
   942                                  ;; copy arr2 to dest
   943                          +       LDA @SIZE2
   944                                  ASL
   945                                  TAY
   946                                  JSR caml_blkcpy
   947                                  ;; ACCU <- AUX
   948                                  LDA @AUX
   949                                  STA ACCU
   950                                  LDA @AUX + 1
   951                                  STA ACCU + 1
   952                                  RTS
   953                          @error  +caml_raise Invalid_argument, "Array.append"
   954                          }
   955                          
   956                          !ifdef caml_PRIM__caml_array_concat {
   957                          caml_array_concat
   958                                  ;; concatenate all arrays in a list
   959                                  ;; ACCU = list
   960                          @TAG    = TMP
   961                          @SIZE   = TMP + 1
   962                          @HEAD   = TMP + 2
   963                          @TAIL   = TMP + 4
   964                          @RESULT = TMP + 2
   965                                  DEY
   966                                  STY @TAG                        ; @TAG = -1
   967                                  INY
   968                                  STY @SIZE
   969                                  ;; return caml_atom0 if list = []
   970                                  LDA ACCU
   971                                  BIT caml_is_block
   972                                  BNE @atom0
   973                                  ;; scan list and sum all arrays sizes
   974                                  LDA (ACCU),Y
   975                                  STA @HEAD
   976                                  INY
   977                                  LDA (ACCU),Y
   978                                  STA @HEAD + 1
   979                                  INY
   980                                  LDA (ACCU),Y
   981                                  STA @TAIL
   982                                  INY
   983                                  LDA (ACCU),Y
   984                                  STA @TAIL + 1
   985                                  ;; get current array size and add it to @SIZE
   986                          -       LDY # -1
   987                                  DEC @HEAD + 1
   988                                  LDA (@HEAD),Y
   989                                  BEQ +
   990                                  CLC
   991                                  ADC @SIZE
   992                                  BCS @error                      ; raise exn if > 255
   993                                  STA @SIZE
   994                                  ;; only once: set @TAG from first non-empty array
   995                                  CPY @TAG                        ; test if @TAG = -1
   996                                  BNE +
   997                                  DEY
   998                                  LDA (@HEAD),Y
   999                                  STA @TAG
  1000                                  INY
  1001                                  ;; set @HEAD to next list element, @TAIL to rest
  1002                          +       INY
  1003                                  LDA @TAIL
  1004                                  BIT caml_is_block                       ; end of list?
  1005                                  BEQ @alloc                      ; yes:  exit loop
  1006                                  LDA (@TAIL),Y                   ; no:   continue
  1007                                  STA @HEAD
  1008                                  INY
  1009                                  LDA (@TAIL),Y
  1010                                  STA @HEAD + 1
  1011                                  INY
  1012                                  LDA (@TAIL),Y
  1013                                  TAX
  1014                                  INY
  1015                                  LDA (@TAIL),Y
  1016                                  STX @TAIL
  1017                                  STA @TAIL + 1
  1018                                  JMP -
  1019                                  ;; allocate destination array
  1020                          @alloc  LDX @SIZE
  1021                                  BEQ @atom0
  1022                                  LDA @TAG
  1023                                  JSR caml_alloc
  1024                                  LDA BLK
  1025                                  STA @RESULT
  1026                                  LDA BLK + 1
  1027                                  STA @RESULT + 1                 ; save dest address
  1028                                  ;; scan list again and append all arrays
  1029                                  LDY # 3
  1030                                  LDA (ACCU),Y
  1031                                  STA @TAIL + 1
  1032                                  DEY
  1033                                  LDA (ACCU),Y
  1034                                  STA @TAIL
  1035                                  DEY
  1036                                  LDA (ACCU),Y
  1037                                  TAX
  1038                                  DEY
  1039                                  LDA (ACCU),Y
  1040                                  STX ACCU + 1
  1041                                  STA ACCU
  1042                                  ;; get current array size
  1043                          -       LDY # -1
  1044                                  DEC ACCU + 1
  1045                                  LDA (ACCU),Y
  1046                                  BEQ ++                          ; skip if zero
  1047                                  INC ACCU + 1
  1048                                  TAX
  1049                                  ASL
  1050                                  TAY
  1051                                  ;; copy array elements to destination
  1052                                  JSR caml_blkcpy
  1053                                  TXA
  1054                                  ;; set BLK pointer to first element to be copied next
  1055                                  ASL
  1056                                  BCC +
  1057                                  CLC
  1058                                  INC BLK + 1
  1059                          +       ADC BLK
  1060                                  STA BLK
  1061                                  BCC ++
  1062                                  INC BLK + 1
  1063                                  ;; set ACCU to next list element, @TAIL to rest
  1064                          ++      LDY # 0
  1065                                  LDA @TAIL
  1066                                  BIT caml_is_block               ; end of list?
  1067                                  BEQ @eol                        ; yes:  exit
  1068                                  LDA (@TAIL),Y                   ; no:   continue
  1069                                  STA ACCU
  1070                                  INY
  1071                                  LDA (@TAIL),Y
  1072                                  STA ACCU + 1
  1073                                  INY
  1074                                  LDA (@TAIL),Y
  1075                                  TAX
  1076                                  INY
  1077                                  LDA (@TAIL),Y
  1078                                  STX @TAIL
  1079                                  STA @TAIL + 1
  1080                                  JMP -                           ; loop
  1081                                  ;; set ACCU = destination array and return
  1082                          @eol    LDA @RESULT
  1083                                  STA ACCU
  1084                                  LDA @RESULT + 1
  1085                                  STA ACCU + 1
  1086                                  RTS
  1087                          @atom0  LDA # < caml_atom0
  1088                                  STA ACCU
  1089                                  LDA # > caml_atom0
  1090                                  STA ACCU + 1
  1091                                  RTS
  1092                          @error  +caml_raise Invalid_argument, "Array.concat"
  1093                          }
  1094                          
  1095                          }      ;; !zone caml_ARRAYS
  1096                          

