    17                          !zone caml_IO {
    18                          
    19                          !ifdef caml_PRIM__caml_nonstd_print_char {
    20                          caml_nonstd_print_char
    21  32bd 462d                       LSR ACCU + 1
    22  32bf a52c                       LDA ACCU
    23  32c1 6a                         ROR
    24  32c2 842d                       STY ACCU + 1
    25  32c4 a201                       LDX # <Val_unit
    26  32c6 862c                       STX ACCU
    27  32c8 4ccaf1                     JMP C64_CHROUT                          ;JMP = JSR+RTS
    28                          }
    29                          
    30                          !ifdef caml_PRIM__caml_nonstd_read_line {
    31                          caml_nonstd_read_line
    32                                  ;; Stdlib.read_line
    33                          @CNT    = TMP                                   ;string length
    34                          @PTR    = TMP + 2                               ;buffer pointer
    35                                  LDA # String_tag
    36                                  LDX # $FF
    37                                  JSR caml_alloc                          ;allocate buffer, addr in BLK
    38                                  LDA BLK
    39                                  STA @PTR
    40                                  LDA BLK + 1
    41                                  STA @PTR + 1                            ;init buffer pointer
    42                                  STY @CNT                                ;reset char counter
    43                                  STY @CNT + 1
    44                                  STY C64_BLNSW                           ;enable cursor blink
    45                          -       JSR C64_GETIN                           ;A:=char from keyboard; X,Y:=?
    46                                  BEQ -                                   ;no char entered
    47                                  TAX                                     ;save char in X
    48                                  CMP # $14
    49                                  BEQ @delete                             ;DELETE
    50                                  CMP # $0D
    51                                  BEQ @return                             ;RETURN
    52                                  AND # %01111111
    53                                  CMP # $20
    54                                  BCC -                                   ;NON-PRINTABLE
    55                                  LDA @CNT + 1                            ;check counter
    56                                  BEQ +                                   ;ok, cnt < 256
    57                                  LDA @CNT
    58                                  CMP # <509
    59                                  BEQ -                                   ;cnt=509, only DEL/CR admitted:
    60                          +       TXA                                     ;reload char in A
    61                                  LDY # $00                               ;(Y used by C64_GETIN)
    62                                  STA (@PTR),Y                            ;put char into the buffer
    63                                  INC @PTR                                ;increment the buffer pointer
    64                                  BNE +
    65                                  INC @PTR + 1
    66                          +       INC @CNT                                ;increment the counter
    67                                  BNE +
    68                                  INC @CNT + 1
    69                          +       JSR C64_CHROUT                          ;print char
    70                                  JMP -                                   ;process next char
    71                          @delete LDA @CNT                                ;if counter_lo = 0
    72                                  BNE +
    73                                  ORA @CNT + 1                            ;then if counter_hi = 0
    74                                  BEQ -                                   ;    then nothing to del, jmp -
    75                                  DEC @CNT + 1                            ;    else decr counter_hi;
    76                          +       DEC @CNT                                ;decr counter_lo
    77                                  LDA @PTR                                ;if pointer_lo = 0
    78                                  BNE +
    79                                  DEC @PTR + 1                            ;then decr pointer_hi
    80                          +       DEC @PTR                                ;decr pointer_lo
    81                                  TXA                                     ;reload char in A
    82                                  JSR C64_CHROUT                          ;print char
    83                                  JMP -                                   ;process next char
    84                          @return DEC C64_BLNSW                           ;disable cursor blink
    85                                  JSR C64_CHROUT                          ;print newline
    86                                  LSR @CNT + 1
    87                                  ROR @CNT                                ;counter := counter / 2
    88                                  LDY # 0
    89                                  TYA                                     ;add string padding:
    90                                  STA (@PTR),Y                            ;1st padding byte = 0
    91                                  BCS +                                   ;is counter even?
    92                                  INY
    93                                  TYA
    94                                  STA (@PTR),Y                            ;yes: 2nd padding byte = 1
    95                                  DEY                                     ;Y := 0
    96                          +       LDX @CNT
    97                                  INX                                     ;X := # words of padded string
    98                                  JSR caml_shrink_latest_alloc            ;shrink allocated block
    99                                  LDA BLK
   100                                  STA ACCU
   101                                  LDA BLK + 1
   102                                  STA ACCU + 1                            ;return string in ACCU
   103                                  RTS
   104                          }
   105                          
   106                          !ifdef caml_PRIM__caml_nonstd_print_string {
   107                          caml_nonstd_print_string
   108                                  ;; Stdlib.print_string
   109  32cb a0ff                       LDY # -1
   110  32cd c62d                       DEC ACCU + 1
   111  32cf b12c                       LDA (ACCU),Y                            ;get block size
   112  32d1 e62d                       INC ACCU + 1
   113  32d3 c8                         INY
   114  32d4 aa                         TAX                                     ;X := size
   115  32d5 ca                 -       DEX                                     ;X := X - 1
   116  32d6 f012                       BEQ +                                   ;Exit loop when X=0
   117  32d8 b12c                       LDA (ACCU),Y                            ;Loop: print 2 chars a time
   118  32da 20caf1                     JSR C64_CHROUT                          ; first char
   119  32dd c8                         INY
   120  32de b12c                       LDA (ACCU),Y
   121  32e0 20caf1                     JSR C64_CHROUT                          ; second one
   122  32e3 c8                         INY
   123  32e4 d0ef                       BNE -                                   ;Continue loop
   124  32e6 e62d                       INC ACCU + 1
   125  32e8 d0eb                       BNE -                                   ;BNE=JMP, continue loop
   126  32ea c8                 +       INY
   127  32eb b12c                       LDA (ACCU),Y                            ;Load last byte
   128  32ed d006                       BNE +                                   ;If last byte = 0
   129  32ef 88                         DEY
   130  32f0 b12c                       LDA (ACCU),Y                            ;then load previous one
   131  32f2 20caf1                     JSR C64_CHROUT                          ; and print it.
   132  32f5 a901               +       LDA # Val_unit
   133  32f7 852c                       STA ACCU
   134  32f9 a000                       LDY # 0
   135  32fb 842d                       STY ACCU + 1                            ;ACCU := Val_unit
   136  32fd 60                         RTS
   137                          }
   138                          
   139                          }       ;; !zone caml_IO
