    13                          ;;; -----------------------------------------------------------
    14                          :;; ALLOC DUMMY (ocaml-4.04.1/byterun/alloc.c)
    15                          ;;; -----------------------------------------------------------
    16                          
    17                          !zone caml_DUMMY {
    18                          
    19                          !ifdef caml_PRIM__caml_alloc_dummy_function {
    20                          caml_alloc_dummy_function = caml_alloc_dummy
    21                          }
    22                          !ifdef caml_PRIM__caml_alloc_dummy {
    23                                  ;; allocate a dummy block for a recursive value (or function)
    24                                  ;; ACCU = size, (SP[0] = function arity, ignored)
    25                          caml_alloc_dummy
    26                                  LSR ACCU + 1
    27                                  LDA ACCU
    28                                  ROR
    29                                  BEQ +                           ; size = 0
    30                                  ;; allocate block
    31                                  TAX
    32                                  TYA
    33                                  JSR caml_alloc
    34                                  LDA BLK
    35                                  STA ACCU
    36                                  LDA BLK + 1
    37                                  STA ACCU + 1
    38                                  RTS
    39                                  ;; Atom(0)
    40                          +       LDA # < caml_atom0
    41                                  STA ACCU
    42                                  LDA # > caml_atom0
    43                                  STA ACCU + 1
    44                                  RTS
    45                          }
    46                          
    47                          !ifdef caml_PRIM__caml_alloc_dummy_float {
    48                                  ;; allocate a dummy block for a recursive array/record of floats
    49                                  ;; ACCU = no. of floats
    50                          caml_alloc_dummy_float
    51                                  ;; ignore ACCU + 1, as 0 <= no. of floats <= 85
    52                                  LDA ACCU
    53                                  LSR
    54                                  BEQ +                           ; Atom(0)
    55                                  ;; X <- no. of floats * Double_wosize
    56                                  CLC
    57                                  ADC ACCU
    58                                  TAX
    59                                  DEX
    60                                  ;; allocate block
    61                                  TYA                             ; A = Y = 0
    62                                  JSR caml_alloc
    63                                  LDA BLK
    64                                  STA ACCU
    65                                  LDA BLK + 1
    66                                  STA ACCU + 1
    67                                  RTS
    68                                  ;; Atom(0)
    69                          +       LDA # < caml_atom0
    70                                  STA ACCU
    71                                  LDA # > caml_atom0
    72                                  STA ACCU + 1
    73                                  RTS
    74                          }
    75                          
    76                          !ifdef caml_PRIM__caml_update_dummy {
    77                                  ;; update a dummy block with given value
    78                                  ;; ACCU = dummy, SP[0] = newval
    79                          caml_update_dummy
    80                                  ;; load newval size
    81                                  LDA (SP),Y
    82                                  STA TMP
    83                                  INY
    84                                  LDA (SP),Y
    85                                  STA TMP + 1
    86                                  LDY # -1
    87                                  DEC TMP + 1
    88                                  LDA (TMP),y
    89                                  BNE +
    90                                  ;; size = 0, update nothing
    91                                  INY                             ; Y = 0
    92                                  BEQ ++
    93                                  ;; tag(dummy) <- tag(newval)
    94                          +       TAX                             ; save size
    95                                  DEY
    96                                  DEC ACCU + 1
    97                                  LDA (TMP),y
    98                                  STA (ACCU),y
    99                                  INC ACCU + 1
   100                                  INC TMP + 1
   101                                  ;; copy newval fields into dummy ones
   102                                  TXA                             ; reload size
   103                                  ASL
   104                                  TAY                             ; Y = 2 * size, Carry = MSB
   105                                  JSR caml_blkcpy
   106                                  ;; ACCU <- ()
   107                          ++      STY ACCU + 1                    ; Y = 0
   108                                  LDA # <Val_unit
   109                                  STA ACCU
   110                                  RTS
   111                          }
   112                          
   113                          }       ;; !zone caml_DUMMY
