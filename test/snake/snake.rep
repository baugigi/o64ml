  1879  2ef8 e646                       INC @VAL + 1                            ; Restore pointer
  1880  2efa a922                       LDA # '"'                               ;== STRING BLOCK ==
  1881  2efc 20caf1                     JSR C64_CHROUT                          ; Print '"'
  1882  2eff 208b2f                     JSR @pr_str                             ; Print the string
  1883  2f02 a922                       LDA # '"'                               ; Print '"'
  1884  2f04 4ccaf1                     JMP C64_CHROUT                          ; JMP=JSR+RTS
  1885  2f07 a200               @othblk LDX # 0                                 ;== BLOCK WITH TAG<>0 ==
  1886  2f09 bd152f             -       LDA @msg,X                              ; Print "<BLOCK>"
  1887  2f0c f006                       BEQ +
  1888  2f0e 20caf1                     JSR C64_CHROUT
  1889  2f11 e8                         INX
  1890  2f12 d0f5                       BNE -
  1891  2f14 60                 +       RTS                                     ; Return.
  1892  2f15 3cc2cccfc3cb3e00   @msg    !text "<BLOCK>", 0
  1893  2f1d 2447               @tag0   BIT @PRFLD                              ;== BLOCK WITH TAG=0 ==
  1894  2f1f 30e6                       BMI @othblk                             ; If @PRFLD=$FF, do as above.
  1895  2f21 a928                       LDA # '('                               ; Print '('
  1896  2f23 20caf1                     JSR C64_CHROUT
  1897  2f26 c8                         INY
  1898  2f27 b145                       LDA (@VAL),Y                            ; Get size(VAL)
  1899  2f29 8548                       STA @SIZE                               ;  and save it
  1900  2f2b e646                       INC @VAL + 1                            ; Restore pointer
  1901  2f2d c647                       DEC @PRFLD                              ; PRFLD := $FF
  1902  2f2f a546               -       LDA @VAL + 1                            ; Loop on size(VAL):
  1903  2f31 48                         PHA                                     ;  Push VAL,hi onto h/w stack
  1904  2f32 a545                       LDA @VAL
  1905  2f34 48                         PHA                                     ;  Push VAL,lo onto h/w stack
  1906  2f35 c8                         INY
  1907  2f36 b145                       LDA (@VAL),Y                            ;  Get current Field(VAL), lo
  1908  2f38 aa                         TAX
  1909  2f39 c8                         INY
  1910  2f3a b145                       LDA (@VAL),Y                            ;   and hi byte
  1911  2f3c 8645                       STX @VAL                                ;  VAL := Field(VAL)
  1912  2f3e 8546                       STA @VAL + 1
  1913  2f40 98                         TYA
  1914  2f41 48                         PHA                                     ;  Push Y onto h/w stack
  1915  2f42 20e42e                     JSR @pr_val                             ;  Recall pr_val(VAL,PRFLD=$FF)
  1916  2f45 68                         PLA                                     ;  Pop Y register from h/w stack
  1917  2f46 a8                         TAY
  1918  2f47 68                         PLA                                     ;  Pop VAL,lo from h/w stack
  1919  2f48 8545                       STA @VAL
  1920  2f4a 68                         PLA                                     ;  Pop VAL,hi from h/w stack 
  1921  2f4b 8546                       STA @VAL + 1
  1922  2f4d c648                       DEC @SIZE                               ;  Decrement counter
  1923  2f4f f00d                       BEQ +                                   ; Exit if all fields are printed
  1924  2f51 a92c                       LDA # ','                               ;  Print ','
  1925  2f53 20caf1                     JSR C64_CHROUT
  1926  2f56 a920                       LDA # ' '                               ;  Print ' '
  1927  2f58 20caf1                     JSR C64_CHROUT
  1928  2f5b 4c2f2f                     JMP -                                   ; Continue loop
  1929  2f5e a929               +       LDA # ')'                               ; Print ')'
  1930  2f60 20caf1                     JSR C64_CHROUT
  1931  2f63 60                         RTS                                     ; Return.
  1932                          
  1933                                  ;; Convert the exn name ptd by VAL to PETSCII and print it
  1934  2f64 a000               @pr_exn LDY # 0
  1935  2f66 b145               -       LDA (@VAL),Y                            ;A := VAL[Y]
  1936  2f68 f020                       BEQ +++                                 ;Exit if null
  1937  2f6a c95f               	CMP # $5F				;test for underscore
  1938  2f6c d004               	BNE +
  1939  2f6e a9a4               	LDA # $A4
  1940  2f70 d00e               	BNE ++				        ;JMP
  1941  2f72 c961               +	CMP # $61				;test for lowercase letter
  1942  2f74 9004               	BCC +
  1943  2f76 e920               	SBC # $20
  1944  2f78 d006               	BNE ++				        ;JMP
  1945  2f7a c941               +	CMP # $41				;test for uppercase letter
  1946  2f7c 9002               	BCC ++
  1947  2f7e 4980               	EOR # $80
  1948  2f80 20caf1             ++      JSR C64_CHROUT                          ;Print VAL[Y]
  1949  2f83 c8                         INY
  1950  2f84 d0e0                       BNE -
  1951  2f86 e646                       INC @VAL + 1
  1952  2f88 d0dc                       BNE -
  1953  2f8a 60                 +++     RTS
  1954                          
  1955                                  ;; Print the string pointed by VAL
  1956  2f8b a000               @pr_str LDY # 0
  1957  2f8d b145               -       LDA (@VAL),Y                            ;A := VAL[Y]
  1958  2f8f f00a                       BEQ +                                   ;Exit if null
  1959  2f91 20caf1                     JSR C64_CHROUT                          ;Print VAL[Y]
  1960  2f94 c8                         INY
  1961  2f95 d0f6                       BNE -
  1962  2f97 e646                       INC @VAL + 1
  1963  2f99 d0f2                       BNE -
  1964  2f9b 60                 +       RTS
  1965                          
  1966                                  ;; Print the integer in VAL
  1967  2f9c 2446               @pr_int BIT @VAL + 1
  1968  2f9e 1012                       BPL +
  1969  2fa0 38                         SEC                                     ;If VAL < 0,
  1970  2fa1 a902                       LDA # Val_zero + 1
  1971  2fa3 e545                       SBC @VAL                                ; negate it
  1972  2fa5 8545                       STA @VAL
  1973  2fa7 a900                       LDA # 0
  1974  2fa9 e546                       SBC @VAL + 1
  1975  2fab 8546                       STA @VAL + 1
  1976  2fad a92d                       LDA # '-'                               ; and print '-'.
  1977  2faf 20caf1                     JSR C64_CHROUT
  1978  2fb2 4646               +       LSR @VAL + 1                            ;Get rid of trailing 1
  1979  2fb4 6645                       ROR @VAL
  1980  2fb6 a930                       LDA # '0'
  1981  2fb8 8549                       STA @SKP0                               ;Ignore initial 0s
  1982  2fba a203                       LDX # 3                                 ;For X := 3 downto 0
  1983  2fbc 854a               --      STA @DGT                                ; DGT := '0'
  1984  2fbe a545               -       LDA @VAL                                ; Loop
  1985  2fc0 38                         SEC
  1986  2fc1 fde92f                     SBC @lo10,X                             ;  A:Y := VAL - 10^(X+1)
  1987  2fc4 a8                         TAY
  1988  2fc5 a546                       LDA @VAL + 1
  1989  2fc7 fded2f                     SBC @hi10,X
  1990  2fca 9008                       BCC +                                   ; Exit_loop if A:Y < 0
  1991  2fcc 8445                       STY @VAL                                ;  VAL := A:Y
  1992  2fce 8546                       STA @VAL + 1
  1993  2fd0 e64a                       INC @DGT                                ;  DGT :=nxt(DGT) ('1','2',...)
  1994  2fd2 d0ea                       BNE -                                   ; End_Loop
  1995  2fd4 a54a               +       LDA @DGT                                ; If not(DGT = '0' & SKP0 = '0')
  1996  2fd6 c549                       CMP @SKP0
  1997  2fd8 f007                       BEQ +
  1998  2fda c649                       DEC @SKP0                               ;  SKP0 := <non_digit_char>
  1999  2fdc 20caf1                     JSR C64_CHROUT                          ;  Print DGT
  2000  2fdf a930                       LDA # '0'                               ;  Set A for next iteration
  2001  2fe1 ca                 +       DEX                                     ;  Decrement counter
  2002  2fe2 10d8                       BPL --                                  ;End_For
  2003  2fe4 0545                       ORA @VAL                                ;A := '0'|VAL  (last digit)
  2004                                  ;JSR C64_CHROUT                         ;Print it
  2005                                  ;RTS                                    ; and return.
  2006  2fe6 4ccaf1                     JMP C64_CHROUT                          ;JMP=JSR+RTS
  2007  2fe9 0a64e810           @lo10   !byte <10, <100, <1000, <10000
  2008  2fed 00000327           @hi10   !byte >10, >100, >1000, >10000
