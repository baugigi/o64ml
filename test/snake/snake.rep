   280                          ;; -----------------------------------------------------------------------------
   281                          ;;      ROM/RAM OVERLAP - BASIC ROUTINES CALLS
   282                          ;; -----------------------------------------------------------------------------
   283                          
   284                                  ;; Macro: call a BASIC ROM routine
   285                          !macro caml_JSR_BASROM .routine {
   286                            !ifndef caml_basic_rom_overlap {              ;Best case: code never overlaps
   287                                  JSR .routine                            ;BASIC ROM
   288                            } else {
   289                              !if @x < C64_BASROM {                       ;BASROM is disabled but this
   290                                  JSR caml_BASROM_on                      ;part of code doesn't overlap it
   291                                  JSR .routine
   292                                  JSR caml_BASROM_off
   293                          @x  } else {                                    ;Worst case: this part of code
   294                                  PHP                                     ;overlaps BASIC ROM. Pass the
   295                                  PHA                                     ;routine address to a wrapper
   296                                  LDA # <.routine                         ;in a safe zone and call it
   297                                  STA caml_BASROM_addr
   298                                  LDA # >.routine
   299                                  STA caml_BASROM_addr + 1
   300                                  JSR caml_BASROM_wrapper
   301                              }
   302                            }
   303                          }
   304                          
   305                          !ifdef caml_basic_rom_overlap {
   306                          caml_BASROM_wrapper                             ;Wrapper for 'Worst case' above
   307                                  LDA C64_D6510
   308                                  ORA # %00000011
   309                                  STA C64_D6510
   310                                  PLA
   311                                  PLP
   312                          caml_BASROM_addr = * + 1
   313                                  JSR .dummy                              ;SMC: JSR .routine
   314                                  ;; fallthrough caml_BASROM_off
   315                          caml_BASROM_off                                 ;Deactivate BASIC ROM
   316                                  PHP
   317                                  PHA
   318                                  LDA C64_D6510
   319                                  AND # %11111110
   320                                  STA C64_D6510
   321                                  PLA
   322                                  PLP
   323                                  RTS
   324                          caml_BASROM_on                                  ;Activate BASIC ROM
   325                                  PHP
   326                                  PHA
   327                                  LDA C64_D6510
   328                                  ORA # %00000011
   329                                  STA C64_D6510
   330                                  PLA
   331                                  PLP
   332                                  RTS
   333                          }
