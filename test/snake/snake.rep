   565                          -       LDA .dummy,X            ;SMC: replaced with real address
   566                                  STA C64_ARG,X
   567                                  DEX
   568                                  BPL -
   569                                  LDX C64_ARG + 1         ;copy 1st byte of mantissa
   570                                  STX C64_ARG + 5         ;to ARG sign byte
   571                                  TXA
   572                                  EOR C64_FAC + 5         ;compare with FAC sign byte
   573                                  STA C64_ARISGN          ;store result of comparison
   574                                  TXA
   575                                  ORA # $80
   576                                  STA C64_ARG + 1         ;set 1st bit of mantissa = 1
   577                                  LDA C64_FAC             ;.A := FAC exponent
   578                                  RTS
   579                          }
