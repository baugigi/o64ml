   233                          !ifdef caml_PRIM__caml_array_get {
   234                          caml_array_get
   235                                  ;; return an array element
   236                                  ;; ACCU = array
   237                                  ;; SP[0] = index
   238                          
   239                                  ;; load tag
   240                                  LDY # -2
   241                                  DEC ACCU + 1
   242                                  LDA (ACCU),Y
   243                                  INY
   244                                  ;; check if float
   245                                  CMP # Double_array_tag
   246                                  BNE caml_array_get_addr__loadsize
   247                                  JMP caml_floatarray_get__loadsize
   248                          }
   249                          
   250                          !ifdef caml_PRIM__caml_array_get_addr {
   251                                  ;; return an array element (no-float version)
   252                                  ;; ACCU = array
   253                                  ;; SP[0] = index
   254                          caml_array_get_addr
   255                                  DEY
   256                                  DEC ACCU + 1
   257                          caml_array_get_addr__loadsize
   258                                  LDA (ACCU),Y
   259                                  STA TMP                                 ; TMP := size
   260                                  INC ACCU + 1                            ; restore ptr to Field(0)
   261                                  LDY # 1
   262                                  LDA (SP),Y                              ; load index, hi
   263                                  LSR
   264                                  BNE @error                              ; exn if index>255 or index<0
   265                                  BCC +
   266                                  INC ACCU + 1                            ; inc ACCU if index > 127
   267                          +       DEY
   268                                  LDA (SP),Y                              ; load index, lo
   269                                  TAY                                     ; now ACCU+Y points to elt, hi
   270                                  ROR
   271                                  CMP TMP
   272                                  BCS @error                              ; exn if index >= size
   273                                  LDA (ACCU),Y                            ; get array elt, hi
   274                                  TAX
   275                                  DEY
   276                                  LDA (ACCU),Y                            ; get array elt, lo
   277                                  STA ACCU                                ; ACCU <- array[index]
   278                                  STX ACCU + 1
   279                                  LDY # 0
   280                                  RTS
   281                          @error  +caml_raise Invalid_argument, "index out of bounds"
   282                          }
   283                          
   284                          !ifdef caml_PRIM__caml_floatarray_get {
   285                                  ;; return an array element (floatarray version)
   286                                  ;; ACCU = array
   287                                  ;; SP[0] = index
   288                          caml_floatarray_get
   289                                  ;; load size
   290                                  DEY
   291                                  DEC ACCU + 1
   292                          caml_floatarray_get__loadsize
   293                          @SZ     = TMP
   294                          @IDX    = TMP + 1
   295                                  LDA (ACCU),Y
   296                                  STA @SZ
   297                                  INC ACCU + 1
   298                                  ;; load index, hi
   299                                  LDY # 1
   300                                  LDA (SP),Y
   301                                  BEQ +
   302                                  ;; exn if hi > 0
   303                                  JMP @error
   304                                  ;; load index, lo
   305                          +       DEY
   306                                  LDA (SP),Y
   307                                  ;; exn if 3 * index >= size
   308                                  AND # $FE
   309                                  BEQ +
   310                                  STA @IDX
   311                                  LSR
   312                                  ;CLC
   313                                  ADC @IDX
   314                                  BCS @error
   315                                  CMP @SZ
   316                                  BCS @error
   317                                  ;; ACCU <- &array[index]
   318                          +       ASL
   319                                  BCC +
   320                                  INC ACCU + 1
   321                                  CLC
   322                          +       ADC ACCU
   323                                  STA ACCU
   324                                  BCC +
   325                                  INC ACCU + 1
   326                                  ;; allocate float
   327                          +       LDA # Double_tag
   328                                  LDX # Double_wosize
   329                                  JSR caml_alloc
   330                                  ;; copy float
   331                                  +caml_move_float ACCU, BLK
   332                                  ;; return float
   333                                  LDA BLK
   334                                  STA ACCU
   335                                  LDA BLK + 1
   336                                  STA ACCU + 1
   337                                  RTS
   338                          @error  +caml_raise Invalid_argument, "index out of bounds"
   339                          }
