   271                                  LDA ACCU + 1
   272                                  STA caml_float_loadFAC__addr + 1
   273                                  JSR caml_float_loadFAC
   274                                  +caml_JSR_BASROM C64_FACINX             ; result in Y(lo), A(hi)
