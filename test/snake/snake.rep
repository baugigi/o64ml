    13                          ;;; ----------------------------------------------------------------------------
    14                          ;;; FLOATS
    15                          ;;; ----------------------------------------------------------------------------
    16                          
    17                          ;;; ZEROPAGE LOCATIONS
    18                          ;;; used by the C64's BASIC ROM floating point routines:
    19                          ;;;
    20                          ;;; $12         used by tan and (in preparation for tan) by sin & cos routines
    21                          ;;; $22-$23     used to move variables into the accumulators and back to memory
    22                          ;;; $24-$25     used during FP comparisons and when converting PETSCII into FP
    23                          ;;; $26-$2A     result of multiplication or division
    24                          ;;; $47         used by FOUT
    25                          ;;; $56         used in addition and subtraction, and also the exp function
    26                          ;;; $5C-$60     used by the PETSCII conversion routines
    27                          ;;; $61         FAC1 exponent
    28                          ;;; $62-$65     FAC1 mantissa
    29                          ;;; $66         FAC1 sign in bit 7
    30                          ;;; $67         used by trig, exp, log functions and PETSCII to FP conversion
    31                          ;;; $68         used during normalisation and FP to integer conversion
    32                          ;;; $69         FAC2 exponent
    33                          ;;; $6A-$6D     FAC2 mantissa
    34                          ;;; $6E         FAC2 sign in bit 7
    35                          ;;; $6F         sign result of arithmetic operations, set when FAC2 is loaded
    36                          ;;; $70         low order rounding byte for FAC1, cleared when FAC1 is loaded
    37                          ;;; $71-$72     used during series eval. and when converting PETSCII into FP
    38                          ;;; $73-$8A     CHRGET routine, used when converting a PETSCII string into FP
    39                          
    40                          !zone caml_FLOATS {
    41                          
    42                          .dummy  = $1234                                 ;dummy operand for self-modifying
    43                                                                          ;code (SMC in comments)
    44                          
    45                          !ifndef caml_float_zp_check {
    46                          caml_float_zp_check
    47                            !for .i in [[$12,$12],[$22,$2A],[$47,$47],[$56,$56],[$5C,$8A]] {
    48                              !if (caml_zp_start <= .i[1]) & (.i[0] < caml_zp_end) {
    49                                !warn "ZP storage overlaps FLPT workspace", .i
    50                              }
    51                            }
    52                          }
    53                          !ifdef caml_PRIM__caml_nonstd_sign_float {
    54                          caml_nonstd_sign_float
    55                                  ;; Stdlib.sign_float
    56                                  LDA (ACCU),Y                            ;Read byte #0 (exponent)
    57                                  BEQ @zero                               ;Exponent=0 <=> float=0.
    58                                  INY
    59                                  LDA (ACCU),Y                            ;Read byte #1 (mantissa, msb)
    60                                  BPL @pos                                ;If the mantissa is negative,
    61                                  LDY # $FF                               ; set ACCU=Val_Int(-1)
    62                                  STY ACCU + 1
    63                                  STY ACCU
    64                                  INY
    65                                  RTS
    66                          @pos    DEY                                     ;else
    67                                  LDA # Val_one                           ; set ACCU=Val_Int(1)
    68                                  BNE @store                              ; BNE=JMP.
    69                          @zero   LDA # Val_zero                          ;Zero: set ACCU=Val_Int(0).
    70                          @store  STA ACCU
    71                                  STY ACCU + 1
    72                                  RTS                                     ;Y=0 at exit.
    73                          }
