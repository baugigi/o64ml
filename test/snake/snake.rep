  2469                                          TAY                             ;Y=2n
  2470                                          JMP ACCL
  2471                          }
  2472                          
  2473                          !set ACC6_BLEINT = *
  2474                          !ifdef caml_gen_ACC6_BLEINT {
  2475                            !ifdef caml_gen_ACC07 {
  2476                              !ifdef caml_gen_BLTLEINT {
  2477                                          BCC ACC07
  2478                                          ;; fallthrough BLTLEINT
  2479                              } else { !set ACC6_BLEINT = ACC07 }
