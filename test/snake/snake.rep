   261                          !ifdef caml_PRIM__caml_nonstd_string_of_float {
   262                          caml_nonstd_string_of_float
   263                                  ;; Stdlib.string_of_float
   264                                  LDA ACCU
   265                                  LDX ACCU + 1
   266                                  STA caml_float_loadFAC__addr
   267                                  STX caml_float_loadFAC__addr + 1
   268                                  JSR caml_float_loadFAC
   269                                  LDA $47                                 ;WARNING: FOUT OVERWRITES $47
   270                                  PHA                                     ;save it
   271                                  +caml_JSR_BASROM C64_FOUT               ;0-terminated string in $0100
   272                                  PLA                                     ;restore $47 value
   273                                  STA $47
   274                                  LDX # $FF
   275                          -       INX                                     ;count string length (except 0)
   276                                  LDA $0100,X
   277                                  BNE -                                   ;(X = length when loop ends)
   278                                  LDA # 1                                 ;add a final 1 for padding; it
   279                                  STA $0101,X                             ;won't be copied if len is odd
   280                                  TXA                                     ;A := length
   281                                  LSR
   282                                  TAX                                     ;X := length / 2
   283                                  INX                                     ;X := length/2+1=blk size (wo.)
   284                                  LDA # String_tag
   285                                  LDY # 0
   286                                  JSR caml_alloc                          ;allocate the new block
   287                                  LDA BLK
   288                                  STA ACCU
   289                                  LDA BLK + 1
   290                                  STA ACCU + 1                            ;ACCU := new string
   291                                  TXA
   292                                  ASL
   293                                  TAY                                     ;Y := 2 * size
   294                                  DEY
   295                          -       LDA $0100,Y                             ;copy string and 0/01 padding
   296                                  STA (BLK),Y                             ;to the new block
   297                                  DEY
   298                                  BNE -
   299                                  LDA $0100
   300                                  STA (BLK),Y
   301                                  RTS
   302                          }
