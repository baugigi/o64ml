    13                           !source "/home/pifu/.opam/LTS/lib/bcaml/stdlib_random.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib_random.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; Progetto BreadCaml / The BreadCaml Project
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
