    30                          !ifdef caml_PRIM__caml_obj_tag {
    31                                  ;; return tag(value)
    32                                  ;; ACCU = value
    33                          caml_obj_tag
    34                                  LDA ACCU
    35                                  BIT caml_is_block
    36                                  BNE @int
    37                                  LDX ACCU + 1
    38                                  CPX # > caml_heap_start
    39                                  BCC @ooh
    40                                  BNE +
    41                                  CMP # < caml_heap_start
    42                                  BCC @ooh
    43                          +       CPX # > caml_heap_end
    44                                  BCC +
    45                                  BNE @ooh
    46                                  CMP # < caml_heap_end
    47                                  BCS @ooh
    48                                  ;; Val_int(tag(ACCU))
    49                          +       LDY # -2
    50                                  DEC ACCU + 1
    51                                  LDA (ACCU),Y
    52                                  SEC
    53                                  ROL
    54                                  STA ACCU
    55                                  LDY # 0
    56                                  STY ACCU + 1
    57                                  ROL ACCU + 1
    58                                  RTS
    59                          @ooh    +Val_Int ~@oohtag, Out_of_heap_tag
    60                                  LDA # > @ohtag
    61                                  LDX # < @oohtag
    62                                  BNE @res                                ;BNE = JMP
    63                          @int    +Val_Int ~@inttag, Int_tag
    64                                  LDA # > @inttag
    65                                  LDX # < @inttag
    66                          @res    STA ACCU + 1
    67                                  STX ACCU
    68                                  RTS
    69                          }
    70                          
    71                          !ifdef caml_PRIM__caml_obj_set_tag {
    72                                  ;; ACCU = value
    73                                  ;; SP[0] = new tag
    74                          caml_obj_set_tag
    75                                  INY
    76                                  LDA (SP),Y
    77                                  LSR
    78                                  DEY
    79                                  LDA (SP),Y
    80                                  ROR
    81                                  LDY # -2
    82                                  DEC ACCU + 1
    83                                  STA (ACCU),Y
    84                                  LDY # <Val_unit
    85                                  STY ACCU
    86                                  DEY
    87                                  STY ACCU + 1
    88                                  RTS
    89                          }
    90                          
    91                          !ifdef caml_PRIM__caml_obj_block {
    92                                  ;; ACCU = tag
    93                                  ;; SP[0] = size
    94                          caml_obj_block
    95                                  INY
    96                                  LDA (SP),Y
    97                                  LSR
    98                                  DEY
    99                                  LDA (SP),Y
   100                                  ROR
   101                                  BNE +
   102                                  ;; return Atom(0) if size = 0
   103                                  LDA # < caml_atom0
   104                                  STA ACCU
   105                                  LDA # > caml_atom0
   106                                  STA ACCU + 1
   107                                  RTS
   108                                  ;; allocate a new block if size > 0
   109                          +       TAX
   110                                  LSR ACCU + 1
   111                                  LDA ACCU
   112                                  ROR
   113                                  JSR caml_alloc
   114                                  LDA BLK
   115                                  STA ACCU
   116                                  LDA BLK + 1
   117                                  STA ACCU + 1
   118                                  ;; fill fields with Val_int(0)
   119                          -       LDA # < Val_zero
   120                                  STA (BLK),Y
   121                                  INY
   122                                  LDA # > Val_zero
   123                                  STA (BLK),Y
   124                                  INY
   125                                  BNE +
   126                                  INC BLK + 1
   127                          +       DEX
   128                                  BNE -
   129                                  LDY # 0
   130                                  RTS
   131                          }
   132                          
   133                          !ifdef caml_PRIM__caml_obj_dup {
   134                                  ;; ACCU = arg
   135                          caml_obj_dup
   136                                  DEY
   137                                  DEC ACCU + 1
   138                                  LDA (ACCU),Y                            ; A := size
   139                                  BEQ @atom                               ; exit if size = 0
   140                                  TAX                                     ; X := size
   141                                  DEY
   142                                  LDA (ACCU),Y                            ; A := tag
   143                                  INC ACCU + 1                            ; restore pointer
   144                                  LDY # 0                                 ;   and Y register
   145                                  JSR caml_alloc                          ; allocate a new block
   146                                  TXA                                     ; A := size
   147                                  ASL
   148                                  TAY                                     ; Y,C := 2 * size
   149                                  JSR caml_blkcpy                         ; copy the blk pointed by ACCU
   150                                  LDA BLK
   151                                  STA ACCU
   152                                  LDA BLK + 1
   153                                  STA ACCU + 1
   154                                  RTS
   155                          @atom   INC ACCU + 1
   156                                  INY
   157                                  RTS
   158                          }
   159                          
   160                          !ifdef caml_PRIM__caml_set_oo_id {
   161                          caml_set_oo_id
   162                                  LDY # 3
   163                                  LDA caml_OOID + 1
   164                                  STA (ACCU),Y
   165                                  DEY
   166                                  LDA caml_OOID
   167                                  STA (ACCU),Y
   168                                  LDY # 0
   169                                  CLC
   170                                  ADC # 2
   171                                  STA caml_OOID
   172                                  BCC +
   173                                  INC caml_OOID + 1
   174                          +       RTS
   175                          }
   176                          
   177                          !ifdef caml_PRIM__caml_fresh_oo_id {
   178                          caml_fresh_oo_id
   179  3300 adff32                     LDA caml_OOID + 1
   180  3303 852d                       STA ACCU + 1
   181  3305 adfe32                     LDA caml_OOID
   182  3308 852c                       STA ACCU
   183  330a 18                         CLC
   184  330b 6902                       ADC # 2
   185  330d 8dfe32                     STA caml_OOID
   186  3310 9003                       BCC +
   187  3312 eeff32                     INC caml_OOID + 1
   188  3315 60                 +       RTS
   189                          }
   190                          
   191                          !ifdef caml_PRIM__caml_int_as_pointer {
   192                                  ;; ACCU = n
   193                          caml_int_as_pointer
   194                                  DEC ACCU
   195                                  RTS
   196                          }
   197                          
   198                          !ifdef caml_PRIM__caml_obj_truncate {
   199                                  ;; truncate a block to newsize
   200                                  ;; ACCU = value
   201                                  ;; SP[0] = newsize
   202                          
   203                                  ;; Obj.truncate is deprecated!
   204                          
   205                                  ;; WARNING: Obj.truncate o s  when  Obj.size o = s + 1
   206                                  ;; will leave an atom on the heap, which could cause the garbage
   207                                  ;; collector to crash if it is reachable from some root!
   208                          
   209                          caml_obj_truncate
   210                                  @NEWSZ = TMP
   211                                  ;; load tag and size
   212                                  DEY
   213                                  DEC ACCU + 1
   214                                  LDA (ACCU),Y
   215                                  TAX                                     ;X := size
   216                                  DEY
   217                                  LDA (ACCU),Y
   218                                  CMP # Double_array_tag
   219                                  BEQ @floatarray
   220                                  ;; calculate Int_val(newsize)
   221                                  LDY # 1
   222                                  LDA (SP),Y
   223                                  DEY
   224                                  LSR
   225                                  BNE @error                              ;error if newsize > 255 or < 0
   226                                  LDA (SP),Y
   227                                  ROR
   228                                  BEQ @error                              ;error if newsize = 0
   229                                  STA @NEWSZ
   230                                  CPX @NEWSZ
   231                                  BEQ @exit                               ;exit if newsize = size
   232                                  BCC @error                              ;error if newsize > size
   233                                  ;; 0 < NEWSZ < size, write NEWSZ into header
   234                          @trunc  DEY
   235                                  STA (ACCU),Y
   236                                  INC ACCU + 1
   237                                  ;; set (ACCU),Y to point to Field(ACCU, newsize)
   238                                  ASL
   239                                  BCC +
   240                                  INC ACCU + 1
   241                          +       TAY
   242                                  ;; header for the leftovers: tag = No_scan_tag, sz = size-1-newsize
   243                                  ;; WARNING: sz could be 0, the GC won't be happy if block is reachable!
   244                                  LDA # No_scan_tag
   245                                  STA (ACCU),Y                            ;tag = No_scan_tag
   246                                  INY
   247                                  DEX
   248                                  TXA
   249                                  SEC
   250                                  SBC @NEWSZ                              ;sz = size-1-NEWSZ
   251                                  STA (ACCU),Y
   252                          @exit   LDY # <Val_unit
   253                                  STY ACCU                                ;ACCU := ()
   254                                  DEY
   255                                  STY ACCU + 1
   256                                  RTS
   257                                  ;; calculate Int_val(newsize) * Double_wosize
   258                          @floatarray
   259                                  LDY # 1
   260                                  LDA (SP),Y
   261                                  BNE @error                              ;error if newsize > 127 or < 0
   262                                  DEY
   263                                  LDA (SP),Y
   264                                  AND # %11111110                         ;A = 2 * newsize
   265                                  BEQ @error                              ;error if newsize = 0
   266                                  STA @NEWSZ                              ;NEWSZ = 2 * newsize
   267                                  LSR
   268                                  ;CLC                                    ;C=0 because of previous AND
   269                                  ADC @NEWSZ                              ;A = Double_wosize * newsize
   270                                  BCS @error                              ;error if > 255
   271                                  STA @NEWSZ                              ;NEWSZ=Double_wosize * newsize
   272                                  CPX @NEWSZ
   273                                  BEQ @exit                               ;exit if NEWSZ = size
   274                                  BCS @trunc                              ;error if NEWSZ > size
   275                          @error  +caml_raise Invalid_argument, "Obj.truncate"
   276                          }
   277                          
   278                          !ifdef caml_PRIM__caml_obj_add_offset {
   279                                  ;; ACCU = value
   280                                  ;; SP[0] = offset
   281                          caml_obj_add_offset
   282                                  LDA (SP),Y
   283                                  STA TMP
   284                                  INY
   285                                  LDA (SP),Y
   286                                  STA TMP + 1
   287                                  DEY
   288                                  LSR TMP + 1
   289                                  ROR TMP
   290                                  CLC
   291                                  LDA TMP
   292                                  ADC ACCU
   293                                  STA ACCU
   294                                  LDA TMP + 1
   295                                  ADC ACCU + 1
   296                                  STA ACCU + 1
   297                                  RTS
   298                          }
   299                          
   300                          !ifdef caml_PRIM__caml_lazy_follow_forward {
   301                                  ;; ACCU = value
   302                          caml_lazy_follow_forward
   303                                  ;; is value a block?
   304                                  LDA ACCU
   305                                  BIT caml_is_block
   306                                  BNE @exit
   307                                  ;; tag(value) = Forward_tag?
   308                                  LDY # -2
   309                                  DEC ACCU + 1
   310                                  LDA (ACCU),Y
   311                                  INC ACCU + 1
   312                                  LDY # 0
   313                                  CMP # Forward_tag
   314                                  BNE @exit
   315                                  ;; is value in heap?
   316                                  SEC
   317                                  LDA # < caml_heap_start
   318                                  SBC ACCU
   319                                  STA TMP
   320                                  LDA # > caml_heap_start
   321                                  SBC ACCU + 1
   322                                  STA TMP + 1
   323                                  LDA TMP
   324                                  CMP # < caml_heap_sz
   325                                  LDA TMP + 1
   326                                  SBC # > caml_heap_sz
   327                                  BCS @exit
   328                                  ;; ACCU <- Field(value,0)
   329                                  LDA (ACCU),Y
   330                                  TAX
   331                                  INY
   332                                  LDA (ACCU),Y
   333                                  STA ACCU + 1
   334                                  STX ACCU
   335                                  DEY
   336                          @exit   RTS
   337                          }
   338                          
   339                          !ifdef caml_PRIM__caml_lazy_make_forward {
   340                                  ;; ACCU = value
   341                          caml_lazy_make_forward
   342                                  LDA # Forward_tag
   343                                  LDX # 1
   344                                  JSR caml_alloc
   345                                  LDA ACCU
   346                                  STA (BLK),Y
   347                                  INY
   348                                  LDA ACCU + 1
   349                                  STA (BLK),Y
   350                                  DEY
   351                                  LDA BLK
   352                                  STA ACCU
   353                                  LDA BLK + 1
   354                                  STA ACCU + 1
   355                                  RTS
   356                          }
   357                          
   358                          }      ;; !zone caml_OBJ
   359                          
   361                                  
   362                          

