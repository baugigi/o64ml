   167                          .exn
   168  3054 a990                LDA # <caml_std_exn[.exn]
   169  3056 852c                STA ACCU
   170  3058 a908                LDA # >caml_std_exn[.exn]
   171  305a 852d                STA ACCU + 1
   172  305c 4c0b2c              JMP RAISE

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/memory.asm
   113                          yes: raise OOM.
   114                          
   115                          .caml_garbage_collect
   116                                  ;; Stop-and-copy garbage collector, based on C.J. Cheney's algorithm
   117                                  ;; 1) Swap the current half of the heap with the other one
   118  305f adf52f                     LDA .OTH_START                          ;lo bytes...
   119  3062 aef12f                     LDX .CUR_START
   120  3065 8df12f                     STA .CUR_START
   121  3068 8ef52f                     STX .OTH_START
   122  306b 8530                       STA HEAP
   123  306d adf72f                     LDA .OTH_END
   124  3070 aef32f                     LDX .CUR_END
   125  3073 8df32f                     STA .CUR_END
   126  3076 8ef72f                     STX .OTH_END
   127  3079 adf62f                     LDA .OTH_START + 1                      ;...and hi bytes
   128  307c aef22f                     LDX .CUR_START + 1
   129  307f 8df22f                     STA .CUR_START + 1
   130  3082 8ef62f                     STX .OTH_START + 1
   131  3085 8531                       STA HEAP + 1
   132  3087 adf82f                     LDA .OTH_END + 1
   133  308a aef42f                     LDX .CUR_END + 1
   134  308d 8df42f                     STA .CUR_END + 1
   135  3090 8ef82f                     STX .OTH_END + 1
   136                                  ;; 2) Scan all roots, copy each pointed block to the fresh half,
   137                                  ;; update each pointer to reference the copy
   138                                  ;; --- Accumulator ---
   139  3093 a52c                       LDA ACCU
   140  3095 2cb309                     BIT caml_is_block                       ;Is it a pointer?
   141  3098 d00f                       BNE +                                   ;Skip if not
   142  309a 855b                       STA @SCN
   143  309c a52d                       LDA ACCU + 1
   144  309e 855c                       STA @SCN + 1
   145  30a0 207b31                     JSR .caml_gc_fwdptr                     ;Get fwd ptr (maybe copy blk)
   146  30a3 9004                       BCC +                                   ;Skip if not a ptr in heap
   147  30a5 852c                       STA ACCU                                ;Save fwd pointer, lo
   148  30a7 862d                       STX ACCU + 1                            ;     and hi byte.
   149                                  ;; --- Environment ---
   150  30a9 a534               +       LDA ENV                                 ;Do as above, for ENV.
   151  30ab 2cb309                     BIT caml_is_block
   152  30ae d00f                       BNE +
   153  30b0 855b                       STA @SCN
   154  30b2 a535                       LDA ENV + 1
   155  30b4 855c                       STA @SCN + 1
   156  30b6 207b31                     JSR .caml_gc_fwdptr
   157  30b9 9004                       BCC +
   158  30bb 8534                       STA ENV
   159  30bd 8635                       STX ENV + 1
   160                                  ;; --- Stack ---
   161  30bf a900               +       LDA # < caml_stack_start                ;Do as above for all stack elts:
   162  30c1 8d5331                     STA @testlo + 1                         ;set <last_address
   163  30c4 a99c                       LDA # > caml_stack_start
   164  30c6 8d5731                     STA @testhi + 1                         ;set >last_address
   165  30c9 a900                       LDA # < caml_stack_end
   166  30cb 855d                       STA @PTR                                ;set <first_address + 1
   167  30cd a9a0                       LDA # > caml_stack_end
   168  30cf 855e                       STA @PTR + 1                            ;set >first_address + 1
   169  30d1 204a31                     JSR .caml_gc_scnroot
   170                                  ;; --- Globals ---
   171  30d4 a954                       LDA # < caml_glob_table                 ;Same, for globals
   172  30d6 8d5331                     STA @testlo + 1
   173  30d9 a935                       LDA # > caml_glob_table
   174  30db 8d5731                     STA @testhi + 1
   175  30de a9d4                       LDA # < caml_glob_data
   176  30e0 855d                       STA @PTR
   177  30e2 a935                       LDA # > caml_glob_data
   178  30e4 855e                       STA @PTR + 1
   179  30e6 204a31                     JSR .caml_gc_scnroot
   180                                  ;; 3) Scan all pointers in blocks that have been copied to the fresh
   181                                  ;; half of the heap, copy their pointed blocks to the fresh half,
   182                                  ;; update each pointer to reference the copy.
   183  30e9 adf12f                     LDA .CUR_START
   184  30ec 855d                       STA @PTR
   185  30ee adf22f                     LDA .CUR_START + 1
   186  30f1 855e                       STA @PTR + 1
   187  30f3 a55d               --      LDA @PTR                                ;Loop: scan blocks
   188  30f5 c530                       CMP HEAP
   189  30f7 a55e                       LDA @PTR + 1
   190  30f9 e531                       SBC HEAP + 1
   191  30fb b04c                       BCS +++                                 ;Exit loop if @PTR >= HEAP
   192  30fd b15d                       LDA (@PTR),Y                            ; Load tag (Y=0 here)
   193  30ff aa                         TAX                                     ; Save it in X
   194  3100 e65d                       INC @PTR                                ; Safe, @PTR is even before INC
   195  3102 b15d                       LDA (@PTR),Y                            ; Load block size
   196  3104 e65d                       INC @PTR                                ; Set @PTR to point to Field(0)
   197  3106 d002                       BNE +
   198  3108 e65e                       INC @PTR + 1
   199  310a e0fb               +       CPX # No_scan_tag                       ; Is tag >= No_scan_tag?
   200  310c 9010                       BCC @scan
   201  310e 0a                         ASL                                     ; Yes: compute A := 2*size and
   202  310f 9003                       BCC +                                   ;  add it to @PTR.
   203  3111 e65e                       INC @PTR + 1
   204  3113 18                         CLC
   205  3114 655d               +       ADC @PTR
   206  3116 855d                       STA @PTR
   207  3118 90d9                       BCC --
   208  311a e65e                       INC @PTR + 1                            ;  Now @PTR->next block's header
   209  311c b0d5                       BCS --                                  ;  Continue the outer loop.
   210  311e 855f               @scan   STA @CNT                                ; No: set @CNT = # of fields
   211  3120 b15d               -       LDA (@PTR),Y                            ; Loop: scan fields
   212  3122 2cb309                     BIT caml_is_block                       ;  Is current field a block?
   213  3125 d014                       BNE @next                               ;  Skip it if not.
   214  3127 855b                       STA @SCN                                ;  Yes: store it in @SCN, lo by.
   215  3129 c8                         INY
   216  312a b15d                       LDA (@PTR),Y
   217  312c 855c                       STA @SCN + 1                            ;  and hi by.
   218  312e 88                         DEY
   219  312f 207b31                     JSR .caml_gc_fwdptr                     ;  Get fwd ptr (maybe copy blk)
   220  3132 9007                       BCC @next                               ;  Skip if block is out_of_heap
   221  3134 915d                       STA (@PTR),Y                            ;  Save fwd ptr, lo byte
   222  3136 8a                         TXA                                     ;  A := fwd ptr, hi byte
   223  3137 c8                         INY
   224  3138 915d                       STA (@PTR),Y                            ;  Save fwd ptr, hi byte.
   225  313a 88                         DEY                                     ;  Y=0 now.
   226  313b e65d               @next   INC @PTR                                ;  Increment @PTR twice to let
   227  313d e65d                       INC @PTR                                ;  it point to next field.
   228  313f d002                       BNE +
   229  3141 e65e                       INC @PTR + 1
   230  3143 c65f               +       DEC @CNT                                ;  Decrement loop counter
   231  3145 d0d9                       BNE -                                   ; End of loop: scan fields.
   232  3147 f0aa                       BEQ --                                  ;End of loop: scan blocks.
   233  3149 60                 +++     RTS                                     ;GC done.
   234                          
   235                          .caml_gc_scnroot
   236                                  ;; Subroutine: loop on @PTR > last_address and call .caml_gc_fwdptr
   237  314a a55d               -       LDA @PTR
   238  314c d002                       BNE +
   239  314e c65e                       DEC @PTR + 1
   240  3150 c65d               +       DEC @PTR                                ;@PTR points to curr elt, hi by.
   241  3152 a934               @testlo LDA # <.dummy                           ;SMC: real arg is <last_address
   242  3154 c55d                       CMP @PTR
   243  3156 a912               @testhi LDA # >.dummy                           ;SMC: real arg is >last_address
   244  3158 e55e                       SBC @PTR + 1
   245  315a b01e                       BCS +                                   ;Exit loop if all elts scanned
   246  315c b15d                       LDA (@PTR),Y                            ;Get hi byte (Y=0 here)
   247  315e aa                         TAX                                     ;Save it in X
   248  315f c65d                       DEC @PTR                                ;Safe, @PTR is odd before DEC
   249  3161 b15d                       LDA (@PTR),Y                            ;Get lo byte
   250  3163 2cb309                     BIT caml_is_block                       ;Is it a pointer?
   251  3166 d0e2                       BNE -                                   ;If not, skip it
   252  3168 855b                       STA @SCN                                ;Save the pointer, lo byte
   253  316a 865c                       STX @SCN + 1                            ;and hi byte
   254  316c 207b31                     JSR .caml_gc_fwdptr                     ;Get fwd ptr (maybe copy blk)
   255  316f 90d9                       BCC -                                   ;Skip if out_of_heap
   256  3171 915d                       STA (@PTR),Y                            ;Save fwd pointer, lo byte
   257  3173 8a                         TXA                                     ;(prepare to save hi by: A := X
   258  3174 c8                         INY                                     ; and adjust Y)
   259  3175 915d                       STA (@PTR),Y                            ;Save hi byte
   260  3177 88                         DEY                                     ;Y=0 now
   261  3178 f0d0                       BEQ -                                   ;BEQ=JMP, continue loop
   262  317a 60                 +       RTS
   263                          .caml_gc_fwdptr
   264                                  ;; Subroutine: if @SCN is allocated in the old half of the heap, copy
   265                                  ;; it in the fresh one, set Field(0)=forward pointer, set size=0, then
   266                                  ;; return C=1, X:A=fwd ptr, Y=0; if already copied, return C=0, Y=0.
   267  317b a55b                       LDA @SCN                                ;Check if out-of-heap ptr:
   268  317d cdf52f                     CMP .OTH_START
   269  3180 a55c                       LDA @SCN + 1
   270  3182 edf62f                     SBC .OTH_START + 1                      ;@SCN < lower bound?
   271  3185 900d                       BCC +                                   ;yes: exit
   272  3187 a55b                       LDA @SCN
   273  3189 cdf72f                     CMP .OTH_END
   274  318c a55c                       LDA @SCN + 1
   275  318e edf82f                     SBC .OTH_END + 1                        ;@SCN >= higher bound?
   276  3191 9002                       BCC ++                                  ;no:  go ahead
   277  3193 18                         CLC                                     ;yes: clear carry and exit
   278  3194 60                 +       RTS                                     ;RETURN C=0, Y=0.
   279  3195 c65c               ++      DEC @SCN + 1                            ;decrement ptr's hi byte
   280  3197 a0ff                       LDY # -1                                ; and set Y in order to
   281  3199 b15b               @again  LDA (@SCN),Y                            ; get block size
   282  319b d00c                       BNE @copy                               ;if size = 0
   283  319d e65c                       INC @SCN + 1                            ;then restore the pointer,
   284  319f a001                       LDY # 1                                 ;  get fwd ptr from Field(0):
   285  31a1 b15b                       LDA (@SCN),Y                            ;    get hi byte
   286  31a3 aa                         TAX                                     ;    and save it in X
   287  31a4 88                         DEY                                     ;    get lo byte
   288  31a5 b15b                       LDA (@SCN),Y                            ;    and save it in A
   289  31a7 38                         SEC                                     ;  set C=1
   290  31a8 60                         RTS                                     ;  RETURN C=1, X:A=fwdptr, Y=0.
   291  31a9 aa                 @copy   TAX                                     ;else X := size
   292  31aa a900                       LDA # 0                                 ;  mark this block as visited,
   293  31ac 915b                       STA (@SCN),Y                            ;    setting its size = 0
   294  31ae 88                         DEY                                     ;  Y := $FE
   295  31af b15b                       LDA (@SCN),Y                            ;  A := tag
   296  31b1 c9f9                       CMP # Infix_tag                         ;  is it an infix block?
   297  31b3 f055                       BEQ @infix                              ;  yes: skip to proper section.
   298  31b5 e65c                       INC @SCN + 1                            ;  restore the pointer
   299  31b7 a000                       LDY # 0                                 ;  and Y register
   300  31b9 9130                       STA (HEAP),Y                            ;  write tag in new block
   301  31bb e630                       INC HEAP
   302  31bd 8a                         TXA
   303  31be 9130                       STA (HEAP),Y                            ;  write size
   304  31c0 e630                       INC HEAP                                ;  now HEAP->Field(0)
   305  31c2 d002                       BNE +
   306  31c4 e631                       INC HEAP + 1
   307  31c6 a530               +       LDA HEAP
   308  31c8 8557                       STA BLK                                 ;  BLK := &Field(0)
   309  31ca a531                       LDA HEAP + 1
   310  31cc 8558                       STA BLK + 1
   311  31ce 8a                         TXA                                     ;  Add 2*size to HEAP
   312  31cf 0a                         ASL
   313  31d0 9003                       BCC +
   314  31d2 e631                       INC HEAP + 1
   315  31d4 18                         CLC
   316  31d5 6530               +       ADC HEAP
   317  31d7 8530                       STA HEAP
   318  31d9 9002                       BCC +
   319  31db e631                       INC HEAP + 1
   320  31dd 8a                 +       TXA                                     ;  Prepare to copy all fields:
   321  31de 0a                         ASL
   322  31df a8                         TAY                                     ;  C:Y := 2*size
   323  31e0 9006                       BCC @lt256                              ;   2*size < 256by (<128 fields)
   324  31e2 f016                       BEQ @eq256                              ;   2*size = 256by (=128 fields)
   325  31e4 e65c                       INC @SCN + 1                            ;   2*size > 256by (>128 fields)
   326  31e6 e658                       INC BLK + 1
   327                          --                                              ;  loop: copy @SCN fields to BLK
   328  31e8 88                 @lt256  DEY
   329  31e9 b15b               -       LDA (@SCN),Y
   330  31eb 9157                       STA (BLK),Y
   331  31ed 88                         DEY
   332  31ee d0f9                       BNE -
   333  31f0 b15b                       LDA (@SCN),Y                            ;   handle Y = 0 apart
   334  31f2 9157                       STA (BLK),Y
   335  31f4 9007                       BCC @wrtfwd                             ;  exit loop
   336  31f6 c65c                       DEC @SCN + 1
   337  31f8 c658                       DEC BLK + 1
   338  31fa 18                 @eq256  CLC
   339  31fb 90eb                       BCC --
   340  31fd c8                 @wrtfwd INY                                     ;  Y:=1
   341  31fe a558                       LDA BLK + 1                             ;  load fwd pointer, hi
   342  3200 915b                       STA (@SCN),Y                            ;  write it in field(0), hi
   343  3202 aa                         TAX                                     ;  and move it in X
   344  3203 88                         DEY                                     ;  Y := 0
   345  3204 a557                       LDA BLK                                 ;  load fwd pointer, lo
   346  3206 915b                       STA (@SCN),Y                            ;  and write it in field(0),lo
   347  3208 38                         SEC                                     ;  set carry before exit
   348  3209 60                         RTS                                     ;  RETURN (X:A=fwdptr, Y=0)
   349  320a 8a                 @infix  TXA                                     ;A:=X=size=dist.from main blk
   350  320b 8e2932                     STX @dst + 1                            ;save it for later
   351  320e 0a                         ASL                                     ;C:A := 2*dist.
   352  320f 8d1a32                     STA @dst2lo + 1                         ;write next SBC's arg.
   353  3212 9002                       BCC +                                   ;perform @SCN:=@SCN-.DST:
   354  3214 c65c                       DEC @SCN + 1                            ;  decr @SCN_hi if C set
   355  3216 a55b               +       LDA @SCN                                ;  load @SCN_lo
   356  3218 38                         SEC
   357  3219 e934               @dst2lo SBC # <.dummy                           ;  SMC: subtract <2*dist.
   358  321b 855b                       STA @SCN                                ;  save result, lo by.
   359  321d b002                       BCS +
   360  321f c65c                       DEC @SCN + 1                            ;  adjust hi by.
   361  3221 c8                 +       INY                                     ;(@SCN),Y = main block's size
   362  3222 209931                     JSR @again                              ;get main block's fwdptr in X:A
   363  3225 8d3032                     STA @fwdlo + 1                          ;write next ADC's arg.
   364  3228 a934               @dst    LDA # <.dummy                           ;SMC: get infix's SIZE
   365  322a 0a                         ASL                                     ;A := <SIZE*2, C := >SIZE*2 
   366  322b 9002                       BCC @fwdlo                              ;perform X:A:=X:A+main fwd ptr:
   367  322d e8                         INX                                     ;  incr X if SIZE*2>255
   368  322e 18                         CLC
   369  322f 6934               @fwdlo  ADC # <.dummy                           ;  SMC: add forward ptr, lo byte
   370  3231 9001                       BCC +
   371  3233 e8                         INX                                     ;  adjust X
   372  3234 38                 +       SEC                                     ;set carry before exit
   373  3235 60                         RTS                                     ;RETURN(X:A=infix forward ptr)
   374                          caml_shrink_latest_alloc
   375                                  ;; Reduce the size of the latest allocated block; new size MUST BE less
   376                                  ;; than the original one (no check) and NO GARBAGE COLLECTION occurred
   377                                  ;; since the block allocation. Params: X=size>0, Y=0, BLK=address.
   378                                  ;; Shrinking is done by updating the new size in the block's header and
   379                                  ;; the HEAP pointer.
   380                                  ;; Return: A=X=size, Y=0.
   381                          @SZ     = GC                                    ;2 by - block size in bytes
   382  3236 c658                       DEC BLK + 1                             ;Prepare access to the 'size'
   383  3238 88                         DEY                                     ; byte in block's header
   384  3239 b157                       LDA (BLK),Y                             ;Read original size from header
   385  323b 8559                       STA @SZ                                 ; and save it
   386  323d 8a                         TXA                                     ;A := new size
   387  323e 9157                       STA (BLK),Y                             ;Write new size into header
   388  3240 e658                       INC BLK + 1                             ;Restore block pointer
   389  3242 c8                         INY                                     ; and Y register
   390  3243 49ff                       EOR # $FF                               ;Do an inverse subtraction:
   391  3245 38                         SEC                                     ; A := @SZ - A
   392  3246 6559                       ADC @SZ                                 ;    = orig.size - new size
   393  3248 0a                         ASL                                     ;Compute 2 * A
   394  3249 8559                       STA @SZ                                 ;Store result, lo byte, in @SZ
   395  324b 845a                       STY @SZ + 1                             ;Set @SZ + 1 to 0
   396  324d 265a                       ROL @SZ + 1                             ;Store result, MSB, in @SZ + 1
   397  324f a530                       LDA HEAP                                ;Recover unused block bytes by
   398  3251 38                         SEC                                     ; decrementing the heap pointer
   399  3252 e559                       SBC @SZ                                 ; by 2 * (orig.size - new size)
   400  3254 8530                       STA HEAP                                ;Store new value, lo byte
   401  3256 a531                       LDA HEAP + 1
   402  3258 e55a                       SBC @SZ + 1
   403  325a 8531                       STA HEAP + 1                            ;Store new value, hi byte
   404  325c 60                         RTS                                     ;Return.
   405                          caml_memory_end
   406                          } ;!zone caml_MEMORY
