    13                          ;;; -----------------------------------------------------------
    14                          ;;; COMPARISONS
    15                          ;;; -----------------------------------------------------------
    16                          
    17                          !zone caml_COMPARISONS {
    18                          
    19                          !ifndef caml_compare_warn {
    20                          caml_compare_warn
    21                            !warn "TODO: caml_compare_val_custom_tag"
    22                            !warn "TODO: caml_compare_val_double_array_tag"
    23                            !warn "TODO: caml_compare_val_object_tag"
    24                          }
    25                          
    26                          .dummy = $1234                                  ;dummy address for SMC
    27                                  
    28                          !macro  beq .adr { BNE + : JMP .adr :+ }        ;Long branch if equal
    29                          !macro  bne .adr { BEQ + : JMP .adr :+ }        ;Long branch if not equal
    30                          
    31                          .V1     = ACCU                                  ;word, 1st argument
    32                          .V2     = TMP                                   ;word, 2nd argument
    33                          .SAVESP = TMP + 2                               ;word, SP backup
    34                          .CMP    = TMP + 4                               ;byte, result/temp
    35                          .COMPARE= TMP + 5                               ;byte, total ordering flag
    36                          .FLTMP  = TMP + 6                               ;5 bytes, float temp area
    37                                  ;; TMP + 11 ...                         ;free
    38                          
    39                                  ;;
    40                                  ;; int
    41                                  ;;
    42                          
    43                          !ifdef caml_PRIM__caml_int_compare {
    44                          caml_int_compare
    45                                  LDA ACCU + 1                            ;Compare hi bytes by subtraction
    46                                  INY
    47                                  SEC
    48                                  SBC (SP),Y
    49                                  BEQ ++                                  ;if A = arg0h-arg1h <> 0 then
    50                                  BVC +                                   ;  A_7 <- N xor V
    51                                  EOR #$80                                ;  (A_7=1 <==> arg0 < arg1)
    52                          +       STA ACCU + 1                            ;  store it in ACCUh
    53                                  DEY
    54                                  RTS                                     ;  exit (ACCUl unchanged);      
    55                          ++      DEY                                     ;else
    56                                  LDA (SP),Y                              ;  compare lo bytes
    57                                  CMP ACCU                                ;  (C=1 <==> arg0 <= arg1)
    58                                  BEQ caml_return_zero                    ;  if equal, return Val_zero;
    59                                  ROR ACCU + 1                            ;  else rotate C -> ACCUh_7
    60                                  RTS                                     ;  and exit (ACCUl unchanged);
    61                          }
    62                          
    63                                  ;;
    64                                  ;; floats
    65                                  ;;
    66                          
    67                          !ifdef caml_PRIM__caml_eq_float {
    68                          caml_eq_float
    69                                  JSR caml_compare_identity_setV2
    70                                  BEQ caml_return_true
    71                                  JSR caml_compare_val_double_tag
    72                                  BEQ caml_return_true
    73                                  BNE caml_return_false
    74                          }
    75                          
    76                          !ifdef caml_PRIM__caml_neq_float {
    77                          caml_neq_float
    78                                  JSR caml_compare_identity_setV2
    79                                  BEQ caml_return_false
    80                                  JSR caml_compare_val_double_tag
    81                                  BEQ caml_return_false
    82                                  BNE caml_return_true
    83                          }
    84                          
    85                          !ifdef caml_PRIM__caml_le_float {
    86                          caml_le_float
    87                                  JSR caml_compare_identity_setV2
    88                                  BEQ caml_return_true
    89                                  JSR caml_compare_val_double_tag
    90                                  BMI caml_return_true
    91                                  BPL caml_return_false
    92                          }
    93                          
    94                          !ifdef caml_PRIM__caml_lt_float {
    95                          caml_lt_float
    96                                  JSR caml_compare_identity_setV2
    97                                  BEQ caml_return_false
    98                                  JSR caml_compare_val_double_tag
    99                                  BMI caml_return_true
   100                                  BPL caml_return_false
   101                          }
   102                          
   103                          !ifdef caml_PRIM__caml_ge_float {
   104                          caml_ge_float
   105                                  JSR caml_compare_identity_setV2
   106                                  BEQ caml_return_true
   107                                  JSR caml_compare_val_double_tag
   108                                  BMI caml_return_false
   109                                  BPL caml_return_true
   110                          }
   111                          
   112                          !ifdef caml_PRIM__caml_gt_float {
   113                          caml_gt_float
   114                                  JSR caml_compare_identity_setV2
   115                                  BEQ caml_return_false
   116                                  JSR caml_compare_val_double_tag
   117                                  BMI caml_return_false
   118                                  BPL caml_return_true
   119                          }
   120                          
   121                          !ifdef caml_PRIM__caml_float_compare {
   122                          caml_float_compare
   123                                  JSR caml_compare_identity_setV2
   124                                  BEQ caml_return_zero
   125                                  JSR caml_compare_val_double_tag
   126                                  JMP caml_compare_set_result
   127                          }
   128                          
   129                                  ;;
   130                                  ;; bytes/string
   131                                  ;;
   132                          
   133                          !ifdef caml_PRIM__caml_bytes_equal {
   134                          caml_bytes_equal = caml_string_equal
   135                          }
   136                          !ifdef caml_PRIM__caml_string_equal {
   137                          caml_string_equal
   138                                  JSR caml_compare_identity_setV2
   139                                  BEQ caml_return_true
   140                                  JSR caml_string_eq_neq
   141                                  BEQ caml_return_true
   142                                  BNE caml_return_false
   143                          }
   144                          
   145                          !ifdef caml_PRIM__caml_bytes_notequal {
   146                          caml_bytes_notequal = caml_string_notequal
   147                          }
   148                          !ifdef caml_PRIM__caml_string_notequal {
   149                          caml_string_notequal
   150                                  JSR caml_compare_identity_setV2
   151                                  BEQ caml_return_false
   152                                  JSR caml_string_eq_neq
   153                                  BEQ caml_return_false
   154                                  BNE caml_return_true
   155                          }
   156                          
   157                          ;;; --------------------------------------      ;Auxiliary routines for saving
   158                          !ifdef  caml_PRIM__caml_return_true {           ;the comparison result in ACCU.
   159                          caml_return_true                                ;Placed here due to the branch
   160                                  STY ACCU + 1                            ;offset limitations.
   161                                  LDA # <Val_true
   162                                  STA ACCU
   163                                  RTS
   164                          }
   165                          
   166                          !ifdef  caml_PRIM__caml_return_false {
   167                          caml_return_false
   168                                  STY ACCU + 1
   169                                  LDA # <Val_false
   170                                  STA ACCU
   171                                  RTS
   172                          }
   173                          
   174                          !ifdef  caml_PRIM__caml_return_zero {
   175                          caml_return_zero=caml_return_false
   176                          }
   177                          ;;; --------------------------------------
   178                          
   179                          !ifdef caml_PRIM__caml_bytes_lessthan {
   180                          caml_bytes_lessthan = caml_string_lessthan
   181                          }
   182                          !ifdef caml_PRIM__caml_string_lessthan {
   183                          caml_string_lessthan
   184                                  JSR caml_compare_identity_setV2
   185                                  BEQ caml_return_false
   186                                  JSR caml_compare_val_string_tag
   187                                  BMI caml_return_true
   188                                  BPL caml_return_false
   189                          }
   190                          
   191                          !ifdef caml_PRIM__caml_bytes_greaterequal {
   192                          caml_bytes_greaterequal = caml_string_greaterequal
   193                          }
   194                          !ifdef caml_PRIM__caml_string_greaterequal {
   195                          caml_string_greaterequal
   196                                  JSR caml_compare_identity_setV2
   197                                  BEQ caml_return_true
   198                                  JSR caml_compare_val_string_tag
   199                                  BMI caml_return_false
   200                                  BPL caml_return_true
   201                          }
   202                          
   203                          !ifdef caml_PRIM__caml_bytes_lessequal {
   204                          caml_bytes_lessequal = caml_string_lessequal
   205                          }
   206                          !ifdef caml_PRIM__caml_string_lessequal {
   207                          caml_string_lessequal
   208                                  JSR caml_compare_identity_setV2
   209                                  BEQ caml_return_true
   210                                  JSR caml_compare_val_string_tag
   211                                  BMI caml_return_true
   212                                  BPL caml_return_false
   213                          }
   214                          
   215                          !ifdef caml_PRIM__caml_bytes_greaterthan {
   216                          caml_bytes_greaterthan = caml_string_greaterthan
   217                          }
   218                          !ifdef caml_PRIM__caml_string_greaterthan {
   219                          caml_string_greaterthan
   220                                  JSR caml_compare_identity_setV2
   221                                  BEQ caml_return_false
   222                                  JSR caml_compare_val_string_tag
   223                                  BMI caml_return_false
   224                                  BPL caml_return_true
   225                          }
   226                          
   227                          !ifdef caml_PRIM__caml_bytes_compare {
   228                          caml_bytes_compare = caml_string_compare
   229                          }
   230                          !ifdef caml_PRIM__caml_string_compare {
   231                          caml_string_compare
   232                                  JSR caml_compare_identity_setV2
   233                                  BEQ caml_return_zero
   234                                  JSR caml_compare_val_string_tag
   235                                  JMP caml_compare_set_result
   236                          }
   237                          
   238                                  ;;
   239                                  ;; polymorphic comparisons
   240                                  ;;
   241                          
   242                          !ifdef caml_PRIM__caml_equal {
   243                          caml_equal
   244                                  JSR caml_compare_val
   245                                  BNE caml_return_false
   246                                  BEQ caml_return_true
   247                          }
   248                          
   249                          !ifdef caml_PRIM__caml_notequal {
   250                          caml_notequal
   251                                  JSR caml_compare_val
   252                                  BNE caml_return_true
   253                                  BEQ caml_return_false
   254                          }
   255                          
   256                          !ifdef caml_PRIM__caml_lessthan {
   257                          caml_lessthan
   258                                  JSR caml_compare_val
   259                                  BPL caml_return_false
   260                                  BMI caml_return_true
   261                          }
   262                          
   263                          !ifdef caml_PRIM__caml_greaterequal {
   264                          caml_greaterequal
   265                                  JSR caml_compare_val
   266                                  BPL caml_return_true
   267                                  BMI caml_return_false
   268                          }
   269                          
   270                          !ifdef caml_PRIM__caml_lessequal {
   271                          caml_lessequal
   272                                  JSR caml_compare_val
   273                                  BMI caml_return_true
   274                                  BNE caml_return_false
   275                                  BEQ caml_return_true
   276                          }
   277                          
   278                          !ifdef caml_PRIM__caml_greaterthan {
   279                          caml_greaterthan
   280                                  JSR caml_compare_val
   281                                  BMI caml_return_false
   282                                  BNE caml_return_true
   283                                  BEQ caml_return_false
   284                          }
   285                          
   286                          !ifdef caml_PRIM__caml_compare {
   287                          caml_compare
   288                                  INY                                     ;set .COMPARE=1
   289                                  JSR caml_compare_val
   290                                  ;; FALLTHROUGH caml_compare_set_result
   291                          }
   292                          
   293                          !ifdef caml_PRIM__caml_compare_set_result {
   294                          caml_compare_set_result
   295                                  BPL +
   296                                  LDA # -1
   297                                  STA ACCU
   298                                  STA ACCU + 1
   299                                  RTS
   300                          +       SEC
   301                                  ROL
   302                                  STA ACCU
   303                                  STY ACCU + 1
   304                                  RTS
   305                          }
   306                          
   307                          !ifdef caml_PRIM__caml_compare_identity_setV2 {
   308                          caml_compare_identity_setV2
   309                                  ;; check if ACCU == SP[0] (physical identity)
   310                                  ;; yes: return Z = 1
   311                                  ;; no:  return Z = 0, .V2 = SP[0]
   312                                  LDA (SP),Y
   313                                  TAX
   314                                  INY
   315                                  LDA (SP),Y
   316                                  DEY
   317                                  CPX .V1
   318                                  BNE +
   319                                  CMP .V1 + 1
   320                                  BNE +
   321                                  RTS
   322                          +       STX .V2
   323                                  STA .V2 + 1
   324                                  RTS
   325                          }
   326                          
   327                          !ifdef caml_PRIM__caml_compare_val {
   328                          caml_compare_val
   329                                  ;; Compare values in ACCU and SP[0].
   330                                  ;; PREREQUISITE: Y <> 0 if called by caml_compare, Y = 0 otherwise.
   331                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   332                                  ;; Status byte is set according to A.
   333                                  STY .COMPARE                            ;Y <> 0 iif called by caml_compare
   334                                  LDY # 0
   335                                  LDA SP
   336                                  STA .SAVESP
   337                                  LDA SP + 1
   338                                  STA .SAVESP + 1
   339                                  LDA (SP),Y
   340                                  STA .V2
   341                                  INY
   342                                  LDA (SP),Y
   343                                  STA .V2 + 1
   344                          .loop   LDY # 0
   345                                  STY .CMP
   346                                  LDA .V1 + 1
   347                                  LDX .V1
   348                                  CPX .V2
   349                                  BEQ .eq_tst
   350                                  SBC .V2 + 1
   351                          .neq    BVC +                                   ;(signed) v1<v2 iif V xor N = 1
   352                                  ORA # $80
   353                          +       BMI +
   354                                  INC .CMP                                ;v1 > v2 => CMP := 1
   355                                  BNE .int_or_block                       ;bne=jmp
   356                          +       DEC .CMP                                ;v1 < v2 => CMP := -1
   357                                  BNE .int_or_block                       ;bne=jmp
   358                          .eq_tst SBC .V2 + 1
   359                                  BNE .neq
   360                                  CMP .COMPARE                            ;v1==v2; called by caml_compare?
   361                                  BEQ .int_or_block                       ;no: go deep, maybe raise exn :(
   362                                  JMP .next_item                          ;yes: speed up, go to next_item
   363                          .int_or_block
   364                                  TXA
   365                                  BIT caml_is_block
   366                                  BEQ .v1_block
   367                                  LDA .V2
   368                                  BIT caml_is_block
   369                                  BEQ .v1_int_v2_block
   370                                  LDA .CMP
   371                                  JMP .return_or_next
   372                          .v1_int_v2_block
   373                                  LDY # -2
   374                                  DEC .V2 + 1
   375                                  LDA (.V2),Y                             ;A := Tag(v2)
   376                                  INC .V2 + 1
   377                                  CMP # Forward_tag                       ;check for special cases
   378                                  BEQ .v2_forward
   379                                  CMP # Custom_tag
   380                                  BEQ .v2_custom
   381                                  LDA # -1
   382                                  JMP .return                             ;int < block => RETURN LESS
   383                          .v2_forward
   384                                  LDY # 1
   385                                  LDA (.V2),Y                             ;v2 := Field(v2,0)
   386                                  TAX
   387                                  DEY
   388                                  LDA (.V2),Y
   389                                  STX .V2 + 1
   390                                  STA .V2
   391                                  JMP .loop                               ;continue
   392                          .v2_custom
   393                                  LDY # 1
   394                                  LDA (.V2),Y                             ;load jmptbl address
   395                                  STA .v2jsr + 2
   396                                  DEY
   397                                  LDA (.V2),Y
   398                                  STA .v2jsr + 1
   399                          .v2jsr  JSR .dummy                              ;call custom_compare, res. in A
   400                                  JMP .return_or_next
   401                          .v1_block
   402                                  LDA .V2
   403                                  BIT caml_is_block
   404                                  BEQ .v1_block_v2_block
   405                                  LDY # -2                                ;v1:block, v2:int
   406                                  DEC .V1 + 1
   407                                  LDA (.V1),Y                             ;A := Tag(v1)
   408                                  INC .V1 + 1
   409                                  CMP # Forward_tag                       ;check for special cases
   410                                  BEQ .v1_forward
   411                                  CMP # Custom_tag
   412                                  BEQ .v1_cust_tst
   413                                  LDA # 1
   414                                  JMP .return                             ;block > int => RETURN GREATER
   415                          .v1_forward
   416                                  LDY # 1
   417                                  LDA (.V1),Y                             ;v1 := Field(v1,0)
   418                                  TAX
   419                                  DEY
   420                                  LDA (.V1),Y
   421                                  STX .V1 + 1
   422                                  STA .V1
   423                                  JMP .loop                               ;continue
   424                          .v1_cust_tst
   425                                  LDY # 1
   426                                  LDA (.V1),Y                             ;load jmptbl address
   427                                  STA .v1jsr + 2
   428                                  DEY
   429                                  LDA (.V1),Y
   430                                  STA .v1jsr + 1
   431                          .v1jsr  JSR .dummy                              ;call custom_compare, res. in A
   432                                  JMP .return_or_next
   433                          .v1_block_v2_block
   434                                  LDY # -2
   435                                  DEC .V1 + 1
   436                                  DEC .V2 + 1
   437                                  LDA (.V2),Y
   438                                  TAX                                     ;X := Tag_v2
   439                                  LDA (.V1),Y                             ;A := Tag_v1
   440                                  INC .V1 + 1
   441                                  INC .V2 + 1
   442                                  CMP # Forward_tag
   443                                  BEQ .v1_forward                         ;jump if Tag_v1=Forward_tag
   444                                  CPX # Forward_tag
   445                                  +beq .v2_forward                        ;jump if Tag_v2=Forward_tag
   446                                  STX .CMP
   447                                  SEC
   448                                  SBC .CMP
   449                                  BEQ .switch_on_tag                      ;Tag_v1=Tag_v2 =>choose routine
   450                                  JMP .return                             ;Tag_v1!=Tag_v2=>RETURN
   451                          .switch_on_tag
   452                                  CPX # String_tag                        ;dichotomic switch
   453                                  BCC .t249
   454                                  BNE .t254
   455                                  JSR caml_compare_val_string_tag
   456                                  JMP .return_or_next
   457                          .t249   CPX # Infix_tag
   458                                  BCC .t247
   459                                  BNE +
   460                          -       +caml_raise Invalid_argument, "compare: functional value"
   461                          +       +caml_raise Invalid_argument, "compare: abstract value"
   462                          .t247   CPX # Closure_tag
   463                                  BCC .default
   464                                  BEQ -
   465                                  JSR caml_compare_val_object_tag
   466                                  JMP .return_or_next
   467                          .t254   CPX # Double_array_tag
   468                                  BCC .t253
   469                                  BNE .t255
   470                                  JSR caml_compare_val_double_array_tag
   471                                  JMP .return_or_next
   472                          .t253   JSR caml_compare_val_double_tag
   473                                  JMP .return_or_next
   474                          .t255   JSR caml_compare_val_custom_tag
   475                                  JMP .return_or_next
   476                          .default
   477                                  ;; compare sizes first
   478                                  LDY # -1
   479                                  DEC .V1 + 1
   480                                  DEC .V2 + 1
   481                                  LDA (.V1),Y                             ;A := size(v1)
   482                                  TAX                                     ;save it
   483                                  SEC
   484                                  SBC (.V2),Y                             ;A := size(v1) - size(v2)
   485                                  BNE .return                             ;A <> 0 ==> return(A)
   486                                  TXA                                     ;reload size(v1)
   487                                  BEQ .next_item                          ;v1, v2 atoms ==> next_item
   488                                  INC .V1 + 1
   489                                  INC .V2 + 1
   490                                  DEX                                     ;only one field?
   491                                  BEQ .field0                             ;yes:compare Fld(v1,0) Fld(v2,0)
   492                                  +caml_grow_stack 3                      ;no: save data on stack:
   493                                  LDY # 0
   494                                  CLC
   495                                  LDA .V1
   496                                  ADC # 2
   497                                  STA (SP),Y
   498                                  INY
   499                                  LDA .V1 + 1
   500                                  ADC # 0
   501                                  STA (SP),Y                              ;address of Field(v1,1) in SP[0]
   502                                  INY
   503                                  CLC
   504                                  LDA .V2
   505                                  ADC # 2
   506                                  STA (SP),Y
   507                                  INY
   508                                  LDA .V2 + 1
   509                                  ADC # 0
   510                                  STA (SP),Y                              ;address of Field(v2,1) in SP[1]
   511                                  INY
   512                                  DEX                                     ;# of following fields in SP[2]
   513                                  TXA
   514                                  STA (SP),Y
   515                          .field0 LDY # 0
   516                                  LDA (.V1),Y                             ;get <Field(v1,0)
   517                                  TAX                                     ;save it
   518                                  LDA (.V2),Y                             ;get <Field(v2,0)
   519                                  STA .CMP                                ;save it
   520                                  INY
   521                                  LDA (.V1),Y                             ;get >Field(v1,0)
   522                                  STA .V1 + 1                             ;.V1 + 1 :=  >Field(v1,0)
   523                                  LDA (.V2),Y                             ;get >Field(v2,0)
   524                                  STA .V2 + 1                             ;.V2 + 1  := >Field(v2,0)
   525                                  STX .V1                                 ;.V1 := Field(v1,0)
   526                                  LDA .CMP
   527                                  STA .V2                                 ;.V2 := Field(v2,0)
   528                                  JMP .loop                               ;continue comparison on v1, v2
   529                          .return_or_next
   530                                  ORA # 0                                 ;set status byte according to A
   531                                  BEQ .next_item                          ;if A=0 then compare nexts
   532                          .return LDX .SAVESP                             ;else
   533                                  STX SP                                  ; restore SP
   534                                  LDX .SAVESP + 1
   535                                  STX SP + 1
   536                                  LDY # 0
   537                                  ORA # 0                                 ; set status byte according to A
   538                                  RTS                                     ; exit
   539                          .next_item
   540                                  LDA SP                                  ;if SP = .SAVESP
   541                                  CMP .SAVESP
   542                                  BNE +
   543                                  LDA SP + 1
   544                                  CMP .SAVESP + 1
   545                                  BNE +
   546                                  LDA # 0                                 ;then RETURN EQUAL
   547                                  BEQ .return                             ;BEQ=JMP
   548                          +       LDY # 0                                 ;else get next item from stack:
   549                                  LDA (SP),Y                              ;V1 := SP[0] (lo byte)
   550                                  STA .V1
   551                                  CLC
   552                                  ADC # 2
   553                                  STA (SP),Y                              ;SP[0] := &next field (lo byte)
   554                                  INY
   555                                  LDA (SP),Y                              ;as above, hi byte
   556                                  STA .V1 + 1
   557                                  ADC # 0
   558                                  STA (SP),Y
   559                                  INY
   560                                  LDA (SP),Y                              ;V2 := SP[1] (lo byte)
   561                                  STA .V2
   562                                  CLC
   563                                  ADC # 2
   564                                  STA (SP),Y                              ;SP[1] := &next field (lo byte)
   565                                  INY
   566                                  LDA (SP),Y                              ;as above, hi byte
   567                                  STA .V2 + 1
   568                                  ADC # 0
   569                                  STA (SP),Y
   570                                  INY
   571                                  LDA (SP),Y                              ;get counter of remaining fields
   572                                  BEQ +                                   ;if counter = 0, continue loop
   573                                  SEC
   574                                  SBC # 1                                 ;else decrement the counter
   575                                  STA (SP),Y
   576                                  CLC
   577                                  LDA # 6
   578                                  ADC SP
   579                                  STA SP
   580                                  BCC +
   581                                  INC SP + 1                              ;and pop items from stack
   582                          +       LDY # 1                                 ;get curr. Fld(v1,x), Fld(v2,x)
   583                                  LDA (.V1),Y
   584                                  TAX
   585                                  LDA (.V2),Y
   586                                  STA .CMP
   587                                  DEY
   588                                  LDA (.V1),Y
   589                                  STA .V1
   590                                  STX .V1 + 1
   591                                  LDA (.V2),Y
   592                                  STA .V2
   593                                  LDA .CMP
   594                                  STA .V2 + 1
   595                                  JMP .loop                               ;continue loop
   596                          }
   597                          
   598                          !ifdef caml_PRIM__caml_compare_val_double_tag {
   599                          caml_compare_val_double_tag
   600                                  ;; Compare floats in ACCU and SP[0].
   601                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   602                                  ;; Status byte is set according to A.
   603                                  LDA .V1
   604                                  STA caml_float_loadFAC__addr
   605                                  LDA .V1 + 1
   606                                  STA caml_float_loadFAC__addr + 1
   607                                  JSR caml_float_loadFAC
   608                                  LDY .V2 + 1
   609                                  LDA .V2
   610                                  +caml_JSR_BASROM C64_FCOMP
   611                                  LDY # 0
   612                                  ORA # 0                                 ;set status byte according to A
   613                                  RTS
   614                          }
   615                          
   616                          !ifdef caml_PRIM__caml_compare_val_string_tag {
   617                          caml_compare_val_string_tag
   618                                  ;; Compare strings in ACCU and SP[0].
   619                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   620                                  ;; Status byte is set according to A.
   621                                  LDY # -1
   622                                  DEC .V1 + 1
   623                                  DEC .V2 + 1
   624                                  LDA (.V1),Y
   625                                  TAX
   626                                  SEC
   627                                  SBC (.V2),Y
   628                                  STA .CMP                                ;CMP = size(v1) - size(v2)
   629                                  BCC +
   630                                  LDA (.V2),Y
   631                                  TAX                                     ;X := min(size(v1), size(v2))
   632                          +       INY                                     ;Y := 0
   633                          --      INC .V1 + 1                             ;for Y := 0 to X - 1 {
   634                                  INC .V2 + 1                             ;  compare char by char:
   635                          -       DEX
   636                                  BEQ ++
   637                                  LDA (.V1),Y                             ;  1st byte
   638                                  CMP (.V2),Y
   639                                  BCC @lt
   640                                  BNE @gt
   641                                  INY
   642                                  LDA (.V1),Y                             ;  2nd byte
   643                                  CMP (.V2),Y
   644                                  BCC @lt
   645                                  BNE @gt
   646                                  INY
   647                                  BNE -
   648                                  BEQ --                                  ;}
   649                          ++      LDA (.V1),Y                             ;last word, 1st char
   650                                  CMP (.V2),Y
   651                                  BCC @lt
   652                                  BNE @gt
   653                                                                          ;(sub)strings are =, return CMP
   654                                  LDA .CMP                                ;CMP is size(v1)-size(v2),
   655                                  BNE +                                   ;if CMP = 0, adjust result
   656                                  INY                                     ;according to string paddings:
   657                                  CLC                                     ;len_v1-len_v2=-pad_v1+pad_v2
   658                                  ADC (.V2),Y
   659                                  SEC
   660                                  SBC (.V1),Y
   661                          +       LDY # 0
   662                                  ORA # 0                                 ;set status byte according to A
   663                                  RTS
   664                          @lt     LDY # 0
   665                                  LDA # -1
   666                                  RTS
   667                          @gt     LDY # 0
   668                                  LDA # 1
   669                                  RTS
   670                          }
   671                          
   672                          !ifdef caml_PRIM__caml_compare_val_custom_tag {
   673                          caml_compare_val_custom_tag
   674                                  ;; Compare custom values in ACCU and SP[0].
   675                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   676                                  ;; Status byte is set according to A.
   677                                  +caml_raise Not_found
   678                          }
   679                          
   680                          !ifdef caml_PRIM__caml_compare_val_double_array_tag {
   681                          caml_compare_val_double_array_tag
   682                                  ;; Compare floatarrays in ACCU and SP[0].
   683                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   684                                  ;; Status byte is set according to A.
   685                                  +caml_raise Not_found
   686                          }
   687                          
   688                          !ifdef caml_PRIM__caml_compare_val_object_tag {
   689                          caml_compare_val_object_tag
   690                                  ;; Compare objects in ACCU and SP[0].
   691                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   692                                  ;; Status byte is set according to A.
   693                                  +caml_raise Not_found
   694                          }
   695                          
   696                          !ifdef caml_PRIM__caml_string_eq_neq {           ;caml_compare_val_string_tag is
   697                          caml_string_eq_neq                              ; slower for equality tests
   698                                  LDY # -1
   699                                  DEC .V1 + 1
   700                                  DEC .V2 + 1
   701                                  LDA (.V1),Y
   702                                  CMP (.V2),Y
   703                                  BNE @neq
   704                                  TAX
   705                                  INY                                     ;Y := 0
   706                          --      INC .V1 + 1                             ;loop:
   707                                  INC .V2 + 1                             ; compare strings chr by chr
   708                          -       DEX
   709                                  BEQ +
   710                                  LDA (.V1),Y                             ;1st byte
   711                                  CMP (.V2),Y
   712                                  BNE @neq
   713                                  INY
   714                                  LDA (.V1),Y                             ;2nd byte
   715                                  CMP (.V2),Y
   716                                  BNE @neq
   717                                  INY
   718                                  BEQ --
   719                                  BNE -
   720                          +       LDA (.V1),Y                             ;last word, 1st char
   721                                  CMP (.V2),Y
   722                                  BNE @neq
   723                                  LDY # 0
   724                                  TYA
   725                                  RTS
   726                          @neq    LDY # 0
   727                                  LDA # -1
   728                                  RTS
   729                          }
   730                          
   731                          }       ;; !zone caml_COMPARISONS
   732                          

