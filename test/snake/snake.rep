   407                          !ifdef caml_PRIM__caml_array_set {
   408                          caml_array_set
   409                                  ;; set an array element to given value
   410                                  ;; ACCU = array
   411                                  ;; SP[0] = index
   412                                  ;; SP[1] = newval
   413                          
   414                                  ;; load tag
   415                                  LDY # -2
   416                                  DEC ACCU + 1
   417                                  LDA (ACCU),Y
   418                                  INY
   419                                  ;; check if float
   420                                  CMP # Double_array_tag
   421                                  BNE caml_array_set_addr__loadsize
   422                                  JMP caml_floatarray_set__loadsize
   423                          }
   424                          
   425                          !ifdef caml_PRIM__caml_array_set_addr {
   426                                  ;; set an array element to given value (no-float version)
   427                                  ;; ACCU = array
   428                                  ;; SP[0] = Val_int(index)
   429                                  ;; SP[1] = newval
   430                          caml_array_set_addr
   431                                  ;; load size
   432                                  DEY
   433                                  DEC ACCU + 1
   434                          caml_array_set_addr__loadsize
   435                          @SZ     = TMP
   436                          @NEW    = TMP + 1
   437                                  LDA (ACCU),Y
   438                                  STA @SZ
   439                                  INC ACCU + 1
   440                                  ;; load newval
   441                                  LDY # 3
   442                                  LDA (SP),Y
   443                                  STA @NEW + 1
   444                                  DEY
   445                                  LDA (SP),Y
   446                                  STA @NEW
   447                                  ;; load index, hi
   448                                  DEY
   449                                  LDA (SP),Y
   450                                  ;; exn if index > 255 or index < 0
   451                                  LSR
   452                                  BNE @error
   453                                  ;; load index, lo
   454                                  DEY
   455                                  LDA (SP),Y
   456                                  ROR
   457                                  ;; exn if index >= size
   458                                  CMP @SZ
   459                                  BCS @error
   460                                  ;; array[index] <- newval
   461                                  ASL
   462                                  BCC +
   463                                  INC ACCU + 1
   464                          +       TAY
   465                                  LDA @NEW
   466                                  STA (ACCU),Y
   467                                  INY
   468                                  LDA @NEW + 1
   469                                  STA (ACCU),Y
   470                                  ;; ACCU <- ()
   471                                  LDY # <Val_unit                 ;.Y := 1
   472                                  STY ACCU
   473                                  DEY
   474                                  STY ACCU + 1
   475                                  RTS
   476                          @error  +caml_raise Invalid_argument, "index out of bounds"
   477                          }
   478                          
   479                          !ifdef caml_PRIM__caml_floatarray_set {
   480                                  ;; set an array element to given value (floatarray version)
   481                                  ;; ACCU = array
   482                                  ;; SP[0] = index
   483                                  ;; SP[1] = newval
   484                          caml_floatarray_set
   485                                  ;; load size
   486                                  DEY
   487                                  DEC ACCU + 1
   488                          caml_floatarray_set__loadsize
   489                          @SZ     = TMP
   490                          @IDX    = TMP + 1
   491                          @NEW    = TMP + 2
   492                                  LDA (ACCU),Y
   493                                  STA @SZ
   494                                  INC ACCU + 1
   495                                  ;; load newval
   496                                  LDY # 3
   497                                  LDA (SP),Y
   498                                  STA @NEW + 1
   499                                  DEY
   500                                  LDA (SP),Y
   501                                  STA @NEW
   502                                  ;; load index, hi
   503                                  DEY
   504                                  LDA (SP),Y
   505                                  ;; exn if hi > 0
   506                                  BNE @error
   507                                  ;; load index, lo
   508                                  DEY
   509                                  LDA (SP),Y
   510                                  ;; exn if 3 * index >= size
   511                                  AND # $FE
   512                                  STA @IDX
   513                                  LSR
   514                                  CLC
   515                                  ADC @IDX
   516                                  BCS @error
   517                                  CMP @SZ
   518                                  BCS @error
   519                                  ;; ACCU <- &array[index]
   520                          +       ASL
   521                                  BCC +
   522                                  INC ACCU + 1
   523                                  CLC
   524                          +       ADC ACCU
   525                                  STA ACCU
   526                                  BCC +
   527                                  INC ACCU + 1
   528                                  ;; copy float
   529                          +       +caml_move_float @NEW, ACCU
   530                                  ;; ACCU <- ()
   531                                  STY ACCU + 1
   532                                  INY
   533                                  STY ACCU
   534                                  DEY
   535                                  RTS
   536                          @error  +caml_raise Invalid_argument, "index out of bounds"
   537                          }
   538                          
   539                          !ifdef caml_PRIM__caml_array_unsafe_set {
   540                          caml_array_unsafe_set
   541                                  ;; set an array element to given value (unsafe version)
   542                                  ;; ACCU = array
   543                                  ;; SP[0] = index
   544                                  ;; SP[1] = newval
   545                          
   546                                  ;; load tag
   547                                  LDY # -2
   548                                  DEC ACCU + 1
   549                                  LDA (ACCU),Y
   550                                  INC ACCU + 1
   551                                  LDY # 0
   552                                  ;; check if float
   553                                  CMP # Double_array_tag
   554                                  BEQ caml_floatarray_unsafe_set
   555                                  ;; FALLTHROUGH caml_array_unsafe_set_addr
   556                          }
   557                          
   558                          !ifdef caml_PRIM__caml_array_unsafe_set_addr {
   559                                  ;; set an array element to given value (unsafe, no-float version)
   560                                  ;; ACCU = array
   561                                  ;; SP[0] = index
   562                                  ;; SP[1] = newval
   563                          caml_array_unsafe_set_addr
   564                                  ;; load index
   565                                  LDA (SP),Y                      ; Val_int(index), lo
   566                                  STA TMP
   567                                  INY
   568                                  LDA (SP),Y                      ; Val_int(index), hi
   569                                  BEQ +
   570                                  INC ACCU + 1
   571                                  ;; load newval
   572                          +       INY
   573                                  LDA (SP),Y
   574                                  TAX
   575                                  INY
   576                                  LDA (SP),Y
   577                                  ;; array[index] <- newval
   578                                  LDY TMP
   579                                  STA (ACCU),Y
   580                                  DEY
   581                                  TXA
   582                                  STA (ACCU),Y
   583                                  ;; ACCU <- ()
   584                                  LDY # <Val_unit                 ;.Y := 1
   585                                  STY ACCU
   586                                  DEY
   587                                  STY ACCU + 1
   588                                  RTS
   589                          }
   590                          
   591                          !ifdef caml_PRIM__caml_floatarray_unsafe_set {
   592                                  ;; set an array element to given value (unsafe, floatarray version)
   593                                  ;; ACCU = array
   594                                  ;; SP[0] = index
   595                                  ;; SP[1] = newval
   596                          caml_floatarray_unsafe_set
   597                                  ;; load index, lo (ignore hi byte)
   598                                  LDA (SP),Y                      ; 2*i+1
   599                                  ;; calc 3 * i
   600                                  AND # $FE
   601                                  STA TMP
   602                                  LSR
   603                                  CLC
   604                                  ADC TMP
   605                                  ;; ACCU <- &array[index]
   606                                  ASL
   607                                  BCC +
   608                                  INC ACCU + 1
   609                                  CLC
   610                          +       ADC ACCU
   611                                  STA ACCU
   612                                  BCC +
   613                                  INC ACCU + 1
   614                                  ;; load newval
   615                          +       LDY # 2
   616                                  LDA (SP),Y
   617                                  STA TMP
   618                                  INY
   619                                  LDA (SP),Y
   620                                  STA TMP + 1
   621                                  ;; copy float
   622                                  +caml_move_float TMP, ACCU
   623                                  ;; ACCU <- ()
   624                                  LDA # <Val_unit
   625                                  STA ACCU
   626                                  STY ACCU + 1                    ; Y = 0
   627                                  RTS
   628                          }
