   380                          !ifdef  caml_PRIM__caml_int32_mul {
   381                          caml_int32_mul
   382                          @M      = TMP                                   ;4 bytes
   383                          @P      = TMP + 4                               ;4 bytes
   384                          @NPTR   = TMP + 8                               ;2 bytes
   385                                  +caml_int32_alloc
   386                                  SEC
   387                                  LDA (SP),Y
   388                                  SBC # $FF - 5                   :!warn "COS'E'? COMMENTARE!"
   389                                  STA @NPTR
   390                                  INY
   391                                  LDA (SP),Y
   392                                  SBC # 0
   393                                  STA @NPTR + 1
   394                                  LDX # 0
   395                                  LDY # 5
   396                                  LDA (ACCU),Y
   397                                  LSR
   398                                  STA @M + 3
   399                                  STX @P + 3
   400                            !for @i, 2, 0 {
   401                                  DEY
   402                                  LDA (ACCU),Y
   403                                  ROR
   404                                  STA @M + @i
   405                                  STX @P + @i
   406                            }
   407                          ;;      ldx #32
   408                          ;; --   bcc +
   409                          ;;      clc
   410                          ;;      ldy #$FF - 3
   411                          ;; -    lda (@NPTR),Y
   412                          ;;      adc @P - $FF + 3,Y
   413                          ;;      sta @P - $FF + 3,Y
   414                          ;;      iny
   415                          ;;      bne -
   416                          ;; +    lsr @P + 3
   417                          ;;  !for @i, 2, 0 {ror @P + @i}
   418                          ;;  !for @i, 3, 0 {ror @M + @i}
   419                          ;;      dex
   420                          ;;      bne --
   421                                  LDX # 8
   422                          --      BCC +
   423                                  CLC
   424                                  LDY # $FF-3
   425                          -       LDA (@NPTR),Y
   426                                  ADC @P - $FF + 3,Y
   427                                  STA @P - $FF + 3,Y
   428                                  INY
   429                                  BNE -
   430                          +       LSR @P + 3
   431                            !for @i, 2, 0 {
   432                                  ROR @P + @i
   433                            }
   434                            !for @i, 3, 0 {
   435                                  ROR @M + @i
   436                            }
   437                                  DEX
   438                                  BNE --
   439                                  LDA @NPTR
   440                                  BNE +
   441                                  DEC @NPTR + 1
   442                          +       DEC @NPTR
   443                                  LDX # 8
   444                          --      BCC +
   445                                  CLC
   446                                  LDY # $FF-2
   447                          -       LDA (@NPTR),Y
   448                                  ADC @P - $FF + 2,Y
   449                                  STA @P - $FF + 2,Y
   450                                  INY
   451                                  BNE -
   452                          +       LSR @P + 2
   453                            !for @i, 1, 0 {
   454                                  ROR @P + @i
   455                            }
   456                            !for @i, 3, 0 {
   457                                  ROR @M + @i
   458                            }
   459                                  DEX
   460                                  BNE --
   461                                  LDA @NPTR
   462                                  BNE +
   463                                  DEC @NPTR + 1
   464                          +       DEC @NPTR
   465                                  LDX # 8
   466                          --      BCC +
   467                                  CLC
   468                                  LDY # $FF - 1
   469                          -       LDA (@NPTR),Y
   470                                  ADC @P - $FF + 1,Y
   471                                  STA @P - $FF + 1,Y
   472                                  INY
   473                                  BNE -
   474                          +       LSR @P + 1
   475                                  ROR @P
   476                            !for @i, 3, 0 {
   477                                  ROR @M + @i
   478                            }
   479                                  DEX
   480                                  BNE --
   481                                  LDA @NPTR
   482                                  BNE +
   483                                  DEC @NPTR + 1
   484                          +       DEC @NPTR
   485                                  LDX # 8
   486                          --      BCC +
   487                                  CLC
   488                                  LDY # $FF
   489                                  LDA (@NPTR),Y
   490                                  ADC @P - $FF,Y
   491                                  STA @P - $FF,Y
   492                          +       LSR @P
   493                            !for @i, 3, 0 {
   494                                  ROR @M + @i
   495                            }
   496                                  DEX
   497                                  BNE --
   498                                  LDY # 5
   499                          -       LDA @M - 2,Y
   500                                  STA (BLK),Y
   501                                  DEY
   502                                  CPY # 2
   503                                  BCS -
   504                                  LDA BLK
   505                                  STA ACCU
   506                                  LDA BLK + 1
   507                                  STA ACCU + 1
   508                                  LDY # 0
   509                                  RTS
   510                          }
